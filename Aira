local function clearAura()
    if S.pulseTask then pcall(function() task.cancel(S.pulseTask) end); S.pulseTask=nil end
    if S.auraConn then pcall(function() S.auraConn:Disconnect() end); S.auraConn=nil end
    for _, o in ipairs(S.auraObjects) do pcall(function() if o and o.Parent then o:Destroy() end end) end
    S.auraObjects = {}; S.auraRings = {}; S.auraOrbiters = {}; S.auraBeam = nil
end

local function addCore(hrp, aura, rate)
    local att = Instance.new("Attachment", hrp); att.Name="Core"; att.Position=Vector3.new(0,0,0)
    table.insert(S.auraObjects, att)
    local pe = Instance.new("ParticleEmitter", att)
    pe.Texture = "rbxassetid://296874871"
    pe.Color = ColorSequence.new(aura.color)
    pe.LightEmission = 1; pe.LightInfluence = 0
    pe.Size = NumberSequence.new{NumberSequenceKeypoint.new(0,0), NumberSequenceKeypoint.new(0.4,1.8), NumberSequenceKeypoint.new(1,0)}
    pe.Transparency = NumberSequence.new{NumberSequenceKeypoint.new(0,0.1), NumberSequenceKeypoint.new(1,1)}
    pe.Lifetime = NumberRange.new(1, 2)
    pe.Rate = rate
    pe.Speed = NumberRange.new(2, 6)
    pe.SpreadAngle = Vector2.new(180, 180)
    pe.Rotation = NumberRange.new(0, 360)
    pe.RotSpeed = NumberRange.new(-180, 180)
    pe.Acceleration = Vector3.new(0, 3, 0)
end


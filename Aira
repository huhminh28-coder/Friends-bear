    local att = addAuraAttach(hrp, "ShAtt")
    local pe = mkEmitter(att, "rbxassetid://243660364", a.c, rate, 2*mult, 2, 1.6)
    pe.Acceleration = Vector3.new(0, -1.5, 0)
    local att2 = addAuraAttach(hrp, "ShAtt2")
    mkEmitter(att2, "rbxassetid://138028586", a.g, math.floor(rate*0.4), 1.5*mult, 3, 1.2)
    addLight(hrp, a.g, 1.5*mult, 12)
    addGroundCircle(hrp, a.c)
    if mult >= 1.5 then for i=1,4 do addOrb(hrp, a.c, 3.5, 1, i*math.pi/2, -1.5) end end
    if mult >= 2.2 then addRing(hrp, a.g, 4.5, 0, -2) end
end

-- ==================== EQUIP ====================
local function clearAura()
    if S.conn then pcall(function() S.conn:Disconnect() end); S.conn = nil end
    for _, obj in ipairs(S.objects) do
        pcall(function() if obj and obj.Parent then obj:Destroy() end end)
    end
    S.objects = {}; S.orbiters = {}; S.followers = {}
end

local function equip(aura)
    if not aura then return end
    clearAura()
    S.equipped = aura
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local rate = TIER_RATE[aura.tier] or 30
    local mult = TIER_MULT[aura.tier] or 1
    local builder = STYLE[aura.style] or STYLE.spark
    builder(hrp, aura, rate, mult)

    if aura.acc then
        local accs = aura.acc
        if type(accs) == "string" then accs = {accs} end
        for _, kind in ipairs(accs) do
            local fn = ACC[kind]
            if fn then pcall(fn, hrp, aura) end
        end
    end

    S.conn = RunService.Heartbeat:Connect(function()
        if not hrp or not hrp.Parent or S.exit then return end
        local t = tick()
        for _, f in ipairs(S.followers) do
            if f.part and f.part.Parent then
                local rel = f.anim and f.anim(t) or f.baseCF
                f.part.CFrame = hrp.CFrame * rel
            end
        end
        for _, o in ipairs(S.orbiters) do
            if o.part and o.part.Parent then
                if o.ground then
                    o.part.CFrame = CFrame.new(hrp.Position + Vector3.new(0, o.height, 0)) * CFrame.Angles(0, t*0.5, math.rad(90))
                elseif o.ring then
                    o.part.CFrame = hrp.CFrame * CFrame.Angles(o.tilt, t * o.speed, math.rad(90))
                else
                    local a = o.baseAngle + t * o.speed
                    local offset = Vector3.new(math.cos(a)*o.radius, o.height + math.sin(t*2)*0.5, math.sin(a)*o.radius)
                    o.part.CFrame = CFrame.new(hrp.Position + offset)
                end
            end
        end
    end)
end

-- ==================== HELPERS ====================
local function fmtOdds(r)
    if r >= 1e12 then return string.format("1/%.1fT", r/1e12) end
    if r >= 1e9  then return string.format("1/%.1fB", r/1e9) end
    if r >= 1e6  then return string.format("1/%.1fM", r/1e6) end
    if r >= 1e3  then return string.format("1/%.1fK", r/1e3) end
    return string.format("1/%d", r)
end

local function pickRandom()
    local total = 0; local w = {}
    for i, a in ipairs(AURAS) do
        w[i] = 1 / math.max(1, math.sqrt(a.rarity))
        total = total + w[i]
    end
    local roll = math.random() * total
    local acc = 0
    for i = 1, #AURAS do
        acc = acc + w[i]
        if roll <= acc then return AURAS[i] end
    end
    return AURAS[1]
end


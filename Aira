            r.check.Text = ""
            r.frame.BackgroundColor3 = Color3.fromRGB(28, 28, 42)
        end
        oddsTxt.Text = "Aura removed"
        oddsTxt.TextColor3 = Color3.fromRGB(150, 150, 175)
    end)
end

adminBtn.MouseButton1Click:Connect(function()
    if S.adminOpen then closeAdmin() else openAdmin() end
end)

-- =====================================================
--  RESPAWN
-- =====================================================
player.CharacterAdded:Connect(function()
    task.wait(1)
    if S.equippedAura then equipAura(S.equippedAura) end
end)

-- =====================================================
--  CLOSE / HOTKEY
-- =====================================================
local function closeAll()
    S.exit = true
    clearAura()
    if S.adminPanel then pcall(function() S.adminPanel:Destroy() end) end
    if gui then gui:Destroy() end
    if getgenv then getgenv().AURA_RUNNING = nil end
end

closeBtn.MouseButton1Click:Connect(closeAll)
UIS.InputBegan:Connect(function(input, gpe)
    if gpe or UIS:GetFocusedTextBox() then return end
    if input.KeyCode == Enum.KeyCode.R and UIS:IsKeyDown(Enum.KeyCode.LeftControl) then doRoll() end
end)
getgenv().AURA_STOP = closeAll

updateStats()
print("[Aura Roller] Loaded — " .. #AURAS .. " auras. AURA_STOP() to close.")

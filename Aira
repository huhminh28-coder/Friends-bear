local function burst(color)
    for i = 1, 16 do
        task.spawn(function()
            local dot = Instance.new("Frame", rollBox)
            local sz = math.random(4, 8)
            dot.Size = UDim2.fromOffset(sz, sz)
            dot.Position = UDim2.new(0.5, -sz/2, 0.5, -sz/2)
            dot.BackgroundColor3 = color
            dot.BorderSizePixel = 0
            Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)
            local a = math.random() * math.pi * 2
            local d = math.random(60, 180)
            TweenService:Create(dot, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Position = UDim2.new(0.5, math.cos(a)*d, 0.5, math.sin(a)*d),
                BackgroundTransparency = 1,
                Size = UDim2.fromOffset(1, 1),
            }):Play()
            task.delay(1, function() if dot then dot:Destroy() end end)
        end)
    end
end


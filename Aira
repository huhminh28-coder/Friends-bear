    r.BackgroundTransparency = 1; r.Text = fmtOdds(a.rarity)
    r.TextColor3 = Color3.fromRGB(120, 120, 140)
    r.Font = Enum.Font.Gotham; r.TextSize = 10; r.TextXAlignment = Enum.TextXAlignment.Right
    local count = 0
    for _, c in ipairs(histFrame:GetChildren()) do if c:IsA("Frame") then count = count + 1 end end
    if count > 4 then
        local oldest = nil
        for _, c in ipairs(histFrame:GetChildren()) do
            if c:IsA("Frame") and (not oldest or c.LayoutOrder > oldest.LayoutOrder) then oldest = c end
        end
        if oldest then oldest:Destroy() end
    end
end


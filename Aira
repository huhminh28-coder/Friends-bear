-- =====================================================
local function pickRandom()
    local weights, total = {}, 0
    for i, a in ipairs(AURAS) do
        weights[i] = 1 / math.max(1, math.sqrt(a.rarity))
        total = total + weights[i]
    end
    local r = math.random() * total
    local acc = 0
    for i = 1, #AURAS do
        acc = acc + weights[i]
        if r <= acc then return AURAS[i] end
    end
    return AURAS[1]
end


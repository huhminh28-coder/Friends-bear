local ACC = {}

ACC.angel_wings = function(hrp, aura)
    for side = -1, 1, 2 do
        for i = 1, 4 do
            local L = 2.5 + i * 0.7
            local ang = 15 + i * 10
            local feather = mkPart("Feather", Vector3.new(0.3, L, 0.2),
                aura.c:Lerp(aura.g, i/4), Enum.Material.Neon)
            feather.Transparency = 0.25
            local s, a, l = side, ang, L
            local function build(t)
                local flap = 0
                if t then flap = math.sin(t * 2.5) * math.rad(6) end
                return CFrame.new(s * 1.2, 1.2, 0.35)
                    * CFrame.Angles(0, 0, -s * (math.rad(a) + flap))
                    * CFrame.new(0, l/2, 0)
            end
            addFollower(feather, build(nil), function(t) return build(t) end)
        end
    end
    addLight(hrp, aura.g, 1.8, 12)
end


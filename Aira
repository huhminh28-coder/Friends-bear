local function doRoll()
    if S.rolling then return end
    S.rolling = true
    rollBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 80)
    rBtnGrad.Color = ColorSequence.new(Color3.fromRGB(60, 60, 80))
    rollBtn.Text = "ROLLING..."
    for i = 1, 12 do
        if S.exit or not panel.Parent then S.rolling = false; return end
        local fake = AURAS[math.random(1, #AURAS)]
        rarityTag.Text = fake.tier
        rarityTag.TextColor3 = TIER_COLORS[fake.tier] or Color3.fromRGB(140,140,160)
        auraName.Text = fake.name; auraName.TextColor3 = fake.c
        rarityTxt.Text = "Rarity: " .. fmtOdds(fake.rarity)
        rarityTxt.TextColor3 = Color3.fromRGB(150, 150, 170)
        rbStroke.Color = fake.g
        task.wait(0.03 + i * 0.02)
    end
    local result = pickRandom()
    display(result, true)
    rbStroke.Thickness = 3
    TweenService:Create(rbStroke, TweenInfo.new(0.5), {Thickness = 1.5}):Play()
    local tw = TweenService:Create(rollBox, TweenInfo.new(0.15), {Size = UDim2.new(1, -20, 0, 144)})
    tw:Play(); tw.Completed:Wait()
    TweenService:Create(rollBox, TweenInfo.new(0.3), {Size = UDim2.new(1, -24, 0, 140)}):Play()
    S.streak = S.streak + 1
    table.insert(S.history, result)
    if not S.best or result.rarity > S.best.rarity then
        S.best = result
        task.spawn(function()
            pcall(function()
                StarterGui:SetCore("SendNotification", {Title = "New Best", Text = result.name, Duration = 2})
            end)
        end)
    end
    equip(result)
    if S.adminOpen then
        for _, r in ipairs(S.adminRows) do
            if r.aura.name == result.name then
                r.check.Text = "✓"; r.frame.BackgroundColor3 = Color3.fromRGB(40, 60, 50)
            else
                r.check.Text = ""; r.frame.BackgroundColor3 = Color3.fromRGB(28, 28, 40)
            end
        end
    end
    addHistory(result); updateStats()
    rollBtn.Text = "🎲  ROLL"
    rBtnGrad.Color = ColorSequence.new(Color3.fromRGB(120,100,240), Color3.fromRGB(80,60,180))
    rollBtn.BackgroundColor3 = Color3.fromRGB(100, 80, 200)
    S.rolling = false
end


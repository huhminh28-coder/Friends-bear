    S.auraBeam = beam
end

local function equipAura(aura)
    if not aura then return end
    clearAura()
    S.equippedAura = aura

    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local tier = aura.tier
    local rate = RATE[tier] or 20

    addCore(hrp, aura, rate)
    if tier ~= "COMMON" then addTrail(hrp, aura, rate) end
    if GOOD_PLUS[tier] then addDoubleColor(hrp, aura, rate) end

    local light = Instance.new("PointLight", hrp)
    light.Color = aura.glow
    light.Brightness = 1.5 + (rate / 40)
    light.Range = 12 + rate / 6
    table.insert(S.auraObjects, light)

    if RARE_PLUS[tier] then addGroundPulse(hrp, aura) end

    if EPIC_PLUS[tier] then
        local ring = Instance.new("Part")
        ring.Shape = Enum.PartType.Cylinder
        ring.Size = Vector3.new(0.2, 6, 6)
        ring.Color = aura.glow
        ring.Material = Enum.Material.Neon
        ring.Transparency = 0.25
        ring.Anchored = true; ring.CanCollide = false; ring.CanQuery = false; ring.CastShadow = false
        ring.Parent = workspace
        table.insert(S.auraObjects, ring)
        table.insert(S.auraRings, ring)
        if LEG_PLUS[tier] then
            local ring2 = ring:Clone()
            ring2.Transparency = 0.35
            ring2.Parent = workspace
            table.insert(S.auraObjects, ring2)
            table.insert(S.auraRings, ring2)
        end
    end

    if LEG_PLUS[tier] then
        local n = (tier=="LEGENDARY" and 2) or (tier=="MYTHIC" and 3) or (tier=="DIVINE" and 4) or 6
        addOrbiters(hrp, aura, n)
    end
    if DIVINE_PLUS[tier] then addBeam(hrp, aura) end

    S.auraConn = RunService.Heartbeat:Connect(function()
        if not hrp or not hrp.Parent then return end
        local t = tick()
        for i, r in ipairs(S.auraRings) do
            if r.Parent then
                local off = (i - 1) * 0.7
                r.CFrame = hrp.CFrame * CFrame.new(0, 1 + off, 0) * CFrame.Angles(t * 2, t * 3 + i, math.rad(90))
            end
        end
        for _, o in ipairs(S.auraOrbiters) do
            if o.part and o.part.Parent then
                local a = o.angle + t * 1.8
                local p = Vector3.new(math.cos(a)*o.radius, o.height + math.sin(t*2 + o.angle)*0.6, math.sin(a)*o.radius)
                o.part.CFrame = CFrame.new(hrp.Position + p)
            end
        end
        if S.auraBeam and S.auraBeam.Parent then
            S.auraBeam.CFrame = hrp.CFrame * CFrame.new(0, 24, 0) * CFrame.Angles(0, 0, math.rad(90))
        end
    end)

    local sw = Instance.new("Part")
    sw.Shape = Enum.PartType.Cylinder
    sw.Size = Vector3.new(0.5, 1, 1)
    sw.CFrame = hrp.CFrame * CFrame.Angles(0,0,math.rad(90))
    sw.Color = aura.glow
    sw.Material = Enum.Material.Neon
    sw.Transparency = 0
    sw.Anchored = true; sw.CanCollide = false; sw.CanQuery = false; sw.CastShadow = false
    sw.Parent = workspace
    TweenService:Create(sw, TweenInfo.new(0.85, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = Vector3.new(0.5, 28, 28),
        Transparency = 1,
    }):Play()
    task.delay(1, function() if sw then sw:Destroy() end end)
end


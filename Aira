local function fmtRarity(r)
    if r >= 1e12 then return string.format("1 in %.1fT", r/1e12) end
    if r >= 1e9  then return string.format("1 in %.1fB", r/1e9) end
    if r >= 1e6  then return string.format("1 in %.1fM", r/1e6) end
    if r >= 1e3  then return string.format("1 in %.1fK", r/1e3) end
    return "1 in " .. tostring(r)
end


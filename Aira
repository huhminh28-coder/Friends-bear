    rar.TextColor3 = TIER_COLORS[aura.tier]; rar.Font = Enum.Font.Gotham
    rar.TextSize = 10; rar.TextXAlignment = Enum.TextXAlignment.Right

    local cnt = 0
    for _, c in ipairs(histFrame:GetChildren()) do if c:IsA("Frame") then cnt = cnt + 1 end end
    if cnt > 4 then
        local oldest
        for _, c in ipairs(histFrame:GetChildren()) do
            if c:IsA("Frame") and (not oldest or c.LayoutOrder > oldest.LayoutOrder) then oldest = c end
        end
        if oldest then oldest:Destroy() end
    end
end

local function doRoll()
    if S.rolling then return end
    S.rolling = true
    rollBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 85)
    rBtnGrad.Color = ColorSequence.new(Color3.fromRGB(60, 60, 85))
    rollBtn.Text = "ROLLING..."

    for i = 1, 14 do
        if S.exit or not panel.Parent then S.rolling = false; return end
        local fake = AURAS[math.random(1, #AURAS)]
        rarityTag.Text = fake.tier
        rarityBadge.BackgroundColor3 = TIER_COLORS[fake.tier]
        rBadgeStroke.Color = TIER_COLORS[fake.tier]
        auraName.Text = fake.name
        auraName.TextColor3 = fake.color
        rarityTxt.Text = "Rarity: " .. fmtRarity(fake.rarity)
        rarityTxt.TextColor3 = Color3.fromRGB(150, 150, 175)
        rbStroke.Color = fake.glow
        task.wait(0.02 + i * 0.018)
    end

    local result = pickRandom()
    setDisplay(result, true)

    rbStroke.Thickness = 3
    TweenService:Create(rbStroke, TweenInfo.new(0.5), {Thickness = 1.5}):Play()

    local tw = TweenService:Create(rollBox, TweenInfo.new(0.12), {Size = UDim2.new(1, -20, 0, 154)})
    tw:Play(); tw.Completed:Wait()
    TweenService:Create(rollBox, TweenInfo.new(0.3), {Size = UDim2.new(1, -24, 0, 150)}):Play()

    burst(result.glow)
    equipAura(result)

    S.streak = S.streak + 1
    table.insert(S.history, result)
    if not S.best or result.rarity > S.best.rarity then
        S.best = result
    end

    if S.adminOpen and S.adminPanel then
        for _, r in ipairs(S.adminRows) do
            if r.aura.name == result.name then
                r.check.Text = "✓"
                r.frame.BackgroundColor3 = Color3.fromRGB(40, 65, 50)
            else
                r.check.Text = ""
                r.frame.BackgroundColor3 = Color3.fromRGB(28, 28, 42)
            end
        end
    end

    addHistory(result)
    updateStats()

    rollBtn.Text = "🎲  ROLL"
    rBtnGrad.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, Color3.fromRGB(130, 110, 250)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(70, 50, 170)),
    }
    rollBtn.BackgroundColor3 = Color3.fromRGB(100, 80, 200)
    S.rolling = false
end


-- ==================== HELPERS ====================
local function mkPart(name, size, color, material, shape)
    local p = Instance.new("Part")
    p.Name = name; p.Size = size; p.Color = color
    p.Material = material or Enum.Material.Neon
    if shape then p.Shape = shape end
    p.Anchored = true; p.CanCollide = false; p.CanQuery = false; p.CastShadow = false
    p.Parent = workspace
    return p
end

local function mkEmitter(att, tex, color, rate, size, speed, life)
    local pe = Instance.new("ParticleEmitter", att)
    pe.Texture = tex or "rbxassetid://296874871"
    pe.Color = ColorSequence.new(color)
    pe.LightEmission = 1; pe.LightInfluence = 0
    pe.Size = NumberSequence.new{
        NumberSequenceKeypoint.new(0, 0),
        NumberSequenceKeypoint.new(0.5, size or 1.5),
        NumberSequenceKeypoint.new(1, 0),
    }
    pe.Transparency = NumberSequence.new{
        NumberSequenceKeypoint.new(0, 0.1),
        NumberSequenceKeypoint.new(1, 1),
    }
    pe.Lifetime = NumberRange.new(life or 0.9, (life or 0.9) + 0.5)
    pe.Rate = rate or 30
    pe.Speed = NumberRange.new((speed or 2) * 0.5, speed or 4)
    pe.SpreadAngle = Vector2.new(180, 180)
    pe.Rotation = NumberRange.new(0, 360)
    pe.RotSpeed = NumberRange.new(-90, 90)
    return pe
end

local function addLight(hrp, color, bright, range)
    local l = Instance.new("PointLight", hrp)
    l.Color = color; l.Brightness = bright or 2; l.Range = range or 14
    table.insert(S.objects, l)
    return l
end

local function addAuraAttach(hrp, name, pos)
    local att = Instance.new("Attachment", hrp)
    att.Name = name; att.Position = pos or Vector3.zero
    table.insert(S.objects, att)
    return att
end

local function addOrb(hrp, color, radius, height, angle, speed)
    local orb = mkPart("AuraOrb", Vector3.new(0.9,0.9,0.9), color, Enum.Material.Neon, Enum.PartType.Ball)
    table.insert(S.objects, orb)
    table.insert(S.orbiters, {part=orb, radius=radius, height=height, baseAngle=angle, speed=speed})
end

local function addRing(hrp, color, radius, tilt, spin)
    local ring = mkPart("AuraRing", Vector3.new(0.15, radius*2, radius*2), color, Enum.Material.Neon, Enum.PartType.Cylinder)
    ring.Transparency = 0.15
    table.insert(S.objects, ring)
    table.insert(S.orbiters, {part=ring, radius=0, height=0, baseAngle=0, speed=spin or 3, ring=true, tilt=tilt or 0})
end

local function addTrail(hrp, color)
    local a0 = Instance.new("Attachment", hrp)
    local a1 = Instance.new("Attachment", hrp)
    a1.Position = Vector3.new(0, -2.5, 0)
    table.insert(S.objects, a0); table.insert(S.objects, a1)
    local beam = Instance.new("Beam", a0)
    beam.Attachment0 = a0; beam.Attachment1 = a1
    beam.Color = ColorSequence.new(color)
    beam.LightEmission = 1; beam.Transparency = NumberSequence.new(0.6)
    beam.Width0 = 0.3; beam.Width1 = 0.3; beam.FaceCamera = true
    table.insert(S.objects, beam)
end

local function addGroundCircle(hrp, color)
    local c = mkPart("AuraGround", Vector3.new(0.2, 8, 8), color, Enum.Material.Neon, Enum.PartType.Cylinder)
    c.Transparency = 0.5
    table.insert(S.objects, c)
    table.insert(S.orbiters, {part=c, radius=0, height=-2.5, baseAngle=0, speed=0, ground=true})
end

-- Follower system: parts that follow HRP with relCF + optional anim(t)
local function addFollower(part, relCF, anim)
    table.insert(S.objects, part)
    table.insert(S.followers, {part=part, baseCF=relCF, anim=anim})
end


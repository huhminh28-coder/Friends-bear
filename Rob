-- ═══════════════════════════════════════════════════════
-- UTILITY: file + http wrappers
-- ═══════════════════════════════════════════════════════
local function safeReadFile(name)
    if readfile then
        local ok, data = pcall(readfile, name)
        if ok then return data end
    end
    return nil
end

local function safeWriteFile(name, content)
    if writefile then
        pcall(writefile, name, content)
    end
end

local function safeIsFile(name)
    if isfile then
        local ok, res = pcall(isfile, name)
        return ok and res
    end
    return false
end

local httpRequest = request or http_request or (syn and syn.request) or (fluxus and fluxus.request) or http

local function fetchJSON(url)
    if not httpRequest then return nil end
    local ok, res = pcall(httpRequest, {Url = url, Method = "GET"})
    if not ok or not res or not res.Body then return nil end
    local ok2, data = pcall(HttpService.JSONDecode, HttpService, res.Body)
    if ok2 then return data end
    return nil
end


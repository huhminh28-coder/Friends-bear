-- ═══════════════════════════════════════════════════════
-- ITEM APPLICATION (to custom rig)
-- ═══════════════════════════════════════════════════════
local function loadAssetModel(assetId)
    local ok, model = pcall(function()
        local objs = game:GetObjects("rbxassetid://" .. assetId)
        return objs and objs[1]
    end)
    if ok and model then return model end
    return nil
end

local function attachAccessoryToRig(assetId, itemName, category)
    if not customRig then return false end
    local model = loadAssetModel(assetId)
    if not model then return false end
    
    -- Chọn body part đích
    local targetName = "Head"
    if category == "FrontAccessory" or category == "NeckAccessory" then
        targetName = "Torso"
    elseif category == "BackAccessory" then
        targetName = "Torso"
    elseif category == "WaistAccessory" then
        targetName = "Torso"
    end
    
    local targetPart = customRig:FindFirstChild(targetName) or customRig:FindFirstChild("Head")
    if not targetPart then return false end
    
    -- Xóa item cũ cùng category
    for _, child in ipairs(customRig:GetChildren()) do
        if child:GetAttribute("Category") == category then
            child:Destroy()
        end
    end
    
    if model:IsA("Accessory") or model:IsA("Model") then
        local handle = model:FindFirstChild("Handle") or model:FindFirstChildWhichIsA("BasePart")
        if not handle then
            for _, d in ipairs(model:GetDescendants()) do
                if d:IsA("BasePart") then handle = d break end
            end
        end
        if not handle then return false end
        
        handle.CFrame = targetPart.CFrame
        handle.Parent = customRig
        handle.CanCollide = false
        handle.Massless = true
        handle:SetAttribute("CatalogId", assetId)
        handle:SetAttribute("DisplayName", itemName)
        handle:SetAttribute("Category", category)
        
        local weld = Instance.new("WeldConstraint")
        weld.Part0 = targetPart
        weld.Part1 = handle
        weld.Parent = handle
        
        return true
    end
    return false
end

local function applyShirt(assetId, itemName)
    -- Với custom rig, ta tạo lớp phủ lên torso (dùng decal hoặc colored)
    -- Đơn giản nhất: tạo Shirt object gắn vào character (vẫn hiển thị với rig ẩn)
    -- Vì rig ẩn, ta sẽ tô màu torso theo asset (không hoàn hảo nhưng tiện)
    -- Alternative: fetch texture và tạo decal trên torso
    if not customRig then return end
    local torso = customRig:FindFirstChild("Torso")
    if not torso then return end
    
    -- Xóa shirt marker cũ
    for _, child in ipairs(customRig:GetChildren()) do
        if child:GetAttribute("Category") == "Shirt" then
            child:Destroy()
        end
    end
    
    -- Tạo invisible marker lưu id
    local marker = Instance.new("Folder")
    marker.Name = "ShirtMarker"
    marker:SetAttribute("CatalogId", assetId)
    marker:SetAttribute("DisplayName", itemName)
    marker:SetAttribute("Category", "Shirt")
    marker.Parent = customRig
end

-- ═══════════════════════════════════════════════════════
-- CHARACTER HOOK
-- ═══════════════════════════════════════════════════════
local function onCharacterAdded(char)
    for _, c in ipairs(characterConns) do c:Disconnect() end
    characterConns = {}
    
    local hum = char:WaitForChild("Humanoid", 5)
    if not hum then return end
    
    task.wait(0.5)
    
    if Settings.EvadeMode then
        hideDefaultCharacter(char)
        buildEvadeRig(char, hum)
    end
    
    -- Cập nhật lại transparency
    table.insert(characterConns, RunService.RenderStepped:Connect(function()
        if not Settings.EvadeMode then return end
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                part.LocalTransparencyModifier = 1
            elseif part:IsA("Decal") then
                part.Transparency = 1
            end
        end
    end))
    
    if Settings.AutoLoad and AutoSavedOutfit then
        task.wait(0.5)
    end
end

player.CharacterAdded:Connect(onCharacterAdded)
if player.Character then onCharacterAdded(player.Character) end


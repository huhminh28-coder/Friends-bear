            table.insert(SavedOutfits, {
                Name = "Outfit " .. #SavedOutfits + 1,
                Data = GetCurrentOutfit()
            })
            SaveOutfits()
            renderItems()
        end)
        
        for i, outfit in ipairs(SavedOutfits) do

-- OUTFIT DATA
-- ═══════════════════════════════════════════════════════
local function GetCurrentOutfit()
    if not customRig then return nil end
    local data = { Accessories = {}, Clothes = {}, BodyColors = {} }
    
    for _, child in ipairs(customRig:GetChildren()) do
        local cat = child:GetAttribute("Category")
        local id = child:GetAttribute("CatalogId")
        local name = child:GetAttribute("DisplayName")
        if cat and id then
            if cat == "Shirt" then data.Clothes.Shirt = id
            elseif cat == "Pants" then data.Clothes.Pants = id
            elseif cat == "TShirt" then data.Clothes.TShirt = id
            else
                table.insert(data.Accessories, {Id = id, Name = name, Category = cat})
            end
        end
    end
    
    for _, partName in ipairs({"Head","Torso","LeftArm","RightArm","LeftLeg","RightLeg"}) do
        local part = customRig:FindFirstChild(partName)
        if part then
            data.BodyColors[partName] = {part.Color.R, part.Color.G, part.Color.B}
        end
    end
    
    return data
end

local function LoadSavedOutfit(data)
    if not customRig or not data then return end
    
    if data.Clothes then
        if data.Clothes.Shirt then applyShirt(data.Clothes.Shirt, "Shirt") end
        if data.Clothes.Pants then applyShirt(data.Clothes.Pants, "Pants") end
        if data.Clothes.TShirt then applyShirt(data.Clothes.TShirt, "TShirt") end
    end
    
    if data.Accessories then
        for _, acc in ipairs(data.Accessories) do
            attachAccessoryToRig(acc.Id, acc.Name, acc.Category or "Hat")
        end
    end
    
    if data.BodyColors then
        for partName, color in pairs(data.BodyColors) do
            updateRigColor(partName, Color3.new(color[1], color[2], color[3]))
        end
    end
end

local function AutoSaveOutfit()
    if Settings.AutoLoad then
        AutoSavedOutfit = GetCurrentOutfit()
    end
end


        loading = false
        return
    end
    
    if currentCategory == "Body" then
        -- 12 nút màu body
        local colorList = {
            Color3.fromRGB(255, 205, 148), Color3.fromRGB(255, 220, 177),
            Color3.fromRGB(161, 110, 74), Color3.fromRGB(255, 255, 255),
            Color3.fromRGB(100, 100, 100), Color3.fromRGB(0, 0, 0),
            Color3.fromRGB(255, 0, 0), Color3.fromRGB(255, 255, 0),
            Color3.fromRGB(0, 255, 0), Color3.fromRGB(0, 0, 255),
            Color3.fromRGB(255, 0, 255), Color3.fromRGB(255, 128, 0),
        }
        
        for _, color in ipairs(colorList) do
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(0, 60, 0, 60)
            btn.BackgroundColor3 = color
            btn.Text = ""
            btn.Parent = scroll
            Instance.new("UICorner", btn)
            
            btn.MouseButton1Click:Connect(function()
                if not customRig then return end
                for _, partName in ipairs({"Head", "Torso", "LeftArm", "RightArm"}) do
                    updateRigColor(partName, color)
                end
                AutoSaveOutfit()
            end)
        end
        
        statusLbl.Text = "Chọn màu body"
        loading = false
        return
    end
    
    if currentCategory == "Bundles" then
        statusLbl.Text = "Bundles chưa hỗ trợ cho rig custom"
        loading = false
        return
    end
    
    -- Normal catalog category
    task.spawn(function()
        local result = searchCatalog(currentCategory, currentQuery, nil)
        if myToken ~= renderToken then return end
        
        if not result or not result.data or #result.data == 0 then
            -- Fallback
            local fb = FALLBACK[currentCategory]
            if fb then
                for _, item in ipairs(fb) do
                    addItemCard(item)
                end
                statusLbl.Text = "Offline list (" .. #fb .. " items)"
            else
                statusLbl.Text = "Không có item — thử category khác"
            end
            loading = false
            return
        end
        
        currentPageCursor = result.nextPageCursor
        
        local count = 0
        for _, item in ipairs(result.data) do
            if myToken ~= renderToken then return end
            addItemCard({Id = item.id, Name = item.name or ("#" .. item.id)})
            count = count + 1
        end
        
        statusLbl.Text = "Đã tải " .. count .. " items"
        loading = false
    end)
end


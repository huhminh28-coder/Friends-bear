local function searchCatalog(assetType, keyword, pageCursor)
    local catId = CATEGORY_IDS[assetType]
    if not catId then return nil end
    
    local url = string.format(
        "https://catalog.roblox.com/v1/search/items?category=%d&limit=30&salesTypeFilter=1",
        catId
    )
    if keyword and keyword ~= "" then
        url = url .. "&keyword=" .. HttpService:UrlEncode(keyword)
    end
    if pageCursor then
        url = url .. "&cursor=" .. pageCursor
    end
    
    local data = fetchJSON(url)
    if not data or not data.data then return nil end
    return data
end


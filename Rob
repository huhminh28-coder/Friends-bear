            toggle2.Text = Settings.AutoLoad and "✓" or ""
            SaveSettings()
        end)
        
        container.Size = UDim2.new(1, 0, 0, 110)
        statusLbl.Text = "Settings"
        loading = false
        return
    end
    
    if currentCategory == "Outfits" then
        local save = Instance.new("TextButton")
        save.Size = UDim2.new(0, 220, 0, 40)

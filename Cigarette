-- ===== FADE OUT SMOKE (legacy for the built-in Smoke object) =====
fadeOutSmoke = function(smokeInstance, duration)
    if not smokeInstance or not smokeInstance.Parent then return end
    duration = duration or 3

    local startOpacity = smokeInstance.Opacity
    local startSize = smokeInstance.Size

    local t0 = tick()
    task.spawn(function()
        while tick() - t0 < duration do
            if not smokeInstance or not smokeInstance.Parent then return end
            local alpha = (tick() - t0) / duration
            smokeInstance.Opacity = startOpacity * (1 - alpha)
            smokeInstance.Size = startSize * (1 + alpha * 1.5)
            smokeInstance.RiseVelocity = 2 * (1 - alpha) + 0.5
            task.wait(0.05)
        end
        if smokeInstance and smokeInstance.Parent then
            smokeInstance.Enabled = false
            task.wait(0.5)
            if smokeInstance and smokeInstance.Parent then
                smokeInstance:Destroy()
            end
        end
    end)
end

-- ===== CREATE CIGARETTE TOOL =====
createCigaretteTool = function()
    local newCig = Instance.new("Tool")
    newCig.Name = "Cigarette"
    newCig.RequiresHandle = true
    newCig.CanBeDropped = false
    newCig.ToolTip = "Equip to hold"

    newCig:SetAttribute("PuffsLeft", state.maxPuffs)
    newCig:SetAttribute("IsLit", false)
    newCig:SetAttribute("IsBurnedOut", false)

    local newHandle = Instance.new("Part")
    newHandle.Name = "Handle"
    newHandle.Size = Vector3.new(0.15, originalSizeY, 0.15)
    newHandle.Color = Color3.fromRGB(240, 240, 240)
    newHandle.Material = Enum.Material.SmoothPlastic
    newHandle.CanCollide = false
    newHandle.Parent = newCig

    local newFilter = Instance.new("Part")
    newFilter.Name = "Filter"
    newFilter.Size = Vector3.new(0.16, 0.2, 0.16)
    newFilter.Color = Color3.fromRGB(220, 180, 90)
    newFilter.Material = Enum.Material.SmoothPlastic
    newFilter.CanCollide = false
    newFilter.Parent = newCig

    local filterWeld = Instance.new("Weld")
    filterWeld.Part0 = newHandle
    filterWeld.Part1 = newFilter
    filterWeld.C0 = CFrame.new(0, -originalSizeY / 2 - newFilter.Size.Y / 2, 0)
    filterWeld.Parent = newFilter

    local newEmber = Instance.new("Part")
    newEmber.Name = "Ember"
    newEmber.Size = Vector3.new(0.13, 0.08, 0.13)
    newEmber.Color = Color3.fromRGB(255, 100, 0)
    newEmber.Material = Enum.Material.Neon
    newEmber.CanCollide = false
    newEmber.Transparency = 1
    newEmber.Parent = newCig

    local emberWeld = Instance.new("Weld")
    emberWeld.Part0 = newHandle
    emberWeld.Part1 = newEmber
    emberWeld.C0 = CFrame.new(0, originalSizeY / 2, 0)
    emberWeld.Parent = newEmber

    local newSmoke = Instance.new("Smoke")
    newSmoke.Size = 1
    newSmoke.RiseVelocity = 2
    newSmoke.Opacity = 0.5
    newSmoke.Color = Color3.fromRGB(200, 200, 200)
    newSmoke.Enabled = false
    newSmoke.Parent = newHandle

    local newLight = Instance.new("PointLight")
    newLight.Color = Color3.fromRGB(255, 100, 0)
    newLight.Range = 1.5
    newLight.Brightness = 0.5
    newLight.Enabled = false
    newLight.Parent = newEmber

    newCig.Parent = backpack

    newCig.Equipped:Connect(function()
        cigTool = newCig
        cigHandle = newHandle
        cigEmber = newEmber
        cigSmoke = newSmoke
        cigLight = newLight

        state.puffsLeft = newCig:GetAttribute("PuffsLeft") or state.maxPuffs
        state.isLit = newCig:GetAttribute("IsLit") or false
        state.isBurnedOut = newCig:GetAttribute("IsBurnedOut") or false

        isHolding = true
        applyStateToTool()
    end)

    newCig.Unequipped:Connect(function()
        if newCig and newCig.Parent then
            newCig:SetAttribute("PuffsLeft", state.puffsLeft)
            newCig:SetAttribute("IsLit", state.isLit)
            newCig:SetAttribute("IsBurnedOut", state.isBurnedOut)
        end

        isHolding = false
        hideSmokingText()
        hideLightButton()
    end)

    return newCig
end


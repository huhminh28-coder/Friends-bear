-- ===== BREATHE SMOKE - NATIVE TEXTURE, GRADUAL FADE =====
breatheSmoke = function()
    if not state.isLit then return end
    local char = player.Character
    if not char then return end
    local head = char:FindFirstChild("Head")
    if not head then return end

    -- Attachment at mouth
    local att = Instance.new("Attachment", head)
    att.Name = "ExhaleAttachment"
    att.Position = Vector3.new(0, -0.45, -0.6)

    -- ParticleEmitter with native texture
    local particle = Instance.new("ParticleEmitter", att)
    particle.Texture = "rbxasset://textures/particles/smoke_main.dds"
    particle.Color = ColorSequence.new(Color3.new(1, 1, 1))

    -- GRADUAL FADE: transparency starts low (visible) and ends high (invisible) over particle lifetime
    particle.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.15),   -- fresh: mostly visible
        NumberSequenceKeypoint.new(0.4, 0.5),  -- mid: half faded
        NumberSequenceKeypoint.new(0.8, 0.85), -- old: mostly faded
        NumberSequenceKeypoint.new(1, 1)       -- end: fully invisible
    })

    -- Size grows as it ages (puff expands)
    particle.Size = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.5),
        NumberSequenceKeypoint.new(1, 3)
    })

    particle.LightInfluence = 0
    particle.Rate = 100
    particle.Lifetime = NumberRange.new(2, 3) -- longer life = more fade time
    particle.Speed = NumberRange.new(3, 5)
    particle.EmissionDirection = Enum.NormalId.Front
    particle.SpreadAngle = Vector2.new(20, 20)

    -- Emission burst then stop, particles fade on their own
    task.spawn(function()
        task.wait(0.8)           -- emit for 0.8s
        particle.Rate = 0        -- stop emitting new particles
        particle.Enabled = false -- also disable to be safe

        -- Wait for the last particles to fully fade (lifetime is up to 3s)
        task.wait(3.5)

        if particle and particle.Parent then particle:Destroy() end
        if att and att.Parent then att:Destroy() end
    end)
end

-- ===== ANIMATION =====
animateToMouth = function()
    if isAnimating then return end
    local char = player.Character
    if not char then return end
    local head = char:FindFirstChild("Head")
    if not head then return end
    if not cigHandle or not cigHandle.Parent then return end

    local gw = findGripWeld()
    if not gw then return end

    isAnimating = true
    local originalPart0, originalC0, originalC1 = gw.Part0, gw.C0, gw.C1
    local newSizeY = cigHandle.Size.Y

    gw.Part0 = head
    gw.C1 = CFrame.new(0, -newSizeY / 2, 0)
    local startC0 = mouthBaseC0 * CFrame.new(0, -0.6, -0.8) * CFrame.Angles(math.rad(20), 0, 0)
    local endC0 = mouthBaseC0
    gw.C0 = startC0

    local tween = tweenService:Create(gw, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {C0 = endC0})
    tween:Play()
    tween.Completed:Wait()

    task.wait(1.2)

    local backTween = tweenService:Create(gw, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {C0 = startC0})
    backTween:Play()
    backTween.Completed:Wait()

    if gw and gw.Parent then
        gw.Part0 = originalPart0
        gw.C0 = originalC0
        gw.C1 = originalC1
    end
    isAnimating = false
end

local function takePuff()
    if not state.isLit then return end
    state.puffsLeft = state.puffsLeft - PUFF_COST
    lastPuffTime = tick()
    lastAutoBurn = tick()
    if state.puffsLeft < 0 then state.puffsLeft = 0 end
    updateCigaretteSize()
    syncStateToTool()
    if state.puffsLeft <= 0 then burnOut() end
end

local function updateAutoBurn()
    if not state.isLit then lastAutoBurn = tick() return end
    if tick() - lastAutoBurn >= AUTO_BURN_INTERVAL then
        lastAutoBurn = tick()
        state.puffsLeft = state.puffsLeft - 1
        if state.puffsLeft < 0 then state.puffsLeft = 0 end
        updateCigaretteSize()
        syncStateToTool()
        if state.puffsLeft <= 0 then burnOut() end
    end
end

userInput.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        touchStart = input.Position
        touchStartTime = tick()
    end
end)

userInput.InputEnded:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType ~= Enum.UserInputType.Touch and input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
    if not touchStart then return end

    local endPos = input.Position
    local duration = tick() - touchStartTime
    local distance = (endPos - touchStart).Magnitude
    touchStart = nil

    if not cigTool or cigTool.Parent ~= player.Character then return end
    if not state.isLit or isAnimating then return end

    if duration < 0.25 and distance < 20 then
        local now = tick()
        if now - lastBreathe < PUFF_DELAY then return end
        lastBreathe = now
        breatheSmoke()
        showSmokingText()
        task.spawn(animateToMouth)
        takePuff()
    end
end)

userInput.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.F then
        if cigTool and cigTool.Parent == player.Character and state.isLit and not isAnimating then
            local now = tick()
            if now - lastBreathe < PUFF_DELAY then return end
            lastBreathe = now
            breatheSmoke()
            showSmokingText()
            task.spawn(animateToMouth)
            takePuff()
        end
    end
end)

runService.Heartbeat:Connect(function()
    updateAutoBurn()
end)

-- ===== GUARD LOOP =====
local function startPackGuard(duration)
    if isGuardRunning then return end
    isGuardRunning = true
    task.spawn(function()
        local endTime = tick() + duration
        while tick() < endTime do
            ensureCigarettePack()
            task.wait(0.25)
        end
        isGuardRunning = false
    end)
end


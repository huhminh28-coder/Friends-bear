-- ===== CIGARETTE LOGIC =====
applyStateToTool = function()
    if not cigTool then return end
    if state.isBurnedOut then
        hideLightButton()
        updateCigaretteSize()
        if cigEmber then cigEmber.Transparency = 1 end
        if cigSmoke then fadeOutSmoke(cigSmoke, 3) end
        if cigLight then cigLight.Enabled = false end
    elseif state.isLit then
        hideLightButton()
        updateCigaretteSize()
        if cigEmber then cigEmber.Transparency = 0 end
        if cigSmoke then
            cigSmoke.Enabled = true
            cigSmoke.Opacity = 0.5
            cigSmoke.Size = 1
        end
        if cigLight then cigLight.Enabled = true end
    else
        if isHolding then showLightButton() end
        updateCigaretteSize()
        if cigEmber then cigEmber.Transparency = 1 end
        if cigSmoke then fadeOutSmoke(cigSmoke, 3) end
        if cigLight then cigLight.Enabled = false end
    end
end

updateCigaretteSize = function()
    if not cigHandle or not cigEmber or not cigTool then return end
    local ratio = math.clamp(state.puffsLeft / state.maxPuffs, 0, 1)
    local newSizeY = math.max(0.05, originalSizeY * ratio)
    cigHandle.Size = Vector3.new(cigHandle.Size.X, newSizeY, cigHandle.Size.Z)
    local filter = cigTool:FindFirstChild("Filter")
    if filter then
        local fw = filter:FindFirstChildOfClass("Weld")
        if fw then fw.C0 = CFrame.new(0, -newSizeY / 2 - filter.Size.Y / 2, 0) end
    end
    local ew = cigEmber:FindFirstChildOfClass("Weld")
    if ew then ew.C0 = CFrame.new(0, newSizeY / 2, 0) end
end

burnOut = function()
    state.isLit = false
    state.isBurnedOut = true
    state.puffsLeft = 0
    if cigLight then cigLight.Enabled = false end
    if cigEmber then cigEmber.Transparency = 1 end
    if cigSmoke then fadeOutSmoke(cigSmoke, 3) end
    hideSmokingText()
    hideLightButton()

    local dyingTool = cigTool
    if dyingTool then
        dyingTool:SetAttribute("PuffsLeft", 0)
        dyingTool:SetAttribute("IsLit", false)
        dyingTool:SetAttribute("IsBurnedOut", true)
    end

    task.delay(3.5, function()
        if dyingTool then
            pcall(function() dyingTool:Destroy() end)
        end
        if cigTool == dyingTool then
            cigTool = nil
            cigHandle = nil
            cigEmber = nil
            cigSmoke = nil
            cigLight = nil
            isHolding = false
        end
    end)
end


    resetPositions("Red")
    handleNewMatchStart()
    if gameState.crowdSound then gameState.crowdSound.Volume = 0 end
    gameState.gameActive = true
end

local function endPenaltyShootout()
    gameState.penaltyActive = false
    hidePenaltyUI()
    local winner
    if gameState.penaltyScoreRed > gameState.penaltyScoreBlue then winner = "Red"
    elseif gameState.penaltyScoreBlue > gameState.penaltyScoreRed then winner = "Blue"
    else winner = "Draw" end
    if winner ~= "Draw" then
        local winnerName = (winner == "Red") and gameState.teamRedName or gameState.teamBlueName
        startCelebration(winner)
        showBigText("🏆 " .. winnerName .. " THẮNG LUÂN LƯU!\n" .. gameState.penaltyScoreRed .. " - " .. gameState.penaltyScoreBlue, Color3.fromRGB(255, 220, 100))
        task.wait(8)
        hideBigText()
    else
        showBigText("HÒA LUÂN LƯU!", Color3.fromRGB(255, 100, 100))
        task.wait(3)
        hideBigText()
    end
    resetAllAfterMatch()
end

local function startPenaltyShootout()
    gameState.penaltyActive = true
    gameState.penaltyRound = 0
    gameState.penaltyScoreRed = 0
    gameState.penaltyScoreBlue = 0
    gameState.lastTouchTeam = nil
    gameState.goalScored = true
    gameState.gameActive = false
    gameState.playerDribbling = false
    
    for _, bot in ipairs(gameState.redTeam) do
        if bot.PrimaryPart and bot.Role.Value ~= "Goalkeeper" then
            local p = Vector3.new(MAP_POS.X - 100, TORSO_Y, MAP_POS.Z + PITCH_LENGTH/2 - 80)
            moveCharacter(bot, p, Vector3.new(MAP_POS.X, p.Y, MAP_POS.Z))
        end
    end
    for _, bot in ipairs(gameState.blueTeam) do
        if bot.PrimaryPart and bot.Role.Value ~= "Goalkeeper" then
            local p = Vector3.new(MAP_POS.X + 100, TORSO_Y, MAP_POS.Z + PITCH_LENGTH/2 - 80)
            moveCharacter(bot, p, Vector3.new(MAP_POS.X, p.Y, MAP_POS.Z))
        end
    end
    
    showPenaltyUI()
    updatePenaltyScoreLabel()
    if penaltyPromptLbl then penaltyPromptLbl.Text = "LUÂN LƯU 5 LƯỢT!" end
    task.wait(2)
    
    task.spawn(function()
        for round = 1, PENALTY_ROUNDS do
            if not gameState.penaltyActive then return end
            gameState.penaltyRound = round
            updatePenaltyScoreLabel()
            
            doPenaltyShot("Red")
            if not gameState.penaltyActive then return end
            doPenaltyShot("Blue")
            if not gameState.penaltyActive then return end
            
            local remainingRounds = PENALTY_ROUNDS - round
            local diff = math.abs(gameState.penaltyScoreRed - gameState.penaltyScoreBlue)
            local maxRemaining = remainingRounds * 2
            if diff > maxRemaining then
                endPenaltyShootout()
                return
            end
        end
        endPenaltyShootout()
    end)
end
-- ========== END PENALTY ==========

local function startTimer()
    task.spawn(function()
        while true do
            task.wait(1)
            if gameState.gameActive and not gameState.paused 
               and not gameState.gkHolding 
               and not gameState.goalScored
               and not gameState.penaltyActive then
                gameState.timeLeft=gameState.timeLeft-1
                if gameState.timeLeft<=0 then
                    if gameState.isExtraTime then
                        playFinalWhistle()
                        showBigText("HẾT HIỆP PHỤ\nLUÂN LƯU!",Color3.fromRGB(255,200,100))
                        task.wait(3)
                        hideBigText()
                        startPenaltyShootout()
                        return
                    elseif gameState.currentHalf<gameState.maxHalves then
                        gameState.paused=true
                        gameState.gameActive=false
                        playWhistle()
                        showBigText("HALF TIME",Color3.fromRGB(255,255,100))
                        task.wait(3)
                        hideBigText()
                        gameState.restartCountdown=HALF_BREAK
                        while gameState.restartCountdown>0 do
                            task.wait(1)
                            gameState.restartCountdown=gameState.restartCountdown-1
                        end
                        gameState.currentHalf=gameState.currentHalf+1
                        gameState.timeLeft=gameState.timeConfig.halfTime
                        gameState.playerDribbling=false
                        resetPositions("Red")
                        gameState.paused=false
                        gameState.gameActive=true
                    else
                        gameState.paused=true
                        gameState.gameActive=false
                        if gameState.scoreRed==gameState.scoreBlue then
                            playWhistle()
                            showBigText("FULL TIME\nDRAW!\nHIỆP PHỤ",Color3.fromRGB(255,255,100))
                            task.wait(3)
                            hideBigText()
                            gameState.restartCountdown=HALF_BREAK
                            while gameState.restartCountdown>0 do
                                task.wait(1)
                                gameState.restartCountdown=gameState.restartCountdown-1
                            end
                            gameState.isExtraTime=true
                            gameState.timeLeft=gameState.timeConfig.extraTime
                            gameState.playerDribbling=false
                            resetPositions("Red")
                            gameState.paused=false
                            gameState.gameActive=true
                        else
                            local w=gameState.teamRedName.." WINS!"
                            if gameState.scoreBlue>gameState.scoreRed then w=gameState.teamBlueName.." WINS!" end
                            task.spawn(function()
                                endMatch("FULL TIME\n"..w)
                            end)
                        end
                    end
                end
            end
        end
    end)
end


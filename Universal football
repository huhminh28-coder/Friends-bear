local function createGuard(pos)
    local guard = Instance.new("Model")
    guard.Name = "SecurityGuard"
    local function mp(name,size,color,ox,oy,oz)
        local p = Instance.new("Part"); p.Name=name; p.Size=size; p.Color=color
        p.Material=Enum.Material.SmoothPlastic; p.Anchored=true; p.CanCollide=true
        p.TopSurface=Enum.SurfaceType.Smooth; p.BottomSurface=Enum.SurfaceType.Smooth
        p:SetAttribute("OffX",ox or 0); p:SetAttribute("OffY",oy or 0); p:SetAttribute("OffZ",oz or 0)
        p.Parent=guard; return p
    end
    local black = Color3.fromRGB(10, 10, 10)
    mp("Torso",Vector3.new(2,2,1),black,0,0,0)
    local head = mp("Head",Vector3.new(2,1,1),Color3.fromRGB(255,215,170),0,1.5,0)

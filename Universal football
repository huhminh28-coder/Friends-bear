local function animatePenaltyBall(team, choice, isGoal, isMiss)
    local ball = gameState.ball
    if not ball then return end
    local goalZ = (team == "Red") and (MAP_POS.Z + PITCH_LENGTH/2) or (MAP_POS.Z - PITCH_LENGTH/2)
    local startZ = (team == "Red") and (MAP_POS.Z + PITCH_LENGTH/2 - 40) or (MAP_POS.Z - PITCH_LENGTH/2 + 40)
    ball.Anchored = true
    ball.CFrame = CFrame.new(Vector3.new(MAP_POS.X, MAP_POS.Y + 3, startZ))
    local targetX = MAP_POS.X
    local targetY = MAP_POS.Y + 10
    if choice == "Left" then targetX = MAP_POS.X - GOAL_WIDTH/2 + 5
    elseif choice == "Right" then targetX = MAP_POS.X + GOAL_WIDTH/2 - 5 end
    if isMiss then targetY = MAP_POS.Y + GOAL_HEIGHT + 15 end
    local targetPos = Vector3.new(targetX, targetY, goalZ)
    local tween = TweenService:Create(ball, TweenInfo.new(0.6, Enum.EasingStyle.Linear), {CFrame = CFrame.new(targetPos)})
    tween:Play()
    playBallKick(ball.Position, 1.2)
end

local function doPenaltyShot(team)
    if not gameState.penaltyActive then return end
    gameState.penaltyTaking = true
    gameState.penaltyUserChoice = nil
    gameState.penaltyGKChoice = nil
    
    local isPlayerTeam = (team == gameState.playerTeam) and not gameState.playerSuspended
    local choice
    
    if isPlayerTeam then
        updatePenaltyScoreLabel()
        if penaltyPromptLbl then penaltyPromptLbl.Text = "LƯỢT CỦA BẠN — CHỌN HƯỚNG SÚT!" end
        for _, b in pairs(penaltyBtns) do b.Visible = true end
        local waitStart = tick()
        while gameState.penaltyUserChoice == nil and tick() - waitStart < 10 do
            task.wait(0.05)
        end
        choice = gameState.penaltyUserChoice or "Center"
        for _, b in pairs(penaltyBtns) do b.Visible = false end
    else
        if penaltyPromptLbl then penaltyPromptLbl.Text = (team == "Red") and gameState.teamRedName .. " sút..." or gameState.teamBlueName .. " sút..." end
        task.wait(1)
        choice = {"Left", "Center", "Right"}[math.random(3)]
    end
    
    local gkChoice = {"Left", "Center", "Right"}[math.random(3)]
    gameState.penaltyGKChoice = gkChoice
    
    local isMiss = math.random() < PENALTY_MISS_CHANCE
    local isGoal = (not isMiss) and (choice ~= gkChoice)
    
    if penaltyPromptLbl then
        penaltyPromptLbl.Text = string.format("SÚT: %s   |   TM: %s", choice, gkChoice)
    end
    
    local gkTeam = (team == "Red") and "Blue" or "Red"
    for _, bot in ipairs((gkTeam == "Red") and gameState.redTeam or gameState.blueTeam) do
        if bot.Role.Value == "Goalkeeper" and bot.PrimaryPart then
            local gk = bot
            local gkPos = gk.PrimaryPart.Position
            local diveX = gkPos.X
            if gkChoice == "Left" then diveX = MAP_POS.X - GOAL_WIDTH/2 + 8
            elseif gkChoice == "Right" then diveX = MAP_POS.X + GOAL_WIDTH/2 - 8 end
            task.spawn(function()
                local startT = tick()
                while tick() - startT < 0.5 do
                    local progress = (tick() - startT) / 0.5
                    local newX = gkPos.X + (diveX - gkPos.X) * progress
                    local newY = gkPos.Y + math.sin(progress * math.pi) * 4
                    moveCharacter(gk, Vector3.new(newX, newY, gkPos.Z), Vector3.new(MAP_POS.X, newY, MAP_POS.Z))
                    task.wait(0.02)
                end
                task.wait(0.5)
                moveCharacter(gk, gkPos, Vector3.new(MAP_POS.X, gkPos.Y, MAP_POS.Z))
            end)
            break
        end
    end
    
    animatePenaltyBall(team, choice, isGoal, isMiss)
    task.wait(0.7)
    
    if isGoal then
        if team == "Red" then gameState.penaltyScoreRed = gameState.penaltyScoreRed + 1
        else gameState.penaltyScoreBlue = gameState.penaltyScoreBlue + 1 end
        if penaltyPromptLbl then penaltyPromptLbl.Text = "⚽ VÀO!" end
    else
        if isMiss then
            if penaltyPromptLbl then penaltyPromptLbl.Text = "🚀 BẮN CHIM!" end
        else
            if penaltyPromptLbl then penaltyPromptLbl.Text = "🧤 THỦ MÔN CẢN PHÁ!" end
        end
    end
    
    updatePenaltyScoreLabel()
    task.wait(PENALTY_WAIT - 0.7)
    gameState.penaltyTaking = false
end

local function startCelebration(winningTeam)
    gameState.celebrating = true
    if gameState.crowdSound then gameState.crowdSound.Volume = 3 end
    local teamList = (winningTeam == "Red") and gameState.redTeam or gameState.blueTeam
    local centerZ = (winningTeam == "Red") and (MAP_POS.Z + PITCH_LENGTH/2 - 30) or (MAP_POS.Z - PITCH_LENGTH/2 + 30)
    local centerPos = Vector3.new(MAP_POS.X, TORSO_Y, centerZ)
    gameState.celebrationConn = RunService.Heartbeat:Connect(function()
        if not gameState.celebrating then
            if gameState.celebrationConn then
                gameState.celebrationConn:Disconnect()
                gameState.celebrationConn = nil
            end
            return
        end
        for i, bot in ipairs(teamList) do
            if bot.PrimaryPart then
                local angle = (i / #teamList) * math.pi * 2
                local radius = 4
                local targetPos = centerPos + Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
                local jump = math.abs(math.sin(tick() * 6 + i)) * 3
                local newPos = Vector3.new(targetPos.X, targetPos.Y + jump, targetPos.Z)
                moveCharacter(bot, newPos, Vector3.new(centerPos.X, newPos.Y, centerPos.Z))
            end
        end
        if gameState.playerTeam == winningTeam and not gameState.playerSuspended then
            local pc = gameState.playerChar
            if pc and pc:FindFirstChild("HumanoidRootPart") then
                local hrp = pc:FindFirstChild("HumanoidRootPart")
                local jump = math.abs(math.sin(tick() * 6)) * 3
                hrp.CFrame = CFrame.new(centerPos + Vector3.new(0, jump, 0))
            end
        end
    end)
end

function resetAllAfterMatch()
    gameState.paused = true
    gameState.gameActive = false
    gameState.penaltyActive = false
    gameState.celebrating = false
    hidePenaltyUI()
    if gameState.celebrationConn then
        gameState.celebrationConn:Disconnect()

            elseif role=="Midfielder" then local mi=bot:GetAttribute("FormationIndex") or 1; target=Vector3.new(px+((mi<=2) and -90 or 90),TORSO_Y,pz+ad*80+((mi%2==0) and 30 or -30))
            else local di=bot:GetAttribute("FormationIndex") or 1; target=Vector3.new(px+((di<=2) and -70 or 70),TORSO_Y,pz-ad*100) end
            target=Vector3.new(math.clamp(target.X,MAP_POS.X-PITCH_WIDTH/2+10,MAP_POS.X+PITCH_WIDTH/2-10),TORSO_Y,math.clamp(target.Z,MAP_POS.Z-PITCH_LENGTH/2+5,MAP_POS.Z+PITCH_LENGTH/2-5))
            local d=target-bp; if d.Magnitude>3 then local np=bp+d.Unit*aspd*dt; pcall(moveCharacter, bot, Vector3.new(np.X,TORSO_Y,np.Z), Vector3.new(px,np.Y,pz)) end
            return
        end
    end
    
    local target = getHomePos(bot, true)
    
    if role == "Defender" then
        local ballInHome = math.abs(ball.Position.Z - ogz) < 200
        if ballInHome and (bp - ball.Position).Magnitude < 80 then
            target = ball.Position
        else
            local markTarget = nil
            local minD = math.huge
            for _, opp in ipairs(ol) do
                if opp.PrimaryPart and (opp.Role.Value == "Striker" or opp.Role.Value == "Midfielder") then
                    local d = (opp.PrimaryPart.Position - ogz).Magnitude
                    if d < minD then minD = d; markTarget = opp end
                end
            end
            if markTarget and minD < 150 then
                local op = markTarget.PrimaryPart.Position
                local markDist = 8 - (diff.interceptMul * 2)
                local dirToOpp = (op - bp).Unit
                target = op - dirToOpp * math.max(3, markDist)
            end
        end
        local bv = ball.AssemblyLinearVelocity
        local toGoal = Vector3.new(MAP_POS.X, TORSO_Y, ogz) - ball.Position
        if bv.Magnitude > 150 and bv:Dot(toGoal.Unit) > 0.4 then
            local blockPos = ball.Position + bv * 0.2
            target = Vector3.new(blockPos.X, TORSO_Y, blockPos.Z)
            aspd = aspd * 1.5
        end
    elseif bot==closestBot then
        target=ball.Position+ball.AssemblyLinearVelocity*0.3
        if (bp-ball.Position).Magnitude<12 then handleBallTouch(bot); gameState.lastActionTime=tick() end
    elseif role=="Striker" then
        local xo=((bot:GetAttribute("FormationIndex") or 1)==1) and -60 or 60
        local tz=thb and (agz-100) or (MAP_POS.Z+(agz-MAP_POS.Z)*0.35)
        target=Vector3.new(MAP_POS.X+xo+math.clamp((ball.Position.X-MAP_POS.X)*0.5,-80,80),MAP_POS.Y+5,tz)
        local dtb=(bp-ball.Position).Magnitude
        if dtb<80 and ball.Position.Z*((team=="Red") and 1 or -1)>0 then target=ball.Position+ball.AssemblyLinearVelocity*0.4 end
        if dtb<12 then handleBallTouch(bot); gameState.lastActionTime=tick() end
    elseif thb then
        if role=="Midfielder" then target=Vector3.new(ball.Position.X+math.random(-40,40),MAP_POS.Y+5,math.max(ball.Position.Z,(ball.Position.Z+agz)/2))
        else target=Vector3.new(MAP_POS.X+((bot:GetAttribute("FormationIndex") or 2)-2.5)*50,MAP_POS.Y+5,math.max(MAP_POS.Z-30,ball.Position.Z-80)) end
    else
        if role=="Midfielder" then
            target=((bp-ball.Position).Magnitude<120) and (ball.Position+ball.AssemblyLinearVelocity*0.2) or Vector3.new(ball.Position.X*0.5+MAP_POS.X*0.5,MAP_POS.Y+5,(ball.Position.Z+ogz)/2)
        end
    end
    
    local d=target-bp
    if d.Magnitude>1 then 
        local np=bp+d.Unit*aspd*dt
        pcall(moveCharacter, bot, Vector3.new(np.X,TORSO_Y,np.Z), Vector3.new(ball.Position.X,np.Y,ball.Position.Z)) 
    else
        pcall(moveCharacter, bot, bp, Vector3.new(ball.Position.X,bp.Y,ball.Position.Z))
    end
end

local function updateAILogic(dt)
    local ball=gameState.ball; if not ball or not ball.Parent then return end
    if gameState.restartCooldown or gameState.goalScored then return end
    if gameState.inPenaltyShootout or gameState.celebrating or gameState.trophyActive then return end
    if gameState.goalCelebrationActive then return end
    if gameState.paused or gameState.restartCountdown>0 then return end
    
    if gameState.practiceModeEnabled then
        for _, bot in ipairs(gameState.redTeam) do if bot.Role.Value == "Goalkeeper" then updateGoalkeeperAI(bot, dt) end end
        for _, bot in ipairs(gameState.blueTeam) do if bot.Role.Value == "Goalkeeper" then updateGoalkeeperAI(bot, dt) end end
        return
    end

    local ab={}
    for _,b in ipairs(gameState.redTeam) do table.insert(ab,b) end
    for _,b in ipairs(gameState.blueTeam) do table.insert(ab,b) end
    local cb,md=nil,math.huge
    for _,bot in ipairs(ab) do if bot.PrimaryPart and bot.Role.Value~="Goalkeeper" then
        local d=(bot.PrimaryPart.Position-ball.Position).Magnitude; if d<md then md=d; cb=bot end
    end end
    local ct=tick()-gameState.lastActionTime>0.6
    if gameState.gkHolding or gameState.playerDribbling then ct=false end
    for _,bot in ipairs(ab) do if bot.PrimaryPart then
        if bot.Role.Value=="Goalkeeper" then updateGoalkeeperAI(bot,dt)
        else
            local pd=gameState.playerDribbling and (gameState.playerTeam==bot.Team.Value) and not gameState.isOnBench
            local sc=bot==cb and not ct and not pd
            if gameState.playerSkillActive or gameState.superSkillActive then sc=false end
            if gameState.gkHolding then sc=false end
            if sc then
                local d=ball.Position-bot.PrimaryPart.Position
                if d.Magnitude>1 then
                    local diff=getDiff(bot.Team.Value)
                    local np=bot.PrimaryPart.Position+d.Unit*AI_SPEED*diff.speedMul*dt
                    local ld=Vector3.new(d.X,0,d.Z); if ld.Magnitude<0.1 then ld=Vector3.new(0,0,1) end
                    pcall(moveCharacter, bot, Vector3.new(np.X,TORSO_Y,np.Z), np+ld.Unit)
                end
            else updateOutfieldAI(bot,ab,cb,dt) end
        end
    end end
end

local function checkInterception()
    local ball=gameState.ball; if not ball or not ball.Parent or gameState.gkHolding then return end
    if gameState.inPenaltyShootout or gameState.celebrating or gameState.paused or gameState.restartCountdown>0 then return end
    if gameState.playerSkillActive or gameState.superSkillActive then return end
    local speed=ball.AssemblyLinearVelocity.Magnitude
    local isD=gameState.playerDribbling
    if speed<20 and not isD then return end
    if not gameState.lastTouchTeam then return end
    local otn=(gameState.lastTouchTeam=="Red") and "Blue" or "Red"
    local ol=(gameState.lastTouchTeam=="Red") and gameState.blueTeam or gameState.redTeam
    local diff=getDiff(otn)
    for _,bot in ipairs(ol) do if bot.PrimaryPart then
        local d=(bot.PrimaryPart.Position-ball.Position).Magnitude
        local chance=0.5*diff.interceptMul
        if isD then chance=(d>8 and 0.05 or 0.35)*diff.interceptMul
        else if speed>400 then chance=0.15*diff.interceptMul elseif speed>300 then chance=0.25*diff.interceptMul elseif speed>200 then chance=0.35*diff.interceptMul end end
        if d<14 and math.random()<chance then
            local dir=(bot.PrimaryPart.Position-ball.Position).Unit
            if gameState.playerDribbling then gameState.playerDribbling=false end
            ball.AssemblyLinearVelocity=dir*speed*0.5+Vector3.new(math.random(-20,20),30,math.random(-20,20))
            gameState.ballIsCurving=false; gameState.lastTouchTeam=otn; playBallTouchSound(); return
        end
    end end
end


local function startTrophyCeremony(winningTeam)
    gameState.trophyActive = true
    local losingTeam = (winningTeam == "Red") and "Blue" or "Red"
    local winners = (winningTeam == "Red") and gameState.redTeam or gameState.blueTeam
    local losers = (winningTeam == "Red") and gameState.blueTeam or gameState.redTeam
    local playerIsWinner = (gameState.playerTeam == winningTeam)

    -- Build podium
    if gameState.podiumModel then gameState.podiumModel:Destroy() end
    local podium = Instance.new("Model")
    podium.Name = "TrophyPodium"
    podium.Parent = workspace
    gameState.podiumModel = podium

    local podiumCenter = MAP_POS + Vector3.new(0, 3, -100)  -- slightly behind midfield
    local function mkStep(name, size, pos, color)
        local p = Instance.new("Part")
        p.Name = name; p.Size = size; p.Position = pos
        p.Color = color or Color3.fromRGB(180, 180, 190)
        p.Material = Enum.Material.Marble
        p.Anchored = true; p.Parent = podium
        return p
    end
    -- 3 tiers: center highest (champion), two sides lower
    mkStep("Center", Vector3.new(12, 6, 8), podiumCenter + Vector3.new(0, 3, 0), Color3.fromRGB(220, 200, 100))
    mkStep("Left", Vector3.new(8, 4, 8), podiumCenter + Vector3.new(-10, 2, 0), Color3.fromRGB(180, 180, 200))
    mkStep("Right", Vector3.new(8, 4, 8), podiumCenter + Vector3.new(10, 2, 0), Color3.fromRGB(180, 180, 200))
    -- Red carpet
    local carpet = Instance.new("Part")
    carpet.Name = "Carpet"; carpet.Size = Vector3.new(60, 0.2, 6)
    carpet.Position = podiumCenter + Vector3.new(0, 6.2, 5)
    carpet.Color = Color3.fromRGB(180, 30, 30); carpet.Material = Enum.Material.Fabric
    carpet.Anchored = true; carpet.Parent = podium

    -- Build trophy (initially floating above podium)
    if gameState.trophyModel then gameState.trophyModel:Destroy() end
    local trophy = buildTrophy(gameState.tournamentType)
    trophy:PivotTo(CFrame.new(podiumCenter + Vector3.new(0, 20, 0)))
    trophy.Parent = workspace
    gameState.trophyModel = trophy

    -- Move winning players onto podium
    local nonGKWinners = {}
    for _, bot in ipairs(winners) do
        if bot.PrimaryPart and bot.Role.Value ~= "Goalkeeper" then
            table.insert(nonGKWinners, bot)
        end
    end
    -- Pick center player (first one)
    local centerPlayer = nonGKWinners[1]
    for i, bot in ipairs(nonGKWinners) do
        if bot.PrimaryPart then
            local pos
            if i == 1 then
                pos = podiumCenter + Vector3.new(0, TORSO_Y - MAP_POS.Y + 6, 0)
            elseif i == 2 then
                pos = podiumCenter + Vector3.new(-10, TORSO_Y - MAP_POS.Y + 4, 0)
            elseif i == 3 then
                pos = podiumCenter + Vector3.new(10, TORSO_Y - MAP_POS.Y + 4, 0)
            else
                pos = podiumCenter + Vector3.new(
                    -25 + math.random()*50, TORSO_Y - MAP_POS.Y, 8 + math.random()*4
                )
            end
            moveCharacter(bot, pos, podiumCenter + Vector3.new(0, 0, 20))
        end
    end
    -- Player (if winner)
    if playerIsWinner and gameState.playerChar then
        local hrp = gameState.playerChar:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.CFrame = CFrame.new(podiumCenter + Vector3.new(3, TORSO_Y - MAP_POS.Y + 6, 0))
        end
    end

    -- Move losing players into a line opposite
    local lineZ = podiumCenter.Z + 25
    local lineSpacing = 5
    local lineStartX = -((#losers - 1) * lineSpacing) / 2
    for i, bot in ipairs(losers) do
        if bot.PrimaryPart then
            local pos = Vector3.new(podiumCenter.X + lineStartX + (i-1)*lineSpacing, TORSO_Y, lineZ)
            moveCharacter(bot, pos, podiumCenter)
        end
    end

    task.wait(2)

    -- Animate trophy lifting: trophy rises then descends onto center player's hands
    local targetHandPos = podiumCenter + Vector3.new(0, TORSO_Y - MAP_POS.Y + 6 + 3, 0)
    local riseTween = TweenService:Create(trophy.PrimaryPart, TweenInfo.new(1.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        CFrame = CFrame.new(targetHandPos)
    })
    riseTween:Play()
    task.wait(1.5)

    -- Fire fireworks!
    for i = 1, 12 do
        task.spawn(function()
            local angle = math.random() * math.pi * 2
            local dist = 40 + math.random() * 80
            local pos = MAP_POS + Vector3.new(math.cos(angle) * dist, 5, math.sin(angle) * dist)
            launchFirework(pos)
        end)
        task.wait(0.4)
    end

    -- Hold trophy up for 4 seconds, then players hug losers
    task.wait(4)

    -- Move winners toward losing players for hugs
    local hugDuration = 3
    local hugStart = tick()
    local hugConn
    hugConn = RunService.Heartbeat:Connect(function()
        if tick() - hugStart > hugDuration then
            if hugConn then hugConn:Disconnect() end
            return
        end
        for i, bot in ipairs(nonGKWinners) do
            if bot.PrimaryPart then
                local loser = losers[i]
                if loser and loser.PrimaryPart then
                    local cur = bot.PrimaryPart.Position
                    local targetPos = loser.PrimaryPart.Position + Vector3.new(0, 0, -3)
                    local dir = (targetPos - cur)
                    local horiz = Vector3.new(dir.X, 0, dir.Z)
                    if horiz.Magnitude > 1.5 then
                        horiz = horiz.Unit
                        local newPos = cur + horiz * 15 * 0.03
                        moveCharacter(bot, Vector3.new(newPos.X, TORSO_Y, newPos.Z), targetPos)
                    end
                end
            end
        end
    end)

    task.wait(hugDuration + 1)
    if hugConn then hugConn:Disconnect() end
    gameState.trophyActive = false

    -- Cleanup
    task.wait(3)
    if gameState.podiumModel then gameState.podiumModel:Destroy(); gameState.podiumModel = nil end
    if gameState.trophyModel then gameState.trophyModel:Destroy(); gameState.trophyModel = nil end
end


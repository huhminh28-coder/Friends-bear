local function runPenaltyShootout()
    gameState.inPenaltyShootout=true; hideGoalText(); gameState.playerDribbling=false
    if not gameState.ball or not gameState.ball.Parent then createBall() end
    createPenaltyUI()
    local rs,bs=0,0; local mr=5
    local gzF={Red=MAP_POS.Z+PITCH_LENGTH/2,Blue=MAP_POS.Z-PITCH_LENGTH/2}
    local function fgk(team) for _,bot in ipairs((team=="Red") and gameState.redTeam or gameState.blueTeam) do if bot.Role.Value=="Goalkeeper" then return bot end end end
    local ru,bu={},{}
    local rsC,bsC=0,0
    local function gsh(team)
        local ul=(team=="Red") and ru or bu
        if team==gameState.playerTeam and not ul["player"] then
            local pc=gameState.playerChar; if pc and pc:FindFirstChild("HumanoidRootPart") then return {isPlayer=true,char=pc,key="player"} end
        end
        for _,bot in ipairs((team=="Red") and gameState.redTeam or gameState.blueTeam) do
            if bot.PrimaryPart and bot.Role.Value~="Goalkeeper" and not ul[bot.Name] then return {isPlayer=false,bot=bot,key=bot.Name} end
        end
        if team=="Red" then ru={} else bu={} end
        for _,bot in ipairs((team=="Red") and gameState.redTeam or gameState.blueTeam) do
            if bot.PrimaryPart and bot.Role.Value~="Goalkeeper" then return {isPlayer=false,bot=bot,key=bot.Name} end
        end
    end
    local function ts(team,round)
        if not gameState.ball or not gameState.ball.Parent then createBall() end
        local sh=gsh(team); if not sh then return false end
        local ul=(team=="Red") and ru or bu; ul[sh.key]=true
        local gz=gzF[team]; local sign=(gz>MAP_POS.Z) and 1 or -1; local sz=gz-sign*PENALTY_DIST
        local ot=(team=="Red") and "Blue" or "Red"
        local gk=fgk(ot)
        if gk and gk.PrimaryPart then pcall(moveCharacter, gk, Vector3.new(MAP_POS.X,TORSO_Y,gz-sign*6), Vector3.new(MAP_POS.X,TORSO_Y,MAP_POS.Z)) end
        local bp=Vector3.new(MAP_POS.X,MAP_POS.Y+3,sz)
        if gameState.ball then
            gameState.ball.Anchored=true; gameState.ball.CFrame=CFrame.new(bp)
            gameState.ball.AssemblyLinearVelocity=Vector3.zero; gameState.ball.AssemblyAngularVelocity=Vector3.zero; gameState.ball.CanCollide=true
        end
        local az=sz-sign*8; local ap=Vector3.new(MAP_POS.X,TORSO_Y,az)
        if sh.isPlayer then
            local hrp=sh.char:FindFirstChild("HumanoidRootPart")
            if hrp then hrp.CFrame=CFrame.new(ap,Vector3.new(MAP_POS.X,ap.Y,gz)); hrp.AssemblyLinearVelocity=Vector3.zero end
        elseif sh.bot.PrimaryPart then pcall(moveCharacter, sh.bot, ap, Vector3.new(MAP_POS.X,ap.Y,gz)) end
        task.wait(0.8)
        local sd
        if sh.isPlayer then
            local dr=makeDirectionUI(); local sw=tick()
            while not dr.value and tick()-sw<8 do task.wait(0.05) end
            sd=dr.value or "Center"; clearDirectionUI()
        else
            task.wait(1); local r=math.random(1,100)
            if r<=25 then sd="Left" elseif r<=50 then sd="Right" elseif r<=75 then sd="Center" else sd="Over" end
        end
        local gd; local gr=math.random(1,100)
        if gr<=40 then gd="Left" elseif gr<=80 then gd="Right" else gd="Center" end
        if gk and gk.PrimaryPart then
            local gs=gk.PrimaryPart.Position; local tx=MAP_POS.X
            if gd=="Left" then tx=MAP_POS.X-18 elseif gd=="Right" then tx=MAP_POS.X+18 end
            task.spawn(function() local st=tick()
                while tick()-st<0.7 do if gk.PrimaryPart then
                    local cu=gk.PrimaryPart.Position; local nx=cu.X+(tx-cu.X)*0.15
                    pcall(moveCharacter, gk, Vector3.new(nx,TORSO_Y,gs.Z), Vector3.new(MAP_POS.X,TORSO_Y,MAP_POS.Z))
                end task.wait(0.03) end
            end)
        end
        task.wait(0.3)
        if gameState.ball then
            gameState.ball.Anchored=false
            local dx=0; if sd=="Left" then dx=-0.35 elseif sd=="Right" then dx=0.35 end
            local dy=(sd=="Over") and 0.6 or 0.15
            local pw=(sd=="Over") and 130 or 200
            applyKnuckleball(gameState.ball,Vector3.new(dx,dy,sign).Unit,pw)
        end
        task.wait(1.4)
        local scored=false
        if sd~="Over" and sd~=gd then scored=true; playNetSound() end
        if team=="Red" then rsC=rsC+1; setPenaltyBall("Red",rsC,scored) else bsC=bsC+1; setPenaltyBall("Blue",bsC,scored) end
        if gameState.ball then
            gameState.ball.Anchored=true; gameState.ball.CFrame=CFrame.new(bp)
            gameState.ball.AssemblyLinearVelocity=Vector3.zero; gameState.ball.AssemblyAngularVelocity=Vector3.zero
        end
        if sh.isPlayer then
            local hrp=sh.char:FindFirstChild("HumanoidRootPart")
            if hrp then hrp.CFrame=CFrame.new(MAP_POS+Vector3.new(0,5,0)) end
        elseif sh.bot.PrimaryPart then
            local a=math.random()*math.pi*2; local p=MAP_POS+Vector3.new(math.cos(a)*25,TORSO_Y-MAP_POS.Y,math.sin(a)*25)
            pcall(moveCharacter, sh.bot, p, Vector3.new(MAP_POS.X,p.Y,MAP_POS.Z))
        end
        return scored
    end
    for r=1,mr do
        if ts("Red",r) then rs=rs+1 end
        task.wait(1.3)
        if ts("Blue",r) then bs=bs+1 end
        task.wait(1.3)
        if rs>bs+(mr-r) then break end
        if bs>rs+(mr-r) then break end
    end
    local sd=0
    while rs==bs do
        sd=sd+1
        if ts("Red","SD"..sd) then rs=rs+1 end
        if ts("Blue","SD"..sd) then bs=bs+1 end
        task.wait(1.3)
    end
    gameState.inPenaltyShootout=false
    gameState.scoreRed=rs; gameState.scoreBlue=bs
    local winner=(rs>bs) and "Red" or "Blue"
    local ok, err = pcall(startCelebration, winner)
    if not ok then warn("[Penalty] startCelebration error: "..tostring(err)) end
    task.wait(12)
    clearPenaltyUI()
    gameState.paused=true; gameState.gameActive=false
    gameState.currentHalf=1; gameState.timeLeft=HALF_TIME
    gameState.scoreRed=0; gameState.scoreBlue=0; gameState.isExtraTime=false
    gameState.lastTouchTeam=nil; gameState.goalScored=false
    gameState.gkHoldCooldowns={}; gameState.passCooldowns={}
    gameState.playerDribbling=false; gameState.aiDribbleState={}
    gameState.stoppageTimeActive=false; gameState.paused=false
    resetPositions("Red")
    task.delay(0.3,function()
        local pc=gameState.playerChar
        if pc then
            local hrp=pc:FindFirstChild("HumanoidRootPart"); local hum=pc:FindFirstChildOfClass("Humanoid")
            if hrp then local zo=(gameState.playerTeam=="Red") and -150 or 150; hrp.CFrame=CFrame.new(MAP_POS+Vector3.new(0,15,zo)); hrp.AssemblyLinearVelocity=Vector3.zero end
            if workspace.CurrentCamera and hum then workspace.CurrentCamera.CameraType=Enum.CameraType.Custom; workspace.CurrentCamera.CameraSubject=hum end
        end
    end)
    gameState.gameActive=true
    advanceTournament()
end

local function startCelebration(winningTeam)
    gameState.celebrating = true
    pcall(playFinalWhistle)
    task.wait(2.5)
    if gameState.celebrationConn then
        pcall(function() gameState.celebrationConn:Disconnect() end)
    end
    local cp = MAP_POS + Vector3.new(0, 5, 0)
    local w = (winningTeam == "Red") and gameState.redTeam or gameState.blueTeam
    local tp = {}
    for i, bot in ipairs(w) do
        local a = (i / #w) * math.pi * 2
        tp[bot] = Vector3.new(cp.X + math.cos(a)*6, TORSO_Y, cp.Z + math.sin(a)*6)
    end
    local cst = tick()
    gameState.celebrationConn = RunService.Heartbeat:Connect(function()
        local el = tick() - cst
        if el > 10 or not gameState.celebrating then
            if gameState.celebrationConn then
                pcall(function() gameState.celebrationConn:Disconnect() end)
            end
            return
        end
        for bot, target in pairs(tp) do
            if bot.PrimaryPart then
                local cu = bot.PrimaryPart.Position
                local d = target - cu
                local dst = Vector3.new(d.X, 0, d.Z).Magnitude
                if dst > 2 then
                    local np = cu + Vector3.new(d.X, 0, d.Z).Unit * 25 * 0.03
                    pcall(moveCharacter, bot, np, Vector3.new(cp.X, np.Y, cp.Z))
                else
                    local jo = math.abs(math.sin(el*5)) * 4
                    pcall(moveCharacter, bot, Vector3.new(target.X, TORSO_Y+jo, target.Z), Vector3.new(cp.X, TORSO_Y+jo, cp.Z))
                end
            end
        end
    end)
    task.spawn(function()
        local t0 = tick()
        while tick() - t0 < 10 do task.wait(0.5) end
        gameState.celebrating = false
        if gameState.celebrationConn then
            pcall(function() gameState.celebrationConn:Disconnect() end)
            gameState.celebrationConn = nil
        end
    end)
end

local function endMatch()
    gameState.paused = true
    gameState.gameActive = false
    if gameState.ball then gameState.ball.Anchored = true end
    pcall(playFinalWhistle)
    local winner = nil
    if gameState.scoreRed > gameState.scoreBlue then winner = "Red"
    elseif gameState.scoreBlue > gameState.scoreRed then winner = "Blue" end
    local wasFinal = isFinalStage()
    if winner then
        task.wait(2)
        if gameState.ball then gameState.ball.Anchored = false end
        if wasFinal then
            local ok, err = pcall(startTrophyCeremony, winner)
            if not ok then warn("[endMatch] TrophyCeremony error: "..tostring(err)) end
        else
            local ok, err = pcall(startCelebration, winner)
            if not ok then warn("[endMatch] Celebration error: "..tostring(err)) end
            task.wait(12)
        end
    end
    gameState.restartCountdown = FULL_BREAK
    while gameState.restartCountdown > 0 do
        task.wait(1)
        gameState.restartCountdown = gameState.restartCountdown - 1
    end
    gameState.currentHalf = 1
    gameState.timeLeft = HALF_TIME
    gameState.scoreRed = 0
    gameState.scoreBlue = 0
    gameState.isExtraTime = false
    gameState.lastTouchTeam = nil
    gameState.goalScored = false
    gameState.gkHoldCooldowns = {}
    gameState.passCooldowns = {}
    gameState.playerDribbling = false
    gameState.aiDribbleState = {}
    gameState.stoppageTimeActive = false
    gameState.paused = false
    gameState.celebrating = false
    gameState.trophyActive = false
    gameState.goalCelebrationActive = false
    gameState.gkHolding = false
    gameState.gkHoldingTeam = nil
    gameState.playerSkillActive = false
    gameState.superSkillActive = false
    if gameState.celebrationConn then
        pcall(function() gameState.celebrationConn:Disconnect() end)
        gameState.celebrationConn = nil
    end
    if gameState.ball then gameState.ball.Anchored = false end
    resetPositions("Red")
    task.delay(0.3, function()
        local pc = gameState.playerChar
        if pc then
            local hrp = pc:FindFirstChild("HumanoidRootPart")
            local hum = pc:FindFirstChildOfClass("Humanoid")
            if hrp then
                local zo = (gameState.playerTeam == "Red") and -150 or 150
                hrp.CFrame = CFrame.new(MAP_POS + Vector3.new(0, 15, zo))
                hrp.AssemblyLinearVelocity = Vector3.zero
            end
            if workspace.CurrentCamera and hum then
                workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
                workspace.CurrentCamera.CameraSubject = hum
            end
        end
    end)
    gameState.gameActive = true
    advanceTournament()
    print("[endMatch] Match ended and reset successfully!")
end

local function onGoalScored(scoringTeam)
    if gameState.goalScored or gameState.inPenaltyShootout or gameState.celebrating then return end
    gameState.goalScored=true; playNetSound()
    if scoringTeam=="Red" then gameState.scoreRed=gameState.scoreRed+1 else gameState.scoreBlue=gameState.scoreBlue+1 end
    showGoalText()
    local gz=(scoringTeam=="Red") and (MAP_POS.Z+PITCH_LENGTH/2) or (MAP_POS.Z-PITCH_LENGTH/2)
    createFireworks(Vector3.new(MAP_POS.X,MAP_POS.Y+30,gz))
    updateTournamentDisplay()
    task.wait(2.5)
    hideGoalText()
    local sc=gameState.lastScorer; local st=gameState.lastScorerTeam
    if st==scoringTeam and sc then startGoalCelebration(sc,scoringTeam)
    else startGoalCelebration(nil,scoringTeam) end
    resetPositions((scoringTeam=="Red") and "Blue" or "Red")
    gameState.lastTouchTeam=nil; gameState.lastScorer=nil; gameState.lastScorerTeam=nil
    gameState.goalScored=false
end

local function checkRules()
    local ball=gameState.ball
    if not ball or not ball.Parent or gameState.restartCooldown or not gameState.gameActive or gameState.goalScored then return end
    if gameState.inPenaltyShootout or gameState.celebrating or gameState.paused or gameState.restartCountdown>0 then return end
    local bp=ball.Position
    if math.abs(bp.Z-MAP_POS.Z)>PITCH_LENGTH/2+3 then
        local ww=math.abs(bp.X-MAP_POS.X)<GOAL_WIDTH/2
        local ub=(bp.Y-MAP_POS.Y)<(GOAL_HEIGHT+2) and (bp.Y-MAP_POS.Y)>-5
        local isF=bp.Z<MAP_POS.Z-PITCH_LENGTH/2
        local isB=bp.Z>MAP_POS.Z+PITCH_LENGTH/2
        if ww and ub and (isF or isB) then
            if isB then task.spawn(onGoalScored,"Red") else task.spawn(onGoalScored,"Blue") end
        end
    end
end

local function startTimer()
    task.spawn(function()
        while true do
            task.wait(1)
            if gameState.gameActive and not gameState.paused and not gameState.gkHolding
               and not gameState.goalScored and not gameState.inPenaltyShootout and not gameState.celebrating
               and not gameState.goalCelebrationActive and not gameState.trophyActive then
                gameState.timeLeft = gameState.timeLeft - 1
                if gameState.timeLeft <= 0 then
                    if gameState.isExtraTime then
                        playFinalWhistle()
                        if gameState.scoreRed == gameState.scoreBlue then
                            task.wait(3)
                            local ok, err = pcall(runPenaltyShootout)
                            if not ok then warn("[Timer] PenaltyShootout error: "..tostring(err)) end
                        else
                            local ok, err = pcall(endMatch)
                            if not ok then warn("[Timer] endMatch error: "..tostring(err)) end
                        end
                    elseif gameState.currentHalf < gameState.maxHalves then
                        gameState.paused = true
                        gameState.gameActive = false
                        playWhistle()
                        task.wait(3)
                        gameState.restartCountdown = HALF_BREAK
                        while gameState.restartCountdown > 0 do
                            task.wait(1)
                            gameState.restartCountdown = gameState.restartCountdown - 1
                        end
                        gameState.currentHalf = gameState.currentHalf + 1
                        gameState.timeLeft = HALF_TIME
                        gameState.playerDribbling = false
                        gameState.stoppageTimeActive = false
                        resetPositions("Red")
                        gameState.paused = false
                        gameState.gameActive = true
                    else
                        gameState.paused = true
                        gameState.gameActive = false
                        if gameState.scoreRed == gameState.scoreBlue then
                            playWhistle()
                            task.wait(3)
                            gameState.restartCountdown = HALF_BREAK
                            while gameState.restartCountdown > 0 do
                                task.wait(1)
                                gameState.restartCountdown = gameState.restartCountdown - 1
                            end
                            gameState.isExtraTime = true
                            gameState.timeLeft = EXTRA_TIME
                            gameState.playerDribbling = false
                            gameState.stoppageTimeActive = false
                            resetPositions("Red")
                            gameState.paused = false
                            gameState.gameActive = true
                        else
                            local ok, err = pcall(endMatch)
                            if not ok then
                                warn("[Timer] endMatch error: "..tostring(err))
                                gameState.paused = false
                                gameState.gameActive = true
                                gameState.currentHalf = 1
                                gameState.timeLeft = HALF_TIME
                                gameState.scoreRed = 0
                                gameState.scoreBlue = 0
                                gameState.isExtraTime = false
                                gameState.stoppageTimeActive = false
                                gameState.celebrating = false
                                gameState.trophyActive = false
                                gameState.restartCountdown = 0
                                gameState.goalScored = false
                                gameState.inPenaltyShootout = false
                                gameState.goalCelebrationActive = false
                                resetPositions("Red")
                            end
                        end
                    end
                end
            end
        end
    end)
end

local function skipMatch()
    if not gameState.gameActive or gameState.inPenaltyShootout or gameState.celebrating then return end
    if gameState.paused or gameState.restartCountdown > 0 then return end
    gameState.timeLeft = STOPPAGE_TIME
    gameState.stoppageTimeActive = true
end


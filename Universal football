                            end)
                        else
                            local totalRed = gameState.scoreRed
                            local totalBlue = gameState.scoreBlue
                            if gameState.twoLeggedEnabled and gameState.currentLeg == 2 then
                                totalRed = totalRed + gameState.firstLegScoreRed
                                totalBlue = totalBlue + gameState.firstLegScoreBlue
                            end
                            
                            if gameState.twoLeggedEnabled and gameState.currentLeg == 1 then
                                task.spawn(function()
                                    local ok, err = pcall(endMatch)
                                    if not ok then warn("[Timer] endMatch error: "..tostring(err)) end

                goalkeeperPassBall(gk,ball,team)
                gameState.gkHolding=false; gameState.gkHoldingTeam=nil
            end)
        elseif sP then
            local pd=Vector3.new(bp.X-gp.X,0,bp.Z-gp.Z)
            if pd.Magnitude<1 then pd=Vector3.new(0,0,1) end; pd=pd.Unit
            local pp=math.clamp(bSpeed*0.6,100,220)

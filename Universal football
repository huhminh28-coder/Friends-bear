local function doDribble()
    if gameState.inPenaltyShootout or gameState.celebrating then return end
    local char=gameState.playerChar; if not char then return end
    local hrp=char:FindFirstChild("HumanoidRootPart"); local ball=gameState.ball
    if not hrp or not ball or not ball.Parent or (hrp.Position-ball.Position).Magnitude>20 then return end
    if gameState.playerSkillActive then gameState.playerSkillActive=false end
    -- Snap bóng vào chân + zero vận tốc ngay
    local fp = hrp.Position + hrp.CFrame.LookVector * 4
    ball.CFrame = CFrame.new(fp.X, fp.Y - 1.5, fp.Z)
    ball.AssemblyLinearVelocity = Vector3.zero
    ball.AssemblyAngularVelocity = Vector3.zero
    ball.CanCollide = true
    gameState.playerDribbling = true
    gameState.lastTouchTeam = gameState.playerTeam
    gameState.lastScorer = "player"
    gameState.lastScorerTeam = gameState.playerTeam
    playBallTouchSound()
end


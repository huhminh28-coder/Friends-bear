local function getCurrentStage()
    local t = TOURNAMENTS[gameState.tournamentType]; if not t then return "GROUP STAGE",5 end
    local idx = math.clamp(gameState.currentStageIndex,1,#t.stages); return t.stages[idx],t.matchesPerStage[idx]
end
local function isFinalStage()
    local t = TOURNAMENTS[gameState.tournamentType]; if not t then return false end
    return gameState.currentStageIndex >= #t.stages
end

local function updateTournamentDisplay()
    if not gameState.tournamentLbl then return end
    local s,tm = getCurrentStage()
    gameState.tournamentLbl.Text = gameState.tournamentType
    gameState.stageLbl.Text = s
    local legText = ""
    if s ~= "GROUP STAGE" and gameState.twoLeggedEnabled then
        legText = " (LEG " .. gameState.currentLeg .. ")"
    end
    gameState.matchLbl.Text = "MATCH "..gameState.currentMatchInStage.."/"..tm..legText
    
    local dispRed = gameState.scoreRed
    local dispBlue = gameState.scoreBlue
    
    if s ~= "GROUP STAGE" and gameState.twoLeggedEnabled and gameState.currentLeg == 2 then
        local aggRed = dispRed + gameState.firstLegScoreRed
        local aggBlue = dispBlue + gameState.firstLegScoreBlue
        gameState.scoreLbl.Text = gameState.teamRedName.." "..dispRed.." - "..dispBlue.." "..gameState.teamBlueName.." (Agg: "..aggRed.."-"..aggBlue..")"
    else
        gameState.scoreLbl.Text = gameState.teamRedName.." "..dispRed.." - "..dispBlue.." "..gameState.teamBlueName
    end
end

local function advanceTournament()
    local t = TOURNAMENTS[gameState.tournamentType]; if not t then return end
    local isGroup = (getCurrentStage() == "GROUP STAGE")
    if not isGroup and gameState.twoLeggedEnabled and gameState.currentLeg == 1 then
        updateTournamentDisplay()
        return
    end

    gameState.currentLeg = 1
    gameState.firstLegScoreRed = 0
    gameState.firstLegScoreBlue = 0

    gameState.currentMatchInStage = gameState.currentMatchInStage + 1
    local totalMatches = t.matchesPerStage[gameState.currentStageIndex] or 1
    if gameState.currentMatchInStage > totalMatches then
        gameState.currentStageIndex = gameState.currentStageIndex + 1
        gameState.currentMatchInStage = 1
        if gameState.currentStageIndex > #t.stages then gameState.currentStageIndex = 1; gameState.currentMatchInStage = 1 end
    end
    updateTournamentDisplay()
end


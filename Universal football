local function updatePlayerDribble(dt)
    if gameState.inPenaltyShootout or gameState.celebrating or gameState.superSkillActive then 
        gameState.playerDribbling=false; return 
    end
    if not gameState.playerDribbling then return end
    local char=gameState.playerChar; if not char then gameState.playerDribbling=false return end
    local hrp=char:FindFirstChild("HumanoidRootPart"); local ball=gameState.ball

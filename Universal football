local function skipMatch()
    if not gameState.gameActive or gameState.inPenaltyShootout or gameState.celebrating then return end
    if gameState.paused or gameState.restartCountdown > 0 then return end
    gameState.timeLeft = STOPPAGE_TIME
    gameState.stoppageTimeActive = true
end

local function setPracticeMode(enabled)
    gameState.practiceModeEnabled = enabled
    
    local function toggleBots(teamList)
        for _, bot in ipairs(teamList) do
            if bot.Role.Value ~= "Goalkeeper" then
                if enabled then
                    pcall(moveCharacter, bot, Vector3.new(0, -500, 0), Vector3.new(0, -500, 1))
                    for _, p in ipairs(bot:GetChildren()) do
                        if p:IsA("BasePart") then p.Transparency = 1 end
                    end
                else
                    for _, p in ipairs(bot:GetChildren()) do
                        if p:IsA("BasePart") then p.Transparency = 0 end
                    end
                end
            end
        end
    end
    toggleBots(gameState.redTeam)
    toggleBots(gameState.blueTeam)
    
    if gameState.hudFrame then gameState.hudFrame.Visible = not enabled end
    
    if gameState.ball then
        gameState.ball.CFrame = CFrame.new(MAP_POS + Vector3.new(0, 5, 0))
        gameState.ball.AssemblyLinearVelocity = Vector3.zero
        gameState.ball.AssemblyAngularVelocity = Vector3.zero
    end
    
    if not enabled then
        resetPositions(nil)
    end
end


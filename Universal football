local function moveCharacter(bot, newTorsoPos, lookTarget)
    local dir = lookTarget - newTorsoPos
    local horizDir = Vector3.new(dir.X,0,dir.Z)
    if horizDir.Magnitude < 0.1 then horizDir = Vector3.new(0,0,1) end
    horizDir = horizDir.Unit
    local yaw = math.atan2(-horizDir.X, -horizDir.Z)
    local baseCFrame = CFrame.new(newTorsoPos) * CFrame.Angles(0,yaw,0)
    for _,part in ipairs(bot:GetChildren()) do if part:IsA("BasePart") then
        local ox=part:GetAttribute("OffX") or 0; local oy=part:GetAttribute("OffY") or 0; local oz=part:GetAttribute("OffZ") or 0
        part.CFrame = baseCFrame * CFrame.new(ox,oy,oz)
    end end
end

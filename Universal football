-- MODIFIED: Throw-in with players spread away from thrower
local function setupThrowIn(team, sideX)
    local teamList = (team == "Red") and gameState.redTeam or gameState.blueTeam
    local oppList = (team == "Red") and gameState.blueTeam or gameState.redTeam
    local thrower = nil
    for _, bot in ipairs(teamList) do
        if bot.Role.Value == "Defender" and bot.PrimaryPart then thrower = bot; break end
    end
    if not thrower then thrower = teamList[2] end
    local ballZ = gameState.ball and gameState.ball.Position.Z or MAP_POS.Z
    ballZ = math.clamp(ballZ, MAP_POS.Z - PITCH_LENGTH/2 + 20, MAP_POS.Z + PITCH_LENGTH/2 - 20)
    local throwPos = Vector3.new(sideX, TORSO_Y, ballZ)
    if thrower and thrower.PrimaryPart then
        moveCharacter(thrower, throwPos, Vector3.new(MAP_POS.X, throwPos.Y, ballZ))
    end
    -- Direction teammates should spread (towards pitch center)
    local inwardDir = (sideX > MAP_POS.X) and -1 or 1
    -- Teammates spread away at different distances and angles
    local spreadSlots = {
        {dist = 35, offsetZ = -50},
        {dist = 55, offsetZ = -20},
        {dist = 60, offsetZ = 25},
        {dist = 40, offsetZ = 55},
        {dist = 80, offsetZ = 0},
        {dist = 90, offsetZ = -40},
        {dist = 90, offsetZ = 40},
    }
    local tIdx = 1
    for _, bot in ipairs(teamList) do
        if bot ~= thrower and bot.Role.Value ~= "Goalkeeper" and bot.PrimaryPart and tIdx <= #spreadSlots then
            local slot = spreadSlots[tIdx]
            local pos = Vector3.new(sideX + inwardDir * slot.dist, TORSO_Y, ballZ + slot.offsetZ)
            pos = Vector3.new(
                math.clamp(pos.X, MAP_POS.X - PITCH_WIDTH/2 + 10, MAP_POS.X + PITCH_WIDTH/2 - 10),
                TORSO_Y,
                math.clamp(pos.Z, MAP_POS.Z - PITCH_LENGTH/2 + 10, MAP_POS.Z + PITCH_LENGTH/2 - 10)
            )
            moveCharacter(bot, pos, Vector3.new(sideX, pos.Y, ballZ))
            tIdx = tIdx + 1
        end
    end
    -- Opponents must retreat at least 20 studs from thrower
    local oIdx = 1
    for _, bot in ipairs(oppList) do
        if bot.Role.Value ~= "Goalkeeper" and bot.PrimaryPart then
            local dist = 25 + math.random(0, 15)
            local angle = math.random() * math.pi * 2
            local pos = Vector3.new(sideX + inwardDir * dist, TORSO_Y, ballZ + math.sin(angle) * 25)
            pos = Vector3.new(
                math.clamp(pos.X, MAP_POS.X - PITCH_WIDTH/2 + 10, MAP_POS.X + PITCH_WIDTH/2 - 10),
                TORSO_Y,
                math.clamp(pos.Z, MAP_POS.Z - PITCH_LENGTH/2 + 10, MAP_POS.Z + PITCH_LENGTH/2 - 10)
            )
            moveCharacter(bot, pos, Vector3.new(sideX, pos.Y, ballZ))
            oIdx = oIdx + 1
        end
    end
    if gameState.ball then
        gameState.ball.CFrame = CFrame.new(sideX, MAP_POS.Y + 5, ballZ)
        gameState.ball.AssemblyLinearVelocity = Vector3.zero
        gameState.ball.AssemblyAngularVelocity = Vector3.zero
    end
    gameState.throwInActive = true
    gameState.setPieceTeam = team
    showBigText("THROW-IN", Color3.fromRGB(150,220,255))
    task.wait(1.2)
    hideBigText()
    task.delay(1.5, function()
        if not gameState.throwInActive then return end
        if thrower and thrower.PrimaryPart and gameState.ball then
            -- Find nearest teammate that moved away
            local chosen = nil
            local bestD = math.huge
            for _, bot in ipairs(teamList) do
                if bot ~= thrower and bot.Role.Value ~= "Goalkeeper" and bot.PrimaryPart then
                    local d = (bot.PrimaryPart.Position - throwPos).Magnitude
                    if d < bestD then bestD = d; chosen = bot end
                end
            end
            if chosen and chosen.PrimaryPart and math.random() < 0.6 then
                applyLobPass(gameState.ball, chosen.PrimaryPart.Position, 20)
            else
                local forwardDir = inwardDir
                gameState.ball.AssemblyLinearVelocity = Vector3.new(forwardDir * 90, 50, (math.random()-0.5) * 40)
            end
            playBallKick(gameState.ball.Position, 0.9)
        end
        gameState.throwInActive = false
    end)
end

local function aiAvoidOpponent(bot)
    local ball = gameState.ball
    if not ball or not bot.PrimaryPart then return false end
    local botPos = bot.PrimaryPart.Position
    local team = bot.Team.Value
    local attackDir = Vector3.new(0, 0, (team == "Red") and 1 or -1)
    local oppList = (team == "Red") and gameState.blueTeam or gameState.redTeam
    local nearestOpp = nil
    local nearestDist = math.huge
    local forwardDir = Vector3.new(0, 0, (team == "Red") and 1 or -1)
    for _, opp in ipairs(oppList) do
        if opp.PrimaryPart and opp.Role.Value ~= "Goalkeeper" then
            local oppPos = opp.PrimaryPart.Position
            local toOpp = oppPos - botPos
            local dist = toOpp.Magnitude
            local dot = toOpp.Unit:Dot(forwardDir)
            if dot > 0.4 and dist < 25 and dist < nearestDist then
                nearestDist = dist; nearestOpp = opp
            end
        end
    end
    if not nearestOpp then return false end
    local action = math.random(1, 3)
    if action == 1 then
        local sideDir = (math.random(1,2) == 1) and 1 or -1
        local perp = Vector3.new(forwardDir.Z * sideDir, 0, -forwardDir.X * sideDir)
        ball.CFrame = CFrame.new(botPos + perp*4 + forwardDir*2)
        ball.AssemblyLinearVelocity = perp * 60 + forwardDir * 20 + Vector3.new(0, 8, 0)
        return true
    elseif action == 2 then
        local bestTarget, _ = findBestPassTarget(bot)
        if bestTarget and bestTarget.PrimaryPart then
            applyLobPass(ball, bestTarget.PrimaryPart.Position, 20)
            return true
        end
    else
        local bestTarget, _ = findBestPassTarget(bot)
        if bestTarget and bestTarget.PrimaryPart then
            applyGroundPass(ball, bestTarget.PrimaryPart.Position, 20)
            return true
        end
    end
    return false
end


local function resetPositions(concedingTeam)
    if gameState.ball then gameState.ball.Anchored = false end
    gameState.playerDribbling = false
    gameState.gkHolding = false
    gameState.gkHoldingTeam = nil
    gameState.playerSkillActive = false
    gameState.aiSkillActive = {}
    for _, bot in ipairs(gameState.redTeam) do
        if bot.PrimaryPart then
            local p = getHomePos(bot, false)
            moveCharacter(bot, p, p+Vector3.new(0,0,1))
        end
    end
    for _, bot in ipairs(gameState.blueTeam) do
        if bot.PrimaryPart then
            local p = getHomePos(bot, false)
            moveCharacter(bot, p, p+Vector3.new(0,0,-1))
        end
    end
    if gameState.ball then
        gameState.ball.CFrame = CFrame.new(MAP_POS+Vector3.new(0,5,0))
        gameState.ball.AssemblyLinearVelocity = Vector3.zero
        gameState.ball.AssemblyAngularVelocity = Vector3.zero
    end
    gameState.ballIsCurving = false
    gameState.passCooldowns = {}
    gameState.aiDribbleState = {}
    local pc = gameState.playerChar
    if pc and pc:FindFirstChild("HumanoidRootPart") then
        local zOffset = (gameState.playerTeam == "Red") and -150 or 150
        pc:PivotTo(CFrame.new(MAP_POS+Vector3.new(0,10,zOffset)))
        updatePlayerAppearance()
    end
    if concedingTeam then
        local kickoffTeam = (concedingTeam == "Red") and gameState.redTeam or gameState.blueTeam
        for _, bot in ipairs(kickoffTeam) do
            if bot.Role.Value == "Striker" and bot.PrimaryPart then
                local dir = (concedingTeam == "Red") and 1 or -1
                local offset = (bot:GetAttribute("FormationIndex") == 1) and Vector3.new(-5,0,5*dir) or Vector3.new(5,0,5*dir)
                local pos = MAP_POS + Vector3.new(offset.X, TORSO_Y-MAP_POS.Y, offset.Z)
                moveCharacter(bot, pos, pos+Vector3.new(0,0,dir))
            end
        end
    end
end

local function startCelebration(winningTeam)
    gameState.celebrating = true
    playFinalWhistle()
    task.wait(2.5)
    local centerPos = MAP_POS + Vector3.new(0, 5, 0)
    local winners = (winningTeam == "Red") and gameState.redTeam or gameState.blueTeam
    local targetPositions = {}
    for i, bot in ipairs(winners) do
        local angle = (i/#winners)*math.pi*2
        targetPositions[bot] = Vector3.new(centerPos.X+math.cos(angle)*6, TORSO_Y, centerPos.Z+math.sin(angle)*6)
    end
    local pc = gameState.playerChar
    local pcIsWinner = (gameState.playerTeam == winningTeam)
    local celebrateStart = tick()
    if gameState.celebrationConn then gameState.celebrationConn:Disconnect() end
    gameState.celebrationConn = RunService.Heartbeat:Connect(function()
        local elapsed = tick()-celebrateStart
        if elapsed > 10 or not gameState.celebrating then
            if gameState.celebrationConn then gameState.celebrationConn:Disconnect() end
            return
        end
        for bot, target in pairs(targetPositions) do
            if bot.PrimaryPart then
                local current = bot.PrimaryPart.Position
                local dir = target-current
                local dist = Vector3.new(dir.X, 0, dir.Z).Magnitude
                if dist > 2 then
                    local newPos = current + Vector3.new(dir.X, 0, dir.Z).Unit*25*0.03
                    moveCharacter(bot, newPos, Vector3.new(centerPos.X, newPos.Y, centerPos.Z))
                else
                    local jumpOffset = math.abs(math.sin(elapsed*5))*4
                    moveCharacter(bot, Vector3.new(target.X, TORSO_Y+jumpOffset, target.Z), Vector3.new(centerPos.X, TORSO_Y+jumpOffset, centerPos.Z))
                end
            end
        end
        if pcIsWinner and pc then
            local hrp = pc:FindFirstChild("HumanoidRootPart")
            if hrp then
                local current = hrp.Position
                local dir = centerPos-current
                if Vector3.new(dir.X, 0, dir.Z).Magnitude > 6 then
                    local newPos = current + Vector3.new(dir.X, 0, dir.Z).Unit*20*0.05
                    hrp.CFrame = CFrame.new(newPos.X, math.max(hrp.Position.Y, MAP_POS.Y+5), newPos.Z)
                    hrp.AssemblyLinearVelocity = Vector3.new(dir.X, 0, dir.Z).Unit*20
                end
            end
        end
    end)
    task.delay(10, function()
        gameState.celebrating = false
        if gameState.celebrationConn then gameState.celebrationConn:Disconnect() end
    end)
end


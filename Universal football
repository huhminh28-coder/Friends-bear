local function onGoalScored(scoringTeam)
    if gameState.goalScored or gameState.inPenaltyShootout or gameState.celebrating or gameState.practiceModeEnabled then return end
    gameState.goalScored=true; playNetSound()
    if scoringTeam=="Red" then gameState.scoreRed=gameState.scoreRed+1 else gameState.scoreBlue=gameState.scoreBlue+1 end
    updatePlayerAchievement(scoringTeam)
    showGoalText()
    local gz=(scoringTeam=="Red") and (MAP_POS.Z+PITCH_LENGTH/2) or (MAP_POS.Z-PITCH_LENGTH/2)
    createFireworks(Vector3.new(MAP_POS.X,MAP_POS.Y+30,gz))
    updateTournamentDisplay()
    task.wait(2.5)
    hideGoalText()
    local sc=gameState.lastScorer; local st=gameState.lastScorerTeam
    if st==scoringTeam and sc then startGoalCelebration(sc,scoringTeam)
    else startGoalCelebration(nil,scoringTeam) end
    resetPositions((scoringTeam=="Red") and "Blue" or "Red")
    gameState.lastTouchTeam=nil; gameState.lastScorer=nil; gameState.lastScorerTeam=nil
    gameState.goalScored=false
end

local function checkRules()
    local ball=gameState.ball
    if not ball or not ball.Parent or gameState.restartCooldown or not gameState.gameActive or gameState.goalScored then return end
    if gameState.inPenaltyShootout or gameState.celebrating or gameState.paused or gameState.restartCountdown>0 then return end
    local bp=ball.Position
    if math.abs(bp.Z-MAP_POS.Z)>PITCH_LENGTH/2+3 then
        local ww=math.abs(bp.X-MAP_POS.X)<GOAL_WIDTH/2
        local ub=(bp.Y-MAP_POS.Y)<(GOAL_HEIGHT+2) and (bp.Y-MAP_POS.Y)>-5
        local isF=bp.Z<MAP_POS.Z-PITCH_LENGTH/2
        local isB=bp.Z>MAP_POS.Z+PITCH_LENGTH/2
        if ww and ub and (isF or isB) then
            if isB then task.spawn(onGoalScored,"Red") else task.spawn(onGoalScored,"Blue") end
        end
    end
end

local function startTimer()
    task.spawn(function()
        while true do
            task.wait(1)
            if gameState.gameActive and not gameState.paused and not gameState.gkHolding
               and not gameState.goalScored and not gameState.inPenaltyShootout and not gameState.celebrating
               and not gameState.goalCelebrationActive and not gameState.trophyActive and not gameState.practiceModeEnabled then
                
                gameState.timeLeft = gameState.timeLeft - 1
                
                if gameState.timeLeft <= 0 then
                    playFinalWhistle()
                    gameState.paused = true
                    gameState.gameActive = false
                    gameState.playerDribbling = false
                    
                    if gameState.currentHalf == 1 and not gameState.isExtraTime then
                        task.spawn(function()
                            gameState.restartCountdown = HALF_BREAK
                            while gameState.restartCountdown > 0 do
                                task.wait(1)
                                gameState.restartCountdown = gameState.restartCountdown - 1
                            end
                            gameState.currentHalf = 2
                            gameState.timeLeft = HALF_TIME
                            gameState.stoppageTimeActive = false
                            resetPositions("Red")
                            gameState.paused = false
                            gameState.gameActive = true

local function getPlayerAchievement(count)
    if count == 1 then return "" end
    if count == 2 then return "BRACE" end
    if count == 3 then return "HAT-TRICK" end
    if count == 4 then return "POKER" end
    if count == 5 then return "RE-POKER" end
    if count == 6 then return "DOUBLE HAT-TRICK" end
    if count == 7 then return "HAUL-HAT-TRICK" end
    if count == 8 then return "SNOWBALL" end
    if count >= 9 then return "TRIPLE HAT-TRICK [MAX]" end
    return ""
end

local function updatePlayerAchievement(scoringTeam)
    if scoringTeam ~= gameState.playerTeam then return end
    if gameState.lastScorer ~= "player" then return end
    gameState.playerGoalCount = gameState.playerGoalCount + 1
    local ach = getPlayerAchievement(gameState.playerGoalCount)
    if ach == "" then return end
    local lbl = gameState.playerGoalLabel
    if not lbl then return end
    lbl.Text = "⭐ " .. ach .. " ⭐"
    lbl.Visible = true
    task.spawn(function()
        for i = 1, 8 do
            if not lbl or not lbl.Parent then break end
            lbl.TextColor3 = Color3.fromRGB(255, 255, 0)
            task.wait(0.15)
            if not lbl or not lbl.Parent then break end
            lbl.TextColor3 = Color3.fromRGB(255, 80, 0)
            task.wait(0.15)
        end
        if lbl and lbl.Parent then lbl.TextColor3 = Color3.fromRGB(255, 215, 0) end
    end)
end

local function resetPlayerAchievement()
    gameState.playerGoalCount = 0
    if gameState.playerGoalLabel then
        gameState.playerGoalLabel.Visible = false
        gameState.playerGoalLabel.Text = ""

local function startCelebration(winningTeam)
    gameState.celebrating = true
    pcall(playFinalWhistle)
    playSoundOnce("rbxassetid://132079977802654", 5, 6)
    task.wait(2.5)
    if gameState.celebrationConn then
        pcall(function() gameState.celebrationConn:Disconnect() end)
    end
    local cp = MAP_POS + Vector3.new(0, 5, 0)
    local w = (winningTeam == "Red") and gameState.redTeam or gameState.blueTeam
    local tp = {}
    for i, bot in ipairs(w) do
        local a = (i / #w) * math.pi * 2
        tp[bot] = Vector3.new(cp.X + math.cos(a)*6, TORSO_Y, cp.Z + math.sin(a)*6)
    end
    local cst = tick()
    gameState.celebrationConn = RunService.Heartbeat:Connect(function()
        local el = tick() - cst
        if el > 10 or not gameState.celebrating then
            if gameState.celebrationConn then
                pcall(function() gameState.celebrationConn:Disconnect() end)
            end
            return
        end
        for bot, target in pairs(tp) do
            if bot.PrimaryPart then
                local cu = bot.PrimaryPart.Position
                local d = target - cu
                local dst = Vector3.new(d.X, 0, d.Z).Magnitude
                if dst > 2 then
                    local np = cu + Vector3.new(d.X, 0, d.Z).Unit * 25 * 0.03
                    pcall(moveCharacter, bot, np, Vector3.new(cp.X, np.Y, cp.Z))
                else
                    local jo = math.abs(math.sin(el*5)) * 4
                    pcall(moveCharacter, bot, Vector3.new(target.X, TORSO_Y+jo, target.Z), Vector3.new(cp.X, TORSO_Y+jo, cp.Z))
                end
            end
        end
    end)
    task.spawn(function()
        local t0 = tick()
        while tick() - t0 < 10 do task.wait(0.5) end
        gameState.celebrating = false
        if gameState.celebrationConn then
            pcall(function() gameState.celebrationConn:Disconnect() end)
            gameState.celebrationConn = nil
        end
    end)
end


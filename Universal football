    createAIPlayer("Blue","Midfielder",4)
    createAIPlayer("Blue","Striker",1)
    createAIPlayer("Blue","Striker",2)
    resetPositions("Red")
    gameState.gameActive=true
    createGameUI()
    createSettingsUI()
    buildPenaltyUI()
    hidePenaltyUI()
    startTimer()
    
    gameState.playerPushConn = RunService.Heartbeat:Connect(function(dt)
        if gameState.playerCard ~= "red" and not gameState.playerSuspended then return end
        local char2 = gameState.playerChar
        if not char2 then return end
        local hrp = char2:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local distX = math.abs(hrp.Position.X - MAP_POS.X)
        local distZ = math.abs(hrp.Position.Z - MAP_POS.Z)
        local inField = distX < PITCH_WIDTH/2 + 40 and distZ < PITCH_LENGTH/2 + 25
        if inField then
            hrp.CFrame = CFrame.new(STAND_POS)
            hrp.AssemblyLinearVelocity = Vector3.zero
        end
        if gameState.ball and gameState.ball.Parent then
            local dTB = (hrp.Position - gameState.ball.Position).Magnitude
            if dTB < 15 then
                local pushDir = (hrp.Position - gameState.ball.Position)
                if pushDir.Magnitude < 0.1 then pushDir = Vector3.new(1, 0, 0) end
                hrp.AssemblyLinearVelocity = pushDir.Unit * 100 + Vector3.new(0, 20, 0)
            end
        end
    end)
    
    RunService.Heartbeat:Connect(function(dt)
        updatePlayerDribble(dt)
        updateAILogic(dt)
        checkRules()
        updateCrowdVolume(dt)
        if tick()-gameState.lastInterceptCheck>0.1 then
            gameState.lastInterceptCheck=tick()
            checkInterception()
        end
    end)
    
    print("=== WORLD CUP 2026 ===")
    print("⚙ Click gear icon to change team names, colors, score & time")
    print("🟨 Vi phạm khi GK đối giữ bóng → thẻ vàng (còi to, tắt cổ vũ)")
    print("🟥 Vi phạm lần 2 → thẻ đỏ, lên khán đài 1 trận")
    print("📢 Bóng gần khung thành → tiếng cổ vũ tăng dần")
    print("⏱️ Hết 2 hiệp → hòa thì vào hiệp phụ → vẫn hòa thì luân lưu")
    print("⚽ Luân lưu 5 lượt, người chơi chọn Trái/Thẳng/Phải")
    print("🏆 Thắng → các cầu thủ ăn mừng")
end


local function createBall()
    local ball=Instance.new("Part")
    ball.Name="WC2026Ball"; ball.Shape=Enum.PartType.Ball
    ball.Size=Vector3.new(4,4,4); ball.Position=MAP_POS+Vector3.new(0,5,0)
    ball.Color=Color3.fromRGB(255,255,255); ball.Material=Enum.Material.SmoothPlastic
    ball.Anchored=false; ball.CanCollide=true
    ball.CustomPhysicalProperties=PhysicalProperties.new(0.7,0.3,0.5,1,1)
    ball.Parent=workspace
    gameState.ball=ball
    
    ball.Touched:Connect(function(hit)
        if not gameState.ball or not gameState.ball.Parent then return end
        local char = gameState.playerChar
        if not char or hit.Parent ~= char then return end
        if not canPlayerTouchBall() then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                local pushDir = hrp.Position - ball.Position
                if pushDir.Magnitude < 0.1 then pushDir = Vector3.new(0, 1, 0) end
                pushDir = Vector3.new(pushDir.X, 0.5, pushDir.Z).Unit
                hrp.AssemblyLinearVelocity = pushDir * 80 + Vector3.new(0, 30, 0)
            end
            return
        end
        if not gameState.playerDribbling then
            gameState.lastTouchTeam = gameState.playerTeam
        end
    end)
end

local function createAIPlayer(team, role, idx)
    local bot=Instance.new("Model")
    bot.Name=team.."_"..role.."_"..idx
    local teamColor=(team=="Red") and gameState.teamRedColor or gameState.teamBlueColor
    local skinColor = Color3.fromRGB(255,215,170)
    local shortsColor = Color3.fromRGB(255,255,255)
    local function mp(name,size,color,offX,offY,offZ)
        local p=Instance.new("Part")
        p.Name=name; p.Size=size; p.Color=color
        p.Material=Enum.Material.SmoothPlastic
        p.Anchored=true; p.CanCollide = true
        p.TopSurface = Enum.SurfaceType.Smooth
        p.BottomSurface = Enum.SurfaceType.Smooth
        p:SetAttribute("OffX", offX or 0)
        p:SetAttribute("OffY", offY or 0)
        p:SetAttribute("OffZ", offZ or 0)
        p.Parent=bot
        return p
    end
    local torso = mp("Torso", Vector3.new(2,2,1), teamColor, 0, 0, 0)
    local head = mp("Head", Vector3.new(2,1,1), skinColor, 0, 1.5, 0)
    mp("LeftArm", Vector3.new(1,2,1), teamColor, -1.5, 0, 0)
    mp("RightArm", Vector3.new(1,2,1), teamColor, 1.5, 0, 0)
    mp("LeftLeg", Vector3.new(1,2,1), shortsColor, -0.5, -2, 0)
    mp("RightLeg", Vector3.new(1,2,1), shortsColor, 0.5, -2, 0)
    local face = Instance.new("Decal")
    face.Name = "Face"
    face.Texture = "rbxasset://textures/face.png"
    face.Face = Enum.NormalId.Front
    face.Parent = head
    local headMesh = Instance.new("SpecialMesh")
    headMesh.MeshType = Enum.MeshType.Head
    headMesh.Scale = Vector3.new(1.25, 1.25, 1.25)
    headMesh.Parent = head
    bot.PrimaryPart = torso
    local tv=Instance.new("StringValue",bot); tv.Name="Team"; tv.Value=team
    local rv=Instance.new("StringValue",bot); rv.Name="Role"; rv.Value=role
    bot:SetAttribute("FormationIndex",idx)
    bot.Parent=workspace
    moveCharacter(bot, Vector3.new(MAP_POS.X, TORSO_Y, MAP_POS.Z), Vector3.new(MAP_POS.X, TORSO_Y, MAP_POS.Z+1))
    if team=="Red" then table.insert(gameState.redTeam,bot) else table.insert(gameState.blueTeam,bot) end
    return bot
end

local function getHomePos(bot, useBall)
    local team=bot.Team.Value; local role=bot.Role.Value
    local idx=bot:GetAttribute("FormationIndex") or 1
    local attackDir=(team=="Red") and 1 or -1
    local baseX,baseZ,xW,zW=0,0,0.3,0.3
    if role=="Goalkeeper" then baseX,baseZ,xW,zW=0,-0.95,0.5,0.05
    elseif role=="Defender" then
        local xs={-0.35,-0.12,0.12,0.35}; baseX=xs[idx] or 0
        baseZ=(idx==1 or idx==4) and -0.5 or -0.6; xW,zW=0.35,0.4
    elseif role=="Midfielder" then
        local xs={-0.30,-0.10,0.10,0.30}; baseX=xs[idx] or 0
        baseZ=(idx==1 or idx==4) and -0.10 or 0.0; xW,zW=0.35,0.5
    elseif role=="Striker" then
        baseX=(idx==1) and -0.15 or 0.15; baseZ=0.35; xW,zW=0.3,0.55
    end
    local bZ,bX=0,0
    if useBall and gameState.ball then
        bZ=math.clamp((gameState.ball.Position.Z-MAP_POS.Z)/(PITCH_LENGTH/2),-1,1)
        bX=math.clamp((gameState.ball.Position.X-MAP_POS.X)/(PITCH_WIDTH/2),-1,1)
    end
    local tX,tZ
    if role=="Goalkeeper" then
        local gz=(team=="Red") and (MAP_POS.Z-PITCH_LENGTH/2+12) or (MAP_POS.Z+PITCH_LENGTH/2-12)
        tX=MAP_POS.X+math.clamp(bX,-0.5,0.5)*(GOAL_WIDTH/2)
        tZ=gz
    else
        tZ=MAP_POS.Z+(baseZ*attackDir+bZ*zW)*(PITCH_LENGTH/2)
        tX=MAP_POS.X+(baseX+bX*xW)*(PITCH_WIDTH/2)
    end
    tX=math.clamp(tX,MAP_POS.X-PITCH_WIDTH/2+10,MAP_POS.X+PITCH_WIDTH/2-10)
    tZ=math.clamp(tZ,MAP_POS.Z-PITCH_LENGTH/2+5,MAP_POS.Z+PITCH_LENGTH/2-5)
    return Vector3.new(tX, TORSO_Y, tZ)
end

local function playBallTouchSound()
    if tick()-gameState.lastBallTouchSound<0.2 then return end
    gameState.lastBallTouchSound=tick()
    if gameState.ball then playBallKick(gameState.ball.Position,math.random(90,110)/100) end
end

local function applyKnuckleball(ball,direction,power)
    ball.AssemblyLinearVelocity=direction*power+Vector3.new(0,40,0)
    gameState.ballIsCurving=true
    local startTime=tick()
    local perp=Vector3.new(-direction.Z,0,direction.X).Unit
    local conn
    conn=RunService.Heartbeat:Connect(function(dt)
        if not ball or not ball.Parent or tick()-startTime>2.2 then
            if conn then conn:Disconnect() end
            return
        end
        local t=(tick()-startTime)/2.2
        local wobbleAmount=math.sin((tick()-startTime)*22)*220*(1-t)
        local v=ball.AssemblyLinearVelocity
        if v.Magnitude>5 then
            ball.AssemblyLinearVelocity=v+perp*wobbleAmount*dt
        end
    end)
    task.delay(2.2,function() gameState.ballIsCurving=false end)
end

local function applyPowerShot(ball,direction,power,spinAmount)
    ball.AssemblyLinearVelocity=direction*power+Vector3.new(0,20,0)
    if spinAmount and spinAmount>0 then
        local startTime=tick()
        local spinRate=spinAmount/800
        local conn
        conn=RunService.Heartbeat:Connect(function(dt)
            if not ball or not ball.Parent or tick()-startTime>1.8 then
                if conn then conn:Disconnect() end
                return
            end
            local t=(tick()-startTime)/1.8
            local angle=spinRate*(1-t)*dt
            local v=ball.AssemblyLinearVelocity
            if v.Magnitude>5 then
                local c,s=math.cos(angle),math.sin(angle)
                ball.AssemblyLinearVelocity=Vector3.new(v.X*c-v.Z*s,v.Y,v.X*s+v.Z*c)
            end
        end)
    end
end

local function applyLobPass(ball, targetPos, powerBase)
    local dir = (targetPos - ball.Position)
    local horizDir = Vector3.new(dir.X, 0, dir.Z)
    local dist = horizDir.Magnitude
    if dist < 1 then return end
    horizDir = horizDir.Unit
    local power = math.clamp(dist * 1.1 + (powerBase or 0), 100, 250)
    local lift = math.clamp(dist * 0.4 + 40, 60, 150)
    ball.AssemblyLinearVelocity = horizDir * power + Vector3.new(0, lift, 0)
end

local function applyGroundPass(ball, targetPos, powerBase)
    local dir = (targetPos - ball.Position)
    local horizDir = Vector3.new(dir.X, 0, dir.Z)
    local dist = horizDir.Magnitude
    if dist < 1 then return end
    horizDir = horizDir.Unit
    local power = math.clamp(dist * 1.15 + (powerBase or 0), 80, 220)
    ball.AssemblyLinearVelocity = horizDir * power + Vector3.new(0, 12, 0)
end

local function aiDribble(bot)
    local ball=gameState.ball
    if not ball or not bot.PrimaryPart then return false end
    local botId=bot:GetDebugId()
    local botPos=bot.PrimaryPart.Position
    local distToBall=(botPos-ball.Position).Magnitude
    if distToBall>20 then return false end
    local team=bot.Team.Value
    local attackGoalZ=(team=="Red") and (MAP_POS.Z+PITCH_LENGTH/2) or (MAP_POS.Z-PITCH_LENGTH/2)
    local botState=gameState.aiDribbleState[botId]
    if not botState or not botState.active or distToBall>8 then
        local targetPos=botPos+(Vector3.new(MAP_POS.X,MAP_POS.Y,attackGoalZ)-botPos).Unit*5
        ball.CFrame=CFrame.new(targetPos+Vector3.new(0,2,0))
        ball.AssemblyLinearVelocity=Vector3.new(0,0,0)
        ball.AssemblyAngularVelocity=Vector3.new(0,0,0)
        gameState.aiDribbleState[botId]={active=true}
        gameState.lastTouchTeam=team
        playBallTouchSound()
        return true
    end
    local attackDir=Vector3.new(0,0,(team=="Red") and 1 or -1)
    local sideOffset=(math.random(-30,30))/100
    local pushDir=(attackDir+Vector3.new(1,0,0)*sideOffset).Unit
    ball.AssemblyLinearVelocity=pushDir*55+Vector3.new(0,5,0)
    gameState.lastTouchTeam=team
    playBallTouchSound()
    gameState.aiDribbleState[botId]={active=true}
    return true
end

local function aiShootBall(bot)
    local ball=gameState.ball
    local team=bot.Team.Value
    local attackGoalZ=(team=="Red") and (MAP_POS.Z+PITCH_LENGTH/2) or (MAP_POS.Z-PITCH_LENGTH/2)
    local distToGoal=(bot.PrimaryPart.Position-Vector3.new(MAP_POS.X,MAP_POS.Y,attackGoalZ)).Magnitude
    gameState.lastTouchTeam=team
    playBallTouchSound()
    local st=math.random(1,100)
    local targetX = MAP_POS.X + ((math.random(1,2)==1) and -1 or 1) * (GOAL_WIDTH/2 - 5)
    local targetY = GOAL_HEIGHT - 6
    local ap = Vector3.new(targetX, MAP_POS.Y + targetY, attackGoalZ)
    if distToGoal>250 then
        if st<=60 then
            applyPowerShot(ball,(ap-ball.Position).Unit,math.random(280,380),math.random(-150,150))
        elseif st<=85 then
            applyKnuckleball(ball,(ap-ball.Position).Unit,math.random(380,480))
        else
            ball.AssemblyLinearVelocity=(ap-ball.Position).Unit*180+Vector3.new(0,100,0)
        end
    else
        if st<=50 then
            applyPowerShot(ball,(ap-ball.Position).Unit,math.random(280,380),math.random(-200,200))
        elseif st<=85 then
            applyKnuckleball(ball,(ap-ball.Position).Unit,math.random(420,550))
        else
            ball.AssemblyLinearVelocity=(ap-ball.Position).Unit*150+Vector3.new(0,80,0)
        end
    end
end

local function findBestPassTarget(bot)
    local ball=gameState.ball
    local team=bot.Team.Value
    local attackGoalZ=(team=="Red") and (MAP_POS.Z+PITCH_LENGTH/2) or (MAP_POS.Z-PITCH_LENGTH/2)
    local teammates=(team=="Red") and gameState.redTeam or gameState.blueTeam
    local oppTeam=(team=="Red") and "Blue" or "Red"
    local oppList=(oppTeam=="Red") and gameState.redTeam or gameState.blueTeam
    local best,bestScore,pType=nil,-math.huge,"Short"
    for _,tm in ipairs(teammates) do
        if tm~=bot and tm.PrimaryPart and tm.Role.Value~="Goalkeeper" then
            local tmPos=tm.PrimaryPart.Position
            local dTB=(tmPos-ball.Position).Magnitude
            if dTB>15 and dTB<350 then
                local score=-math.abs(tmPos.Z-attackGoalZ)*0.5
                local nearestOpp=math.huge
                for _,opp in ipairs(oppList) do
                    if opp.PrimaryPart then
                        local d=(opp.PrimaryPart.Position-tmPos).Magnitude
                        if d<nearestOpp then nearestOpp=d end
                    end
                end
                if nearestOpp<25 then score=score-200
                elseif nearestOpp>60 then score=score+100 end
                local bDG=math.abs(ball.Position.Z-attackGoalZ)
                local isThrough=false
                if math.abs(tmPos.Z-attackGoalZ)<bDG-30 and nearestOpp>40 then
                    score=score+150; isThrough=true
                end
                if score>bestScore then
                    bestScore=score; best=tm
                    if isThrough then pType="ThroughBall"
                    elseif dTB<80 then pType="Short"
                    elseif dTB<180 then pType="Medium"
                    else pType="LobPass" end
                end
            end
        end
    end
    return best,pType
end

local function handleBallTouch(bot)
    if gameState.gkHolding then return end
    local ball=gameState.ball
    local team=bot.Team.Value
    local attackGoalZ=(team=="Red") and (MAP_POS.Z+PITCH_LENGTH/2) or (MAP_POS.Z-PITCH_LENGTH/2)
    local botPos=bot.PrimaryPart.Position
    local distToGoal=math.abs(botPos.Z-attackGoalZ)
    local botId=bot:GetDebugId()
    local canShootNow=tick()>(gameState.passCooldowns[botId] or 0)
    local dTB=(botPos-ball.Position).Magnitude
    if dTB<15 and distToGoal>200 and math.random()<0.5 then
        if aiDribble(bot) then
            gameState.passCooldowns[botId]=tick()+0.8
            return
        end
    end
    if distToGoal<400 and canShootNow then
        aiShootBall(bot)
        gameState.passCooldowns[botId]=tick()+1.0
        return
    end
    gameState.lastTouchTeam=team
    playBallTouchSound()
    local target,pType=findBestPassTarget(bot)
    if target and target.PrimaryPart then
        local tmPos=target.PrimaryPart.Position
        if pType=="ThroughBall" then
            local throughDir=Vector3.new(0,0,(team=="Red") and 1 or -1)
            local throughTarget = tmPos + throughDir * 40
            applyGroundPass(ball, throughTarget, 20)
        elseif pType=="Short" then
            applyGroundPass(ball, tmPos, 0)
        elseif pType=="Medium" then
            applyGroundPass(ball, tmPos, 20)
        else
            applyLobPass(ball, tmPos, 0)
        end
        gameState.passCooldowns[botId]=tick()+1.5
    else
        local d=(Vector3.new(MAP_POS.X,MAP_POS.Y,attackGoalZ)-ball.Position).Unit
        ball.AssemblyLinearVelocity=d*100
        gameState.passCooldowns[botId]=tick()+0.8
    end
end

local function goalkeeperPassBall(gk, ball, team)
    local candidates = {}
    local teammates = (team=="Red") and gameState.redTeam or gameState.blueTeam
    for _, tm in ipairs(teammates) do
        if tm ~= gk and tm.PrimaryPart then
            table.insert(candidates, {part = tm.PrimaryPart, role = tm.Role.Value, isPlayer = false})
        end
    end
    local pc = gameState.playerChar
    if pc and gameState.playerTeam == team and not gameState.playerSuspended then
        local hrp = pc:FindFirstChild("HumanoidRootPart")
        if hrp then
            table.insert(candidates, {part = hrp, role = "Player", isPlayer = true})
        end
    end
    local bestTarget = nil
    local bestScore = -math.huge
    local ballPos = ball.Position
    local ownGoalZ = (team=="Red") and (MAP_POS.Z - PITCH_LENGTH/2) or (MAP_POS.Z + PITCH_LENGTH/2)
    for _, cand in ipairs(candidates) do
        if cand.part then
            local dist = (cand.part.Position - ballPos).Magnitude
            if dist > 15 and dist < 400 then
                local score = -math.abs(cand.part.Position.Z - ownGoalZ) * 0.5
                if cand.isPlayer then score = score + 30 end
                local oppList = (team=="Red") and gameState.blueTeam or gameState.redTeam
                local nearestOpp = math.huge
                for _, opp in ipairs(oppList) do
                    if opp.PrimaryPart then
                        local d = (opp.PrimaryPart.Position - cand.part.Position).Magnitude
                        if d < nearestOpp then nearestOpp = d end
                    end
                end
                if nearestOpp < 25 then score = score - 200
                elseif nearestOpp > 60 then score = score + 100 end
                if score > bestScore then bestScore = score; bestTarget = cand end
            end
        end
    end
    if bestTarget then
        local targetPos = bestTarget.part.Position
        local dist = (targetPos - ball.Position).Magnitude
        if dist > 150 then applyLobPass(ball, targetPos, 30)
        else applyGroundPass(ball, targetPos, 20) end
        gameState.lastTouchTeam = team
    else
        local attackDir = (team=="Red") and 1 or -1
        ball.AssemblyLinearVelocity = Vector3.new(0, 100, attackDir * 150)
    end
end

local function updateGoalkeeperAI(gk,dt)
    local ball=gameState.ball
    if not ball or not gk.PrimaryPart then return end
    local gkId=gk:GetDebugId()
    local team=gk.Team.Value
    local goalLineZ=(team=="Red") and (MAP_POS.Z-PITCH_LENGTH/2+12) or (MAP_POS.Z+PITCH_LENGTH/2-12)
    local minX = MAP_POS.X - GOAL_WIDTH/2 - 5
    local maxX = MAP_POS.X + GOAL_WIDTH/2 + 5
    local boxMinZ, boxMaxZ
    if team=="Red" then
        boxMinZ = MAP_POS.Z - PITCH_LENGTH/2 - 3
        boxMaxZ = MAP_POS.Z - PITCH_LENGTH/2 + PENALTY_BOX_DEPTH
    else
        boxMinZ = MAP_POS.Z + PITCH_LENGTH/2 - PENALTY_BOX_DEPTH
        boxMaxZ = MAP_POS.Z + PITCH_LENGTH/2 + 3
    end
    local bp=ball.Position
    local bv=ball.AssemblyLinearVelocity
    local bSpeed=bv.Magnitude
    local cdEnd=gameState.gkHoldCooldowns[gkId] or 0
    if tick()<cdEnd then return end
    local predX,predY=bp.X,MAP_POS.Y+8
    local approaching,timeToGoal=false,999
    if (team=="Red" and bv.Z<-5) or (team=="Blue" and bv.Z>5) then
        if math.abs(bv.Z)>5 then
            timeToGoal=(goalLineZ-bp.Z)/bv.Z
            if timeToGoal>0 and timeToGoal<5 then
                approaching=true
                predX=bp.X+bv.X*timeToGoal
                predY=bp.Y+bv.Y*timeToGoal-0.5*workspace.Gravity*timeToGoal*timeToGoal
            end
        end
    end
    local tX=math.clamp(predX,minX,maxX)
    local ballInBox = (bp.Z >= boxMinZ and bp.Z <= boxMaxZ and bp.X >= minX and bp.X <= maxX)
    local tZ=goalLineZ
    if ballInBox or approaching then
        if team=="Red" then tZ = math.clamp(bp.Z + 5, boxMinZ, boxMaxZ)
        else tZ = math.clamp(bp.Z - 5, boxMinZ, boxMaxZ) end
    end
    local speed=GK_SPEED
    if approaching then
        if timeToGoal<0.8 then speed=GK_SPEED*GK_DIVE_SPEED
        elseif timeToGoal<1.5 then speed=GK_SPEED*GK_APPROACH_SPEED
        elseif timeToGoal<3 then speed=GK_SPEED*2.5 end
    end
    local jumpHeight = 0
    if approaching then
        local targetJump = predY - MAP_POS.Y - 8
        if targetJump > 0 then jumpHeight = math.clamp(targetJump, 0, 22) end
        if timeToGoal < 0.6 then jumpHeight = math.clamp(jumpHeight + 3, 0, 24) end
    end
    local tY = TORSO_Y + jumpHeight
    local gkPos = gk.PrimaryPart.Position
    local targetPos = Vector3.new(tX, tY, tZ)
    local dir = targetPos - gkPos
    local dTB = (gkPos - bp).Magnitude
    if dTB > 4 and dir.Magnitude > 0.3 then
        local newPos = gkPos + dir.Unit * speed * dt
        newPos = Vector3.new(math.clamp(newPos.X, minX, maxX), TORSO_Y + jumpHeight, math.clamp(newPos.Z, boxMinZ, boxMaxZ))
        moveCharacter(gk, newPos, Vector3.new(bp.X, newPos.Y, bp.Z))
    elseif dTB <= 4 then
        local currentY = gkPos.Y
        local targetY = TORSO_Y + jumpHeight
        local newY = currentY + (targetY - currentY) * 0.15
        local newPos = Vector3.new(gkPos.X, newY, gkPos.Z)
        moveCharacter(gk, newPos, Vector3.new(bp.X, newPos.Y, bp.Z))
    end
    local catchRadius = 8
    if bp.Y > MAP_POS.Y + 12 then catchRadius = 11 end
    if bp.Y > MAP_POS.Y + 20 then catchRadius = 13 end
    if dTB < catchRadius and tick() >= cdEnd then
        local ballIsHigh = bp.Y > MAP_POS.Y + 16
        local ballIsKnuckle = gameState.ballIsCurving and bSpeed > 300
        local shouldParry = false
        local shouldCatch = false
        if ballIsKnuckle then shouldParry = true
        elseif ballIsHigh then shouldParry = true
        else shouldCatch = true end
        if shouldCatch then
            ball.AssemblyLinearVelocity=Vector3.new(0,0,0)
            ball.AssemblyAngularVelocity=Vector3.new(0,0,0)
            gameState.ballIsCurving=false
            gameState.lastTouchTeam=team
            playBallTouchSound()
            gameState.gkHolding=true
            gameState.gkHoldingTeam=team
            gameState.gkHoldCooldowns[gkId]=tick()+3.0
            task.spawn(function()
                task.wait(2.0)
                if not ball or not ball.Parent then 
                    gameState.gkHolding=false
                    gameState.gkHoldingTeam=nil
                    return 
                end
                goalkeeperPassBall(gk, ball, team)
                gameState.gkHolding=false
                gameState.gkHoldingTeam=nil
            end)
        elseif shouldParry then
            local parryDir = Vector3.new(bp.X - gkPos.X, 0, bp.Z - gkPos.Z)
            if parryDir.Magnitude < 1 then parryDir = Vector3.new(0, 0, 1) end
            parryDir = parryDir.Unit
            local parryPower = math.clamp(bSpeed * 0.6, 100, 220)
            ball.AssemblyLinearVelocity = parryDir * parryPower + Vector3.new(0, 120, 0)
            ball.AssemblyAngularVelocity = Vector3.new(math.random(-30,30),math.random(-30,30),math.random(-30,30))
            playBallKick(ball.Position, math.random(70, 85)/100)
            gameState.ballIsCurving = false
            gameState.lastTouchTeam = team
            gameState.gkHoldCooldowns[gkId] = tick() + 0.8
        end
    end
end

local function updateOutfieldAI(bot,allBots,closestBot,dt)
    local ball=gameState.ball
    local team=bot.Team.Value
    local role=bot.Role.Value
    local botPos=bot.PrimaryPart.Position
    local attackGoalZ=(team=="Red") and (MAP_POS.Z+PITCH_LENGTH/2) or (MAP_POS.Z-PITCH_LENGTH/2)
    local ownGoalZ=(team=="Red") and (MAP_POS.Z-PITCH_LENGTH/2) or (MAP_POS.Z+PITCH_LENGTH/2)
    local teamHasBall=(gameState.lastTouchTeam==team)
    local oppTeam=(team=="Red") and "Blue" or "Red"
    local oppList=(oppTeam=="Red") and gameState.redTeam or gameState.blueTeam
    
    if gameState.gkHolding then
        local holdingGK=nil
        for _,b in ipairs(gameState.redTeam) do if b.Role.Value=="Goalkeeper" then holdingGK=b end end
        for _,b in ipairs(gameState.blueTeam) do if b.Role.Value=="Goalkeeper" then holdingGK=b end end
        local target
        if holdingGK and holdingGK.PrimaryPart then
            local gkPos=holdingGK.PrimaryPart.Position
            local distToGK=(botPos-gkPos).Magnitude
            if distToGK<60 then target=botPos+(botPos-gkPos).Unit*40
            else target=getHomePos(bot,false) end
        else target=getHomePos(bot,false) end
        local dir=target-botPos
        if dir.Magnitude>3 then
            local newPos = botPos + dir.Unit*AI_SPEED*dt
            newPos = Vector3.new(newPos.X, TORSO_Y, newPos.Z)
            moveCharacter(bot, newPos, Vector3.new(newPos.X, newPos.Y, newPos.Z + dir.Unit.Z))
        end
        return
    end
    
    local playerDribbling = gameState.playerDribbling and (gameState.playerTeam == team) and not gameState.playerSuspended
    if playerDribbling then
        local pc = gameState.playerChar
        local pHrp = pc and pc:FindFirstChild("HumanoidRootPart")
        if pHrp then
            local playerPos = pHrp.Position
            local playerX, playerZ = playerPos.X, playerPos.Z
            local attackDir = (team=="Red") and 1 or -1
            local target
            if role == "Striker" then
                local strikerIdx = bot:GetAttribute("FormationIndex") or 1
                local sideOffset = (strikerIdx == 1) and -70 or 70
                target = Vector3.new(playerX + sideOffset, TORSO_Y, math.min(attackGoalZ - 60, playerZ + attackDir * 150))
            elseif role == "Midfielder" then
                local midIdx = bot:GetAttribute("FormationIndex") or 1
                local sideOffset = (midIdx <= 2) and -90 or 90
                local zOffset = (midIdx % 2 == 0) and 30 or -30
                target = Vector3.new(playerX + sideOffset, TORSO_Y, playerZ + attackDir * 80 + zOffset)
            else
                local defIdx = bot:GetAttribute("FormationIndex") or 1
                local sideOffset = (defIdx <= 2) and -70 or 70
                target = Vector3.new(playerX + sideOffset, TORSO_Y, playerZ - attackDir * 100)
            end
            target = Vector3.new(
                math.clamp(target.X, MAP_POS.X - PITCH_WIDTH/2 + 10, MAP_POS.X + PITCH_WIDTH/2 - 10),
                TORSO_Y,
                math.clamp(target.Z, MAP_POS.Z - PITCH_LENGTH/2 + 5, MAP_POS.Z + PITCH_LENGTH/2 - 5)
            )
            local dir = target - botPos
            if dir.Magnitude > 3 then
                local newPos = botPos + dir.Unit * AI_SPEED * dt
                newPos = Vector3.new(newPos.X, TORSO_Y, newPos.Z)
                moveCharacter(bot, newPos, Vector3.new(playerX, newPos.Y, playerZ))
            end
            return
        end
    end
    
    local target
    if bot==closestBot then
        target=ball.Position+ball.AssemblyLinearVelocity*0.3
        if (botPos-ball.Position).Magnitude<12 then
            handleBallTouch(bot)
            gameState.lastActionTime=tick()
        end
    elseif role=="Striker" then
        local myStrikerIndex=bot:GetAttribute("FormationIndex") or 1
        local xOffset=(myStrikerIndex==1) and -60 or 60
        local targetZ
        if teamHasBall then targetZ=attackGoalZ-100
        else targetZ=MAP_POS.Z+(attackGoalZ-MAP_POS.Z)*0.35 end
        local ballXOffset=math.clamp((ball.Position.X-MAP_POS.X)*0.5,-80,80)
        local targetX=MAP_POS.X+xOffset+ballXOffset
        target=Vector3.new(targetX,MAP_POS.Y+5,targetZ)
        local distToBall=(botPos-ball.Position).Magnitude
        if distToBall<80 and ball.Position.Z*(team=="Red" and 1 or -1)>0 then
            target=ball.Position+ball.AssemblyLinearVelocity*0.4
        end
        if distToBall<12 then
            handleBallTouch(bot)
            gameState.lastActionTime=tick()
        end
    elseif teamHasBall then
        if role=="Midfielder" then
            target=Vector3.new(ball.Position.X+math.random(-40,40),MAP_POS.Y+5,math.max(ball.Position.Z,(ball.Position.Z+attackGoalZ)/2))
        else
            target=Vector3.new(MAP_POS.X+((bot:GetAttribute("FormationIndex") or 2)-2.5)*50,MAP_POS.Y+5,math.max(MAP_POS.Z-30,ball.Position.Z-80))
        end
    else
        if role=="Defender" then
            local nearestOpp,minD=nil,math.huge
            for _,opp in ipairs(oppList) do
                if opp.PrimaryPart and opp.Role.Value~="Goalkeeper" then
                    local d=math.abs(opp.PrimaryPart.Position.Z-ownGoalZ)
                    if d<minD then minD=d; nearestOpp=opp end
                end
            end
            if nearestOpp then
                local oppPos=nearestOpp.PrimaryPart.Position
                local midPoint=(oppPos+Vector3.new(MAP_POS.X,MAP_POS.Y,ownGoalZ))/2
                local dTB=(oppPos-ball.Position).Magnitude
                target=(dTB<30) and Vector3.new(oppPos.X*0.7+midPoint.X*0.3,MAP_POS.Y+5,oppPos.Z*0.7+midPoint.Z*0.3) or Vector3.new(midPoint.X,MAP_POS.Y+5,midPoint.Z)
            else target=getHomePos(bot,true) end
        elseif role=="Midfielder" then
            target=((botPos-ball.Position).Magnitude<120) and (ball.Position+ball.AssemblyLinearVelocity*0.2) or Vector3.new(ball.Position.X*0.5+MAP_POS.X*0.5,MAP_POS.Y+5,(ball.Position.Z+ownGoalZ)/2)
        end
    end
    local dir=target-botPos
    if dir.Magnitude>3 then
        local newPos = botPos + dir.Unit*AI_SPEED*dt
        newPos = Vector3.new(newPos.X, TORSO_Y, newPos.Z)
        moveCharacter(bot, newPos, Vector3.new(ball.Position.X, newPos.Y, ball.Position.Z))
    end
end

local function updateAILogic(dt)
    local ball=gameState.ball
    if not ball or not ball.Parent or gameState.restartCooldown or not gameState.gameActive or gameState.goalScored then return end
    if gameState.penaltyActive or gameState.celebrating then return end
    local allBots={}
    for _,b in ipairs(gameState.redTeam) do table.insert(allBots,b) end
    for _,b in ipairs(gameState.blueTeam) do table.insert(allBots,b) end
    local closestBot,minDist=nil,math.huge
    for _,bot in ipairs(allBots) do
        if bot.PrimaryPart and bot.Role.Value~="Goalkeeper" then
            local d=(bot.PrimaryPart.Position-ball.Position).Magnitude
            if d<minDist then minDist=d; closestBot=bot end
        end
    end
    local canTouch=tick()-gameState.lastActionTime>0.6 and not gameState.shootCharging and not gameState.knuckleCharging
    if gameState.gkHolding then canTouch=false end
    if gameState.playerDribbling then canTouch=false end
    for _,bot in ipairs(allBots) do
        if not bot.PrimaryPart then continue end
        if bot.Role.Value=="Goalkeeper" then
            updateGoalkeeperAI(bot,dt)
        else
            local playerDribbling = gameState.playerDribbling and (gameState.playerTeam == bot.Team.Value) and not gameState.playerSuspended
            local isStriker=(bot.Role.Value=="Striker")
            local shouldChase=(bot==closestBot and not canTouch and not playerDribbling)
            if isStriker and (bot.PrimaryPart.Position-ball.Position).Magnitude>60 then shouldChase=false end
            if gameState.gkHolding then shouldChase=false end
            if shouldChase then
                local dir=ball.Position-bot.PrimaryPart.Position
                if dir.Magnitude>3 then
                    local newPos = bot.PrimaryPart.Position + dir.Unit*AI_SPEED*dt
                    newPos = Vector3.new(newPos.X, TORSO_Y, newPos.Z)
                    local lookDir = Vector3.new(dir.X, 0, dir.Z)
                    if lookDir.Magnitude < 0.1 then lookDir = Vector3.new(0,0,1) end
                    moveCharacter(bot, newPos, newPos + lookDir.Unit)
                end
            else
                updateOutfieldAI(bot,allBots,closestBot,dt)
            end
        end
    end
end

local function checkInterception()
    local ball=gameState.ball
    if not ball then return end
    if gameState.gkHolding or gameState.penaltyActive or gameState.celebrating then return end
    if gameState.shootCharging or gameState.knuckleCharging then return end
    local speed=ball.AssemblyLinearVelocity.Magnitude
    local isDribbled=gameState.playerDribbling
    if speed<20 and not isDribbled then return end
    if not gameState.lastTouchTeam then return end
    local oppTeam=(gameState.lastTouchTeam=="Red") and "Blue" or "Red"
    local oppList=(oppTeam=="Red") and gameState.redTeam or gameState.blueTeam
    for _,bot in ipairs(oppList) do
        if bot.PrimaryPart then
            local d=(bot.PrimaryPart.Position-ball.Position).Magnitude
            local chance=0.5
            if isDribbled then
                chance=0.35
                if d>8 then chance=0.05 end
            else
                if speed>400 then chance=0.15
                elseif speed>300 then chance=0.25
                elseif speed>200 then chance=0.35 end
            end
            if d<14 and math.random()<chance then
                local dir=(bot.PrimaryPart.Position-ball.Position).Unit
                if gameState.playerDribbling then gameState.playerDribbling=false end
                ball.AssemblyLinearVelocity=dir*speed*0.5+Vector3.new(math.random(-20,20),30,math.random(-20,20))
                gameState.ballIsCurving=false
                gameState.lastTouchTeam=oppTeam
                playBallTouchSound()
                return
            end
        end
    end
end

local function updatePlayerDribble(dt)
    if gameState.playerSuspended or gameState.playerCard == "red" then
        gameState.playerDribbling = false
        return
    end
    if gameState.penaltyActive or gameState.celebrating then
        gameState.playerDribbling = false
        return
    end
    if not gameState.playerDribbling then return end
    local char=gameState.playerChar
    if not char then gameState.playerDribbling=false; return end
    local hrp=char:FindFirstChild("HumanoidRootPart")
    local ball=gameState.ball
    if not hrp or not ball then gameState.playerDribbling=false; return end
    local dTB=(hrp.Position-ball.Position).Magnitude
    if dTB>20 then gameState.playerDribbling=false; return end
    local feetPos=hrp.Position+hrp.CFrame.LookVector*4
    ball.CFrame=CFrame.new(feetPos.X,feetPos.Y-1.5,feetPos.Z)
    ball.AssemblyLinearVelocity=Vector3.new(0,0,0)
    ball.AssemblyAngularVelocity=Vector3.new(0,0,0)
    gameState.lastTouchTeam=gameState.playerTeam
end

local function doDribble()
    if not canPlayerTouchBall() then return end
    local char=gameState.playerChar
    if not char then return end
    local hrp=char:FindFirstChild("HumanoidRootPart")
    local ball=gameState.ball
    if not hrp or not ball then return end
    local dTB=(hrp.Position-ball.Position).Magnitude
    if dTB>20 then return end
    gameState.playerDribbling=true
    gameState.lastTouchTeam=gameState.playerTeam
    playBallTouchSound()
end


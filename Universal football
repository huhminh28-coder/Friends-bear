local function toggleBenchMode()
    if gameState.inPenaltyShootout and gameState.isOnBench then return end
    gameState.isOnBench = not gameState.isOnBench
    local chr = gameState.playerChar
    if not chr then return end
    
    if gameState.isOnBench then
        local hrp = chr:FindFirstChild("HumanoidRootPart")
        if hrp then hrp.CFrame = CFrame.new(MAP_POS.X, MAP_POS.Y + 70, MAP_POS.Z - (PITCH_LENGTH/2) - 120) end
        updatePlayerAppearance()
        for _, btn in ipairs(gameState.actionButtons) do btn.Visible = false end
        if gameState.switchTeamBtn then gameState.switchTeamBtn.Visible = false end
        gameState.benchBtn.Text = "ENTER PITCH"
        gameState.benchBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
        gameState.playerDribbling = false
    else
        local hrp = chr:FindFirstChild("HumanoidRootPart")
        if hrp then
            local ad = (gameState.playerTeam=="Red") and 1 or -1
            local tX = MAP_POS.X; local tZ = MAP_POS.Z
            if gameState.playerPosition == "Striker" then tZ = MAP_POS.Z + (PITCH_LENGTH/2 * 0.35) * ad
            elseif gameState.playerPosition == "Midfielder" then tZ = MAP_POS.Z + (PITCH_LENGTH/2 * 0.1) * ad
            else tZ = MAP_POS.Z - (PITCH_LENGTH/2 * 0.3) * ad end
            hrp.CFrame = CFrame.new(Vector3.new(tX, TORSO_Y, tZ))
        end
        updatePlayerAppearance()
        for _, btn in ipairs(gameState.actionButtons) do btn.Visible = true end
        if gameState.switchTeamBtn then gameState.switchTeamBtn.Visible = true end
        if gameState.physicsShotLabel then gameState.physicsShotLabel.Visible = gameState.physicsShotEnabled end
        if gameState.superSkillLabel then gameState.superSkillLabel.Visible = gameState.superSkillEnabled end
        gameState.benchBtn.Text = "GO TO BENCH"
        gameState.benchBtn.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
    end
end

local function startGoalCelebration(scorer, scoringTeam)
    if gameState.goalCelebrationActive or gameState.practiceModeEnabled then return end
    gameState.goalCelebrationActive = true
    local teamList = (scoringTeam == "Red") and gameState.redTeam or gameState.blueTeam
    
    local runners = {}
    for _, bot in ipairs(teamList) do
        if bot.PrimaryPart and bot ~= scorer then table.insert(runners, bot) end
    end
    
    local startTime = tick()
    local duration = 10
    local runConn
    runConn = RunService.Heartbeat:Connect(function()
        if tick() - startTime > duration then if runConn then runConn:Disconnect() end; return end
        
        local scorerPos
        if scorer == "player" then
            local hrp = gameState.playerChar and gameState.playerChar:FindFirstChild("HumanoidRootPart")
            scorerPos = hrp and hrp.Position or MAP_POS
        elseif scorer and scorer.PrimaryPart then
            scorerPos = scorer.PrimaryPart.Position
        else
            scorerPos = MAP_POS
        end

        for idx, bot in ipairs(runners) do
            if bot.PrimaryPart then
                local cur = bot.PrimaryPart.Position
                if bot.Role.Value == "Goalkeeper" and (tick()-startTime) < 1.2 then
                    local jump = math.abs(math.sin((tick()-startTime)*10))*3
                    pcall(moveCharacter, bot, Vector3.new(cur.X, TORSO_Y+jump, cur.Z), scorerPos)
                else
                    local dir = scorerPos - cur
                    local horiz = Vector3.new(dir.X,0,dir.Z)
                    if horiz.Magnitude > 4 then
                        horiz = horiz.Unit
                        local newPos = cur + horiz * 22 * 0.033
                        pcall(moveCharacter, bot, Vector3.new(newPos.X, TORSO_Y, newPos.Z), scorerPos)
                    else
                        local jump = math.abs(math.sin((tick()-startTime)*12 + idx))*2
                        local offset = CFrame.Angles(0, (idx/#runners)*math.pi*2, 0) * Vector3.new(3.5, 0, 0)
                        pcall(moveCharacter, bot, Vector3.new(cur.X + offset.X, TORSO_Y+jump, cur.Z + offset.Z), scorerPos)
                    end
                end
            end
        end
    end)
    task.wait(duration)
    if runConn then runConn:Disconnect() end
    gameState.goalCelebrationActive = false
end

local function buildTrophy(tournamentType)
    local model = Instance.new("Model"); model.Name = "Trophy"
    local pc, sc, shape
    if tournamentType == "World Cup" then pc=Color3.fromRGB(255,200,60); sc=Color3.fromRGB(180,140,30); shape="WC"
    elseif tournamentType == "Champions League" then pc=Color3.fromRGB(215,220,230); sc=Color3.fromRGB(150,155,165); shape="CL"
    elseif tournamentType == "Euro" then pc=Color3.fromRGB(220,220,220); sc=Color3.fromRGB(150,150,150); shape="EU"
    elseif tournamentType == "Nations League" then pc=Color3.fromRGB(240,240,240); sc=Color3.fromRGB(50,50,50); shape="NL"
    elseif tournamentType == "Premier League" then pc=Color3.fromRGB(255,215,0); sc=Color3.fromRGB(20,80,50); shape="PL"
    elseif tournamentType == "Bundesliga" then pc=Color3.fromRGB(220,220,220); sc=Color3.fromRGB(150,150,150); shape="BL"
    elseif tournamentType == "La Liga" then pc=Color3.fromRGB(240,240,240); sc=Color3.fromRGB(180,180,180); shape="LL"
    elseif tournamentType == "Serie A" then pc=Color3.fromRGB(20,50,150); sc=Color3.fromRGB(255,215,0); shape="SA"
    elseif tournamentType == "FIFA Club World Cup" then pc=Color3.fromRGB(255,215,0); sc=Color3.fromRGB(80,80,80); shape="CWC"
    elseif tournamentType == "DFB-Pokal" then pc=Color3.fromRGB(255,200,50); sc=Color3.fromRGB(180,140,30); shape="DFB"
    elseif tournamentType == "FA Cup" then pc=Color3.fromRGB(220,220,230); sc=Color3.fromRGB(150,155,165); shape="FA"
    elseif tournamentType == "Carabao Cup" then pc=Color3.fromRGB(230,230,240); sc=Color3.fromRGB(150,150,160); shape="CAR"
    elseif tournamentType == "Copa del Rey" then pc=Color3.fromRGB(200,200,210); sc=Color3.fromRGB(255,215,0); shape="CDR"
    elseif tournamentType == "Coppa Italia" then pc=Color3.fromRGB(255,215,0); sc=Color3.fromRGB(180,140,30); shape="CI"
    elseif tournamentType == "Coupe de France" then pc=Color3.fromRGB(200,200,210); sc=Color3.fromRGB(180,180,190); shape="CDF"
    elseif tournamentType == "Supercopa de España" then pc=Color3.fromRGB(220,220,220); sc=Color3.fromRGB(150,150,150); shape="SC"
    else pc=Color3.fromRGB(255,215,0); sc=Color3.fromRGB(180,140,30); shape="GEN" end
    
    local function mk(name, size, cframe, color, material, shapeType)
        local p = Instance.new("Part"); p.Name=name; p.Size=size; p.CFrame=cframe
        p.Color=color; p.Material=material or Enum.Material.Neon
        if shapeType then p.Shape = shapeType end
        p.Anchored=true; p.CanCollide=false; p.Parent=model; return p
    end

    if shape=="DFB" then
        mk("Base", Vector3.new(3,0.5,3), CFrame.new(0,0.25,0), sc, Enum.Material.Metal)
        mk("Stem", Vector3.new(1.2,2,1.2), CFrame.new(0,1.5,0), sc, Enum.Material.Metal)
        mk("Body", Vector3.new(3,3,3), CFrame.new(0,4,0), pc, Enum.Material.Metal, Enum.PartType.Cylinder)
        mk("Rim", Vector3.new(3.2,0.2,3.2), CFrame.new(0,5.5,0), pc, Enum.Material.Metal, Enum.PartType.Cylinder)
        mk("Lid", Vector3.new(2.5,0.5,2.5), CFrame.new(0,5.9,0), pc, Enum.Material.Metal, Enum.PartType.Cylinder)
        mk("Top", Vector3.new(0.8,0.8,0.8), CFrame.new(0,6.3,0), pc, Enum.Material.Metal, Enum.PartType.Ball)

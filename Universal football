    end
    drawBox(PITCH_LENGTH/2, 1); drawBox(-PITCH_LENGTH/2, -1)
    local function goal(posZ)
        local gp = MAP_POS+Vector3.new(0,0,posZ)
        cp("PostL", Vector3.new(5,GOAL_HEIGHT,5), gp+Vector3.new(-GOAL_WIDTH/2, GOAL_HEIGHT/2, 0), Color3.new(1,1,1), Enum.Material.SmoothPlastic)

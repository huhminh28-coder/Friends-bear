local function startGoalCelebration(scorer, scoringTeam)
    if gameState.goalCelebrationActive then return end
    gameState.goalCelebrationActive = true
    local teamList = (scoringTeam == "Red") and gameState.redTeam or gameState.blueTeam
    local scorerPos
    if scorer == "player" then
        local hrp = gameState.playerChar and gameState.playerChar:FindFirstChild("HumanoidRootPart")
        scorerPos = hrp and hrp.Position or MAP_POS
    elseif scorer and scorer.PrimaryPart then
        scorerPos = scorer.PrimaryPart.Position
    else
        scorerPos = MAP_POS
    end
    local runners = {}
    for _, bot in ipairs(teamList) do
        if bot.PrimaryPart and bot ~= scorer then table.insert(runners, bot) end
    end
    local startTime = tick()
    local duration = 5
    local runConn
    runConn = RunService.Heartbeat:Connect(function()
        if tick() - startTime > duration then if runConn then runConn:Disconnect() end; return end
        for idx, bot in ipairs(runners) do
            if bot.PrimaryPart then
                local cur = bot.PrimaryPart.Position
                if bot.Role.Value == "Goalkeeper" and (tick()-startTime) < 1.2 then
                    local jump = math.abs(math.sin((tick()-startTime)*10))*3
                    pcall(moveCharacter, bot, Vector3.new(cur.X, TORSO_Y+jump, cur.Z), scorerPos)
                else
                    local dir = scorerPos - cur
                    local horiz = Vector3.new(dir.X,0,dir.Z)
                    if horiz.Magnitude > 2 then
                        horiz = horiz.Unit
                        local newPos = cur + horiz * 22 * 0.033
                        pcall(moveCharacter, bot, Vector3.new(newPos.X, TORSO_Y, newPos.Z), scorerPos)
                    else
                        local jump = math.abs(math.sin((tick()-startTime)*12 + idx))*2
                        local offset = CFrame.Angles(0, (idx/#runners)*math.pi*2, 0) * Vector3.new(2.5, 0, 0)
                        pcall(moveCharacter, bot, Vector3.new(cur.X + offset.X, TORSO_Y+jump, cur.Z + offset.Z), scorerPos)
                    end
                end
            end
        end
    end)
    task.wait(duration)
    if runConn then runConn:Disconnect() end
    gameState.goalCelebrationActive = false
end

local function buildTrophy(tournamentType)
    local model = Instance.new("Model"); model.Name = "Trophy"
    local pc, sc, shape
    if tournamentType == "World Cup" then pc=Color3.fromRGB(255,200,60); sc=Color3.fromRGB(180,140,30); shape="WC"
    elseif tournamentType == "Champions League" then pc=Color3.fromRGB(215,220,230); sc=Color3.fromRGB(150,155,165); shape="CL"
    elseif tournamentType == "Euro" then pc=Color3.fromRGB(235,235,240); sc=Color3.fromRGB(160,160,170); shape="EU"
    elseif tournamentType == "Copa America" then pc=Color3.fromRGB(255,210,80); sc=Color3.fromRGB(180,140,30); shape="CA"
    else pc=Color3.fromRGB(255,215,0); sc=Color3.fromRGB(180,140,30); shape="GEN" end
    local function mk(name, size, cframe, color, material)
        local p = Instance.new("Part"); p.Name=name; p.Size=size; p.CFrame=cframe
        p.Color=color; p.Material=material or Enum.Material.Neon
        p.Anchored=true; p.CanCollide=false; p.Parent=model; return p
    end
    mk("Base", Vector3.new(3,0.5,3), CFrame.new(0,0.25,0), sc, Enum.Material.Metal)
    mk("Stem", Vector3.new(0.8,1.5,0.8), CFrame.new(0,1.25,0), pc, Enum.Material.Metal)
    if shape=="WC" then
        local g = Instance.new("Part", model); g.Name="Globe"; g.Shape=Enum.PartType.Ball
        g.Size=Vector3.new(1.6,1.6,1.6); g.Color=pc; g.Material=Enum.Material.Neon
        g.Anchored=true; g.CanCollide=false; g.CFrame=CFrame.new(0,3,0)
        for _, x in ipairs({-0.4,0.4}) do mk("Figure", Vector3.new(0.3,1.5,0.3), CFrame.new(x,1.9,0)*CFrame.Angles(0,0,math.rad(x*50)), pc, Enum.Material.Metal) end
    elseif shape=="CL" then
        local cup = mk("Cup", Vector3.new(2,2.5,2), CFrame.new(0,3,0), pc, Enum.Material.Metal); cup.Shape=Enum.PartType.Ball
        for _, side in ipairs({-1,1}) do
            local h = mk("Handle", Vector3.new(0.4,2,2.5), CFrame.new(side*1.3,3,0), pc, Enum.Material.Metal)
            h.Shape=Enum.PartType.Cylinder; h.CFrame=CFrame.new(side*1.3,3,0)*CFrame.Angles(0,0,math.rad(90))
        end
    elseif shape=="EU" then
        local cup = mk("Cup", Vector3.new(1.8,1.8,1.8), CFrame.new(0,2.8,0), pc, Enum.Material.Metal); cup.Shape=Enum.PartType.Ball
        mk("Rim", Vector3.new(1.5,0.2,1.5), CFrame.new(0,3.7,0), pc, Enum.Material.Metal).Shape=Enum.PartType.Cylinder
        for _, side in ipairs({-1,1}) do
            local h = mk("Handle", Vector3.new(0.25,1,1.5), CFrame.new(side*1,2.8,0), pc, Enum.Material.Metal)
            h.Shape=Enum.PartType.Cylinder; h.CFrame=CFrame.new(side*1,2.8,0)*CFrame.Angles(0,0,math.rad(90))
        end
    elseif shape=="CA" then
        local cup = mk("Cup", Vector3.new(1.8,2,1.8), CFrame.new(0,2.8,0), pc, Enum.Material.Metal); cup.Shape=Enum.PartType.Ball
        mk("Lid", Vector3.new(0.6,0.8,0.6), CFrame.new(0,4.2,0), pc, Enum.Material.Metal).Shape=Enum.PartType.Ball
        for _, side in ipairs({-1,1}) do
            local h = mk("Handle", Vector3.new(0.25,1.2,1.5), CFrame.new(side*1,2.8,0), pc, Enum.Material.Metal)
            h.Shape=Enum.PartType.Cylinder; h.CFrame=CFrame.new(side*1,2.8,0)*CFrame.Angles(0,0,math.rad(90))
        end
    end
    local light = Instance.new("PointLight", model:FindFirstChild("Stem"))
    light.Brightness=6; light.Range=20; light.Color=pc
    local att = Instance.new("Attachment", model:FindFirstChild("Stem"))
    local pe = Instance.new("ParticleEmitter", att)
    pe.Texture="rbxassetid://296874871"; pe.Color=ColorSequence.new(pc)
    pe.Rate=40; pe.Lifetime=NumberRange.new(1,2)
    pe.Speed=NumberRange.new(3,6); pe.SpreadAngle=Vector2.new(180,180)
    pe.Size=NumberSequence.new(0.6); pe.LightEmission=1
    model.PrimaryPart = model:FindFirstChild("Stem")
    return model
end


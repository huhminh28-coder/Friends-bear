local function createFireworks(position)
    for i = 1, 6 do
        local part = Instance.new("Part")
        part.Anchored = true; part.CanCollide = false; part.Transparency = 1
        part.Size = Vector3.new(1,1,1)
        part.Position = position + Vector3.new(math.random(-40,40), math.random(0,40), math.random(-40,40))
        part.Parent = workspace
        local emitter = Instance.new("ParticleEmitter", part)
        emitter.Texture = "rbxassetid://296874871"
        emitter.Color = ColorSequence.new{
            ColorSequenceKeypoint.new(0, Color3.fromRGB(math.random(100,255), math.random(100,255), math.random(100,255))),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(math.random(100,255), math.random(100,255), math.random(100,255)))
        }
        emitter.LightEmission = 1; emitter.Lifetime = NumberRange.new(1,2)
        emitter.Speed = NumberRange.new(60,120); emitter.SpreadAngle = Vector2.new(180,180)
        emitter.Size = NumberSequence.new(2.5); emitter.Transparency = NumberSequence.new(1)
        emitter.Acceleration = Vector3.new(0,-80,0); emitter:Emit(80)
        task.delay(3, function() if part then part:Destroy() end end)
    end
end


local function applyKnuckleball(ball,direction,power)
    ball.AssemblyLinearVelocity=direction*power+Vector3.new(0,40,0)
    gameState.ballIsCurving=true
    local st=tick()
    local perp=Vector3.new(-direction.Z,0,direction.X).Unit
    local conn
    conn=RunService.Heartbeat:Connect(function(dt)
        if not ball or not ball.Parent or tick()-st>2.2 then if conn then conn:Disconnect() end return end
        local t=(tick()-st)/2.2; local wobble=math.sin((tick()-st)*22)*220*(1-t)
        local v=ball.AssemblyLinearVelocity
        if v.Magnitude>5 then ball.AssemblyLinearVelocity=v+perp*wobble*dt end
    end)
    task.delay(2.2,function() gameState.ballIsCurving=false end)
end

local function applyPowerShot(ball,direction,power,spin)
    ball.AssemblyLinearVelocity=direction*power+Vector3.new(0,20,0)
    if spin and spin>0 then
        local st=tick(); local sr=spin/800; local conn
        conn=RunService.Heartbeat:Connect(function(dt)
            if not ball or not ball.Parent or tick()-st>1.8 then if conn then conn:Disconnect() end return end
            local t=(tick()-st)/1.8; local angle=sr*(1-t)*dt
            local v=ball.AssemblyLinearVelocity
            if v.Magnitude>5 then local c,s=math.cos(angle),math.sin(angle); ball.AssemblyLinearVelocity=Vector3.new(v.X*c-v.Z*s,v.Y,v.X*s+v.Z*c) end
        end)
    end
end

local function applyLobPass(ball,targetPos,powerBase)
    local dir=targetPos-ball.Position; local hd=Vector3.new(dir.X,0,dir.Z); local d=hd.Magnitude
    if d<1 then return end; hd=hd.Unit
    ball.AssemblyLinearVelocity=hd*math.clamp(d*1.35+(powerBase or 0),100,240)+Vector3.new(0,math.clamp(d*0.10+8,12,35),0)
end

local function applyGroundPass(ball,targetPos,powerBase)
    local dir=targetPos-ball.Position; local hd=Vector3.new(dir.X,0,dir.Z); local d=hd.Magnitude
    if d<1 then return end; hd=hd.Unit
    ball.AssemblyLinearVelocity=hd*math.clamp(d*1.15+(powerBase or 0),80,220)+Vector3.new(0,12,0)
end


local function aiAvoidOpponent(bot)
    local ball=gameState.ball
    if not ball or not ball.Parent or not bot.PrimaryPart then return false end
    local bp=bot.PrimaryPart.Position; local team=bot.Team.Value
    local ol=(team=="Red") and gameState.blueTeam or gameState.redTeam
    local no=nil; local nd=math.huge
    local fd=Vector3.new(0,0,(team=="Red") and 1 or -1)
    for _,opp in ipairs(ol) do if opp.PrimaryPart and opp.Role.Value~="Goalkeeper" then
        local op=opp.PrimaryPart.Position; local to=op-bp; local d=to.Magnitude
        if to.Unit:Dot(fd)>0.4 and d<25 and d<nd then nd=d; no=opp end
    end end
    if not no then return false end
    local a=math.random(1,3)
    if a==1 then
        local sd=(math.random(1,2)==1) and 1 or -1
        local perp=Vector3.new(fd.Z*sd,0,-fd.X*sd)
        ball.CFrame=CFrame.new(bp+perp*4+fd*2); ball.AssemblyLinearVelocity=perp*60+fd*20+Vector3.new(0,8,0); return true
    elseif a==2 then
        local bt,_=findBestPassTarget(bot); if bt and bt.PrimaryPart then applyLobPass(ball,bt.PrimaryPart.Position,20); return true end
    else
        local bt,_=findBestPassTarget(bot); if bt and bt.PrimaryPart then applyGroundPass(ball,bt.PrimaryPart.Position,20); return true end
    end
    return false
end


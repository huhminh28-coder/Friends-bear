local function startTrophyCeremony(winningTeam)
    gameState.trophyActive = true
    local losingTeam = (winningTeam == "Red") and "Blue" or "Red"
    local winners = (winningTeam == "Red") and gameState.redTeam or gameState.blueTeam
    local losers = (winningTeam == "Red") and gameState.blueTeam or gameState.redTeam
    local playerIsWinner = (gameState.playerTeam == winningTeam)
    if gameState.podiumModel then gameState.podiumModel:Destroy() end
    local podium = Instance.new("Model"); podium.Name = "TrophyPodium"; podium.Parent = workspace
    gameState.podiumModel = podium
    local podiumCenter = MAP_POS + Vector3.new(0, 3, -100)
    local function mkStep(name, size, pos, color)
        local p = Instance.new("Part"); p.Name=name; p.Size=size; p.Position=pos
        p.Color=color or Color3.fromRGB(180,180,190); p.Material=Enum.Material.Marble
        p.Anchored=true; p.Parent=podium; return p
    end
    mkStep("Center", Vector3.new(14, 6, 10), podiumCenter + Vector3.new(0, 3, 0), Color3.fromRGB(220, 200, 100))
    mkStep("Left", Vector3.new(9, 4, 9), podiumCenter + Vector3.new(-12, 2, 0), Color3.fromRGB(180, 180, 200))
    mkStep("Right", Vector3.new(9, 4, 9), podiumCenter + Vector3.new(12, 2, 0), Color3.fromRGB(180, 180, 200))
    local carpet = Instance.new("Part")
    carpet.Name="Carpet"; carpet.Size=Vector3.new(70, 0.2, 8)
    carpet.Position=podiumCenter+Vector3.new(0,6.2,6)
    carpet.Color=Color3.fromRGB(180,30,30); carpet.Material=Enum.Material.Fabric
    carpet.Anchored=true; carpet.Parent=podium
    if gameState.trophyModel then gameState.trophyModel:Destroy() end
    local trophy = buildTrophy(gameState.tournamentType)
    trophy:PivotTo(CFrame.new(podiumCenter + Vector3.new(0, 40, 0)))
    trophy.Parent = workspace
    gameState.trophyModel = trophy
    local nonGKWinners = {}
    for _, bot in ipairs(winners) do
        if bot.PrimaryPart then table.insert(nonGKWinners, bot) end
    end
    local targetPositions = {}
    local sideIdx = 0
    for i, bot in ipairs(nonGKWinners) do
        local pos
        if i == 1 then
            pos = podiumCenter + Vector3.new(0, TORSO_Y - MAP_POS.Y + 6, 0)
        elseif i == 2 then
            pos = podiumCenter + Vector3.new(-12, TORSO_Y - MAP_POS.Y + 4, 0)
        elseif i == 3 then
            pos = podiumCenter + Vector3.new(12, TORSO_Y - MAP_POS.Y + 4, 0)
        else
            local side = (sideIdx % 2 == 0) and -1 or 1
            local dist = 18 + math.floor(sideIdx/2) * 4
            pos = podiumCenter + Vector3.new(side * dist, TORSO_Y - MAP_POS.Y, 5)
            sideIdx = sideIdx + 1
        end
        targetPositions[bot] = pos
    end
    if playerIsWinner and gameState.playerChar then
        local hrp = gameState.playerChar:FindFirstChild("HumanoidRootPart")
        if hrp then targetPositions["__player__"] = podiumCenter + Vector3.new(5, TORSO_Y - MAP_POS.Y + 6, 0) end
    end
    local walkStart = tick()
    local walkDuration = 3
    local walkConn
    walkConn = RunService.Heartbeat:Connect(function()
        if tick() - walkStart > walkDuration then if walkConn then walkConn:Disconnect() end; return end
        for bot, target in pairs(targetPositions) do
            if bot ~= "__player__" and bot.PrimaryPart then
                local cur = bot.PrimaryPart.Position
                local dir = target - cur
                local horiz = Vector3.new(dir.X, 0, dir.Z)
                if horiz.Magnitude > 1.5 then
                    horiz = horiz.Unit
                    local newPos = cur + horiz * 20 * 0.033
                    pcall(moveCharacter, bot, Vector3.new(newPos.X, cur.Y, newPos.Z), target)
                else
                    pcall(moveCharacter, bot, Vector3.new(target.X, cur.Y, target.Z), target + Vector3.new(0,0,5))
                end
            end
        end
        if playerIsWinner and gameState.playerChar then
            local hrp = gameState.playerChar:FindFirstChild("HumanoidRootPart")
            if hrp then
                local target = targetPositions["__player__"]
                if target then
                    local dir = target - hrp.Position
                    local horiz = Vector3.new(dir.X, 0, dir.Z)
                    if horiz.Magnitude > 1.5 then
                        hrp.CFrame = CFrame.new(hrp.Position + horiz.Unit * 18 * 0.033)
                    end
                end
            end
        end
    end)
    task.wait(walkDuration + 1)
    if walkConn then walkConn:Disconnect() end
    for bot, target in pairs(targetPositions) do
        if bot ~= "__player__" and bot.PrimaryPart then
            pcall(moveCharacter, bot, target, target + Vector3.new(0,0,5))
        end
    end
    if playerIsWinner and gameState.playerChar then
        local hrp = gameState.playerChar:FindFirstChild("HumanoidRootPart")
        if hrp then
            local target = targetPositions["__player__"]
            if target then hrp.CFrame = CFrame.new(target) end
        end
    end
    task.wait(1.5)
    local lineZ = podiumCenter.Z + 35
    local lineSpacing = 6
    local lineStartX = -((#losers - 1) * lineSpacing) / 2
    local loserTargets = {}
    for i, bot in ipairs(losers) do
        if bot.PrimaryPart then
            loserTargets[bot] = Vector3.new(podiumCenter.X + lineStartX + (i-1)*lineSpacing, TORSO_Y, lineZ)
        end
    end
    local lossWalkStart = tick()
    local lossWalkDuration = 2.5
    local lossConn
    lossConn = RunService.Heartbeat:Connect(function()
        if tick() - lossWalkStart > lossWalkDuration then if lossConn then lossConn:Disconnect() end; return end
        for bot, target in pairs(loserTargets) do
            if bot.PrimaryPart then
                local cur = bot.PrimaryPart.Position
                local dir = target - cur
                local horiz = Vector3.new(dir.X, 0, dir.Z)
                if horiz.Magnitude > 1.5 then
                    horiz = horiz.Unit
                    local newPos = cur + horiz * 20 * 0.033
                    pcall(moveCharacter, bot, Vector3.new(newPos.X, cur.Y, newPos.Z), podiumCenter)
                else
                    pcall(moveCharacter, bot, Vector3.new(target.X, cur.Y, target.Z), podiumCenter)
                end
            end
        end
    end)
    task.wait(lossWalkDuration + 0.5)
    if lossConn then lossConn:Disconnect() end
    for bot, target in pairs(loserTargets) do
        if bot.PrimaryPart then pcall(moveCharacter, bot, target, podiumCenter) end
    end
    task.wait(1)
    local trophyHandPos = podiumCenter + Vector3.new(0, TORSO_Y - MAP_POS.Y + 6 + 4, 0)
    local startPos = trophy:GetPivot().Position
    local descendStart = tick()
    local descendDuration = 4
    local descendConn
    descendConn = RunService.Heartbeat:Connect(function()
        if tick() - descendStart > descendDuration then if descendConn then descendConn:Disconnect() end; return end
        local t = (tick() - descendStart) / descendDuration
        local ease = 1 - (1-t)^2
        local newPos = startPos:Lerp(trophyHandPos, ease)
        trophy:PivotTo(CFrame.new(newPos) * CFrame.Angles(0, tick()*0.5, 0))
    end)
    task.wait(descendDuration)
    if descendConn then descendConn:Disconnect() end
    trophy:PivotTo(CFrame.new(trophyHandPos))
    task.wait(0.5)
    local cheerStart = tick()
    local cheerDuration = 8
    local cheerConn
    cheerConn = RunService.Heartbeat:Connect(function()
        if tick() - cheerStart > cheerDuration then if cheerConn then cheerConn:Disconnect() end; return end
        for i, bot in ipairs(nonGKWinners) do
            if bot.PrimaryPart then
                local basePos = targetPositions[bot]
                if basePos then
                    local jump = math.abs(math.sin((tick()-cheerStart)*6 + i))*3
                    pcall(moveCharacter, bot, Vector3.new(basePos.X, basePos.Y + jump, basePos.Z), podiumCenter)
                end
            end
        end
        if playerIsWinner and gameState.playerChar then
            local hrp = gameState.playerChar:FindFirstChild("HumanoidRootPart")
            if hrp then
                local base = targetPositions["__player__"]
                if base then
                    local jump = math.abs(math.sin((tick()-cheerStart)*6))*3
                    hrp.CFrame = CFrame.new(base.X, base.Y + jump, base.Z)
                end
            end
        end
    end)
    local riseFrom = trophyHandPos
    local riseTo = trophyHandPos + Vector3.new(0, 12, 0)
    local riseStart = tick()
    task.spawn(function()
        while tick() - riseStart < cheerDuration do
            local t = (tick() - riseStart) / cheerDuration
            local ease = t * t
            local newPos = riseFrom:Lerp(riseTo, ease)
            trophy:PivotTo(CFrame.new(newPos) * CFrame.Angles(0, tick()*0.8, 0))
            RunService.Heartbeat:Wait()
        end
    end)
    for i = 1, 16 do
        task.spawn(function()
            local angle = math.random() * math.pi * 2
            local dist = 60 + math.random() * 100
            local pos = MAP_POS + Vector3.new(math.cos(angle) * dist, 3, math.sin(angle) * dist)
            launchFirework(pos)
        end)
        task.wait(0.5)
    end
    task.wait(cheerDuration - 8 + 2)
    if cheerConn then cheerConn:Disconnect() end
    task.wait(1)
    local hugDuration = 4
    local hugStart = tick()
    local hugConn
    hugConn = RunService.Heartbeat:Connect(function()
        if tick() - hugStart > hugDuration then if hugConn then hugConn:Disconnect() end; return end
        for i, bot in ipairs(nonGKWinners) do
            if bot.PrimaryPart then
                local loser = losers[i]
                if loser and loser.PrimaryPart then
                    local cur = bot.PrimaryPart.Position
                    local target = loser.PrimaryPart.Position + Vector3.new(0, 0, -4)
                    local dir = target - cur
                    local horiz = Vector3.new(dir.X, 0, dir.Z)
                    if horiz.Magnitude > 1.5 then
                        horiz = horiz.Unit
                        local newPos = cur + horiz * 18 * 0.033
                        pcall(moveCharacter, bot, Vector3.new(newPos.X, TORSO_Y, newPos.Z), target)
                    end
                end
            end
        end
        if playerIsWinner and gameState.playerChar then
            local hrp = gameState.playerChar:FindFirstChild("HumanoidRootPart")
            if hrp then
                local loser = losers[1]

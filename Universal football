local function launchFirework(position)
    local rocket = Instance.new("Part")
    rocket.Size = Vector3.new(0.6, 0.6, 0.6)
    rocket.Shape = Enum.PartType.Ball
    rocket.Material = Enum.Material.Neon
    rocket.Color = Color3.fromHSV(math.random(), 1, 1)
    rocket.Anchored = true
    rocket.CanCollide = false
    rocket.Position = position
    rocket.Parent = workspace

    local trail = Instance.new("ParticleEmitter", rocket)
    trail.Texture = "rbxassetid://296874871"
    trail.Color = ColorSequence.new(rocket.Color)
    trail.Rate = 60; trail.Lifetime = NumberRange.new(0.5, 1)
    trail.Speed = NumberRange.new(0, 1); trail.Size = NumberSequence.new(0.8)
    trail.LightEmission = 1

    playFireworkLaunch()

    local target = position + Vector3.new(0, 60 + math.random(20), 0)
    TweenService:Create(rocket, TweenInfo.new(1.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Position = target
    }):Play()

    task.delay(1.5, function()
        if rocket then rocket:Destroy() end
        -- Explosion
        playFireworkExplode()
        for i = 1, 40 do
            task.spawn(function()
                local spark = Instance.new("Part")
                spark.Shape = Enum.PartType.Ball
                spark.Size = Vector3.new(0.5, 0.5, 0.5)
                spark.Material = Enum.Material.Neon
                spark.Color = Color3.fromHSV(math.random(), 1, 1)
                spark.Anchored = true
                spark.CanCollide = false
                spark.Position = target
                spark.Parent = workspace

                local light = Instance.new("PointLight", spark)
                light.Brightness = 4; light.Range = 15; light.Color = spark.Color

                local dir = Vector3.new(
                    math.random() - 0.5, math.random() - 0.5, math.random() - 0.5
                ).Unit * (25 + math.random() * 25)

                TweenService:Create(spark, TweenInfo.new(1.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                    Position = target + dir,
                    Transparency = 1,
                    Size = Vector3.new(0.05, 0.05, 0.05)
                }):Play()
                task.delay(1.5, function() if spark then spark:Destroy() end end)
            end)
        end
    end)
end


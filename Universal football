local function buildTrophy(tournamentType)
    local model = Instance.new("Model")
    model.Name = "Trophy"

    local primaryColor, secondaryColor, trophyShape

    if tournamentType == "World Cup" then
        -- Golden trophy with globe
        primaryColor = Color3.fromRGB(255, 200, 60)
        secondaryColor = Color3.fromRGB(180, 140, 30)
        trophyShape = "WC"
    elseif tournamentType == "Champions League" then
        -- Silver Big Ears cup with big handles
        primaryColor = Color3.fromRGB(210, 215, 225)
        secondaryColor = Color3.fromRGB(150, 155, 165)
        trophyShape = "CL"
    elseif tournamentType == "Euro" then
        -- Silver cup
        primaryColor = Color3.fromRGB(230, 230, 235)
        secondaryColor = Color3.fromRGB(160, 160, 170)
        trophyShape = "EU"
    elseif tournamentType == "Copa America" then
        -- Golden cup
        primaryColor = Color3.fromRGB(255, 210, 80)
        secondaryColor = Color3.fromRGB(180, 140, 30)
        trophyShape = "CA"
    else
        primaryColor = Color3.fromRGB(255, 215, 0)
        secondaryColor = Color3.fromRGB(180, 140, 30)
        trophyShape = "GEN"
    end

    local function mk(name, size, cframe, color, material)
        local p = Instance.new("Part")
        p.Name = name; p.Size = size; p.CFrame = cframe
        p.Color = color; p.Material = material or Enum.Material.Neon
        p.Anchored = true; p.CanCollide = false
        p.Parent = model
        return p
    end

    -- Base
    mk("Base", Vector3.new(3, 0.5, 3), CFrame.new(0, 0.25, 0), secondaryColor, Enum.Material.Metal)
    -- Stem
    mk("Stem", Vector3.new(0.8, 1.5, 0.8), CFrame.new(0, 1.25, 0), primaryColor, Enum.Material.Metal)

    if trophyShape == "WC" then
        -- Globe top
        local globe = Instance.new("Part", model)
        globe.Name = "Globe"
        globe.Shape = Enum.PartType.Ball
        globe.Size = Vector3.new(1.6, 1.6, 1.6)
        globe.Color = primaryColor
        globe.Material = Enum.Material.Neon
        globe.Anchored = true
        globe.CanCollide = false
        globe.CFrame = CFrame.new(0, 3, 0)
        -- Two figures holding globe
        for _, x in ipairs({-0.4, 0.4}) do
            local fig = mk("Figure", Vector3.new(0.3, 1.5, 0.3), CFrame.new(x, 1.9, 0) * CFrame.Angles(0, 0, math.rad(x*50)), primaryColor, Enum.Material.Metal)
        end
        -- Ring
        mk("Ring", Vector3.new(1.5, 0.15, 1.5), CFrame.new(0, 2.15, 0), secondaryColor, Enum.Material.Metal).Shape = Enum.PartType.Cylinder
    elseif trophyShape == "CL" then
        -- Big cup
        local cup = mk("Cup", Vector3.new(2, 2.5, 2), CFrame.new(0, 3, 0), primaryColor, Enum.Material.Metal)
        cup.Shape = Enum.PartType.Ball
        -- Handles (big ears)
        for _, side in ipairs({-1, 1}) do
            local handle = mk("Handle", Vector3.new(0.4, 2, 2.5), CFrame.new(side * 1.3, 3, 0), primaryColor, Enum.Material.Metal)
            handle.Shape = Enum.PartType.Cylinder
            handle.CFrame = CFrame.new(side * 1.3, 3, 0) * CFrame.Angles(0, 0, math.rad(90))
        end
    elseif trophyShape == "EU" then
        -- Silver chalice
        local cup = mk("Cup", Vector3.new(1.8, 1.8, 1.8), CFrame.new(0, 2.8, 0), primaryColor, Enum.Material.Metal)
        cup.Shape = Enum.PartType.Ball
        mk("Rim", Vector3.new(1.5, 0.2, 1.5), CFrame.new(0, 3.7, 0), primaryColor, Enum.Material.Metal).Shape = Enum.PartType.Cylinder
        -- Handles
        for _, side in ipairs({-1, 1}) do
            local handle = mk("Handle", Vector3.new(0.25, 1, 1.5), CFrame.new(side * 1, 2.8, 0), primaryColor, Enum.Material.Metal)
            handle.Shape = Enum.PartType.Cylinder
            handle.CFrame = CFrame.new(side * 1, 2.8, 0) * CFrame.Angles(0, 0, math.rad(90))
        end
    elseif trophyShape == "CA" then
        -- Golden cup with lid
        local cup = mk("Cup", Vector3.new(1.8, 2, 1.8), CFrame.new(0, 2.8, 0), primaryColor, Enum.Material.Metal)
        cup.Shape = Enum.PartType.Ball
        mk("Lid", Vector3.new(0.6, 0.8, 0.6), CFrame.new(0, 4.2, 0), primaryColor, Enum.Material.Metal).Shape = Enum.PartType.Ball
        -- Handles
        for _, side in ipairs({-1, 1}) do
            local handle = mk("Handle", Vector3.new(0.25, 1.2, 1.5), CFrame.new(side * 1, 2.8, 0), primaryColor, Enum.Material.Metal)
            handle.Shape = Enum.PartType.Cylinder
            handle.CFrame = CFrame.new(side * 1, 2.8, 0) * CFrame.Angles(0, 0, math.rad(90))
        end
    end

    -- Add glow light
    local light = Instance.new("PointLight", model:FindFirstChild("Stem"))
    light.Brightness = 4; light.Range = 15; light.Color = primaryColor

    -- Sparkle emitter
    local att = Instance.new("Attachment", model:FindFirstChild("Stem"))
    local pe = Instance.new("ParticleEmitter", att)
    pe.Texture = "rbxassetid://296874871"
    pe.Color = ColorSequence.new(primaryColor)
    pe.Rate = 25; pe.Lifetime = NumberRange.new(1, 2)
    pe.Speed = NumberRange.new(2, 5); pe.SpreadAngle = Vector2.new(180, 180)
    pe.Size = NumberSequence.new(0.5); pe.LightEmission = 1

    local primaryPart = model:FindFirstChild("Stem")
    model.PrimaryPart = primaryPart
    return model
end


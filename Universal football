            local a=math.random()*math.pi*2; local p=MAP_POS+Vector3.new(math.cos(a)*25,TORSO_Y-MAP_POS.Y,math.sin(a)*25)
            pcall(moveCharacter, sh.bot, p, Vector3.new(MAP_POS.X,p.Y,MAP_POS.Z))
        end
        return scored
    end
    for r=1,mr do
        if ts("Red",r) then rs=rs+1 end
        task.wait(1.3)

local function buildCombinedDiff(team)
    local d = (team == "Red") and gameState.redDifficulty or gameState.blueDifficulty
    local def = DIFFICULTY_PER_CATEGORY.defense[d.defense]
    local gk  = DIFFICULTY_PER_CATEGORY.goalkeeper[d.goalkeeper]
    local atk = DIFFICULTY_PER_CATEGORY.attack[d.attack]
    local pss = DIFFICULTY_PER_CATEGORY.pass[d.pass]
    return {
        speedMul = def.speedMul, interceptMul = def.interceptMul, skillChance = def.skillChance,
        gkSpeedMul = gk.gkSpeedMul, gkCatchMul = gk.gkCatchMul,
        shotMul = atk.shotMul, passMul = pss.passMul,
    }
end

local function refreshDiffStats()
    gameState.redDiffStats = buildCombinedDiff("Red")
    gameState.blueDiffStats = buildCombinedDiff("Blue")
end

local function getDiff(team)
    if team == "Red" then return gameState.redDiffStats else return gameState.blueDiffStats end
end

local function getCurrentStage()
    local t = TOURNAMENTS[gameState.tournamentType]
    if not t then return "GROUP STAGE", 5 end
    local idx = math.clamp(gameState.currentStageIndex, 1, #t.stages)
    return t.stages[idx], t.matchesPerStage[idx]
end

local function updateTournamentDisplay()
    if not gameState.tournamentLbl then return end
    local stageName, totalMatches = getCurrentStage()
    gameState.tournamentLbl.Text = gameState.tournamentType
    gameState.stageLbl.Text = stageName
    gameState.matchLbl.Text = "MATCH "..gameState.currentMatchInStage.."/"..totalMatches
    gameState.scoreLbl.Text = gameState.teamRedName.." "..gameState.scoreRed.." - "..gameState.scoreBlue.." "..gameState.teamBlueName
end

local function advanceTournament()
    local t = TOURNAMENTS[gameState.tournamentType]
    if not t then return end
    gameState.currentMatchInStage = gameState.currentMatchInStage + 1
    local totalMatches = t.matchesPerStage[gameState.currentStageIndex] or 1
    if gameState.currentMatchInStage > totalMatches then
        gameState.currentStageIndex = gameState.currentStageIndex + 1
        gameState.currentMatchInStage = 1
        if gameState.currentStageIndex > #t.stages then
            gameState.currentStageIndex = 1
            gameState.currentMatchInStage = 1
            showBigText("TOURNAMENT WON!\n"..gameState.tournamentType, Color3.fromRGB(255,215,0))
            task.wait(4)
        else
            showBigText("ADVANCED!\n"..t.stages[gameState.currentStageIndex], Color3.fromRGB(100,255,100))
            task.wait(3)
        end
    end
    updateTournamentDisplay()
end

local function playSoundOnce(id, volume, duration)
    local s = Instance.new("Sound")
    s.SoundId = id; s.Volume = volume; s.Parent = workspace
    pcall(function() s:Play() end)
    task.delay(duration or 4, function() if s then s:Stop() s:Destroy() end end)
end


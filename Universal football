            if gameState.ball and gameState.ball.Anchored then gameState.ball.Anchored=false end
        end
        updatePlayerDribble(dt); updateAILogic(dt); checkRules()
        if tick()-gameState.lastInterceptCheck>0.1 then gameState.lastInterceptCheck=tick(); checkInterception() end
    end)
end


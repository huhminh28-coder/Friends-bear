                                            gameState.stoppageTimeActive = false
                                            resetPositions("Red")
                                            gameState.paused = false
                                            gameState.gameActive = true
                                        else
                                            if gameState.penaltyEnabled then
                                                task.spawn(function()
                                                    local ok, err = pcall(runPenaltyShootout)
                                                    if not ok then warn("[Timer] runPenaltyShootout error: "..tostring(err)) end
                                                end)
                                            else
                                                task.spawn(function()
                                                    local ok, err = pcall(endMatch)
                                                    if not ok then warn("[Timer] endMatch error: "..tostring(err)) end
                                                end)
                                            end
                                        end
                                    else
                                        task.spawn(function()
                                            local ok, err = pcall(endMatch)
                                            if not ok then warn("[Timer] endMatch error: "..tostring(err)) end
                                        end)
                                    end
                                else
                                    if totalRed == totalBlue then
                                        if gameState.penaltyEnabled then
                                            task.spawn(function()
                                                local ok, err = pcall(runPenaltyShootout)
                                                if not ok then warn("[Timer] runPenaltyShootout error: "..tostring(err)) end
                                            end)
                                        else
                                            task.spawn(function()

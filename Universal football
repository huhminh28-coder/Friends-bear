    createGameUI(); createSettingsUI(); startTimer(); updateTournamentDisplay()
    RunService.Heartbeat:Connect(function(dt)
        if gameState.ball then
            if not gameState.ball.Parent then createBall()
            else
                local bp=gameState.ball.Position
                local oob=(bp.Y<MAP_POS.Y-30) or (math.abs(bp.X-MAP_POS.X)>PITCH_WIDTH/2+30) or (math.abs(bp.Z-MAP_POS.Z)>PITCH_LENGTH/2+30)

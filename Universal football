local function createTrophyTool()
    local char = gameState.playerChar or player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    local bp = player:FindFirstChild("Backpack")
    for _, t in ipairs(char:GetChildren()) do if t.Name == "Trophy" then t:Destroy() end end
    if bp then for _, t in ipairs(bp:GetChildren()) do if t.Name == "Trophy" then t:Destroy() end end end

    local tool = Instance.new("Tool")
    tool.Name = "Trophy"
    tool.RequiresHandle = true
    tool.CanBeDropped = false
    
    local model = buildTrophy(gameState.tournamentType)
    local handle = model.PrimaryPart
    if not handle then return end
    handle.Name = "Handle"
    
    local scale = 0.35
    local parts = {}
    local originalCFrames = {}
    
    for _, p in ipairs(model:GetChildren()) do
        if p:IsA("BasePart") then
            table.insert(parts, p)
            originalCFrames[p] = p.CFrame
        end
    end
    
    for _, p in ipairs(parts) do
        p.Size = p.Size * scale
        p.Anchored = false
        p.CanCollide = false
        p.Massless = true
        
        if p ~= handle then
            local w = Instance.new("Weld")
            w.Part0 = handle
            w.Part1 = p
            w.C0 = originalCFrames[handle]:Inverse() * originalCFrames[p]
            w.Parent = handle
        end
        p.Parent = tool
    end
    
    tool.Grip = CFrame.new(0, -1.25, 0) * CFrame.Angles(math.rad(90), 0, 0)
    
    tool.Parent = char
    task.wait(0.2)
    hum:EquipTool(tool)
    gameState.hasTrophy = true
end


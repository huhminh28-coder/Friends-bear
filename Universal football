                    if horiz.Magnitude > 1.5 then
                        hrp.CFrame = CFrame.new(hrp.Position + horiz.Unit * 16 * 0.033)
                    end
                end
            end
        end
    end)
    task.wait(hugDuration + 2)
    if hugConn then hugConn:Disconnect() end
    gameState.trophyActive = false

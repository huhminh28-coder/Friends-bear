-- ========== SOUND SYSTEM ==========
local function playSoundOnce(id, volume, duration)
    local s = Instance.new("Sound")
    s.SoundId = id
    s.Volume = volume
    s.Parent = workspace
    pcall(function() s:Play() end)
    task.delay(duration or 4, function() 
        if s then s:Stop(); s:Destroy() end
    end)
end

local function playWhistle()
    if gameState.crowdSound then gameState.crowdSound.Volume = 0 end
    playSoundOnce(WHISTLE_SOUND, 8, 2.5)
end

local function playFinalWhistle()
    if gameState.crowdSound then gameState.crowdSound.Volume = 0 end
    playSoundOnce(FINAL_WHISTLE_SOUND, 10, 5)
end

local function createCrowdSound()
    if gameState.crowdSound then gameState.crowdSound:Destroy() end
    local s = Instance.new("Sound")
    s.SoundId = CROWD_CHEER_SOUND
    s.Looped = true
    s.Volume = 0
    s.Parent = workspace
    pcall(function() s:Play() end)
    gameState.crowdSound = s
end

local function updateCrowdVolume(dt)
    if not gameState.crowdSound or not gameState.crowdSound.Parent then return end
    if gameState.penaltyActive or gameState.celebrating then
        local target = gameState.celebrating and 3 or 0
        local current = gameState.crowdSound.Volume
        gameState.crowdSound.Volume = current + (target - current) * math.min(dt * 4, 1)
        return
    end
    local ball = gameState.ball
    if not ball or not ball.Parent then 
        gameState.crowdSound.Volume = 0
        return
    end
    local bp = ball.Position
    local distFront = math.abs(bp.Z - (MAP_POS.Z + PITCH_LENGTH/2))
    local distBack = math.abs(bp.Z - (MAP_POS.Z - PITCH_LENGTH/2))
    local closest = math.min(distFront, distBack)
    local targetVolume = 0
    if closest < 180 then
        local intensity = 1 - (closest / 180)
        targetVolume = 0.6 + intensity * 2.4
    end
    local current = gameState.crowdSound.Volume
    gameState.crowdSound.Volume = current + (targetVolume - current) * math.min(dt * 4, 1)
end

-- ========== CARD SYSTEM ==========
local function savePlayerAppearance()
    local char = gameState.playerChar
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        local ok, desc = pcall(function() return hum:GetAppliedDescription() end)
        if ok and desc then gameState.originalAppearance = desc end
    end
end

local function restorePlayerAppearance()
    local char = gameState.playerChar
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and gameState.originalAppearance then
        local ok = pcall(function() hum:ApplyDescription(gameState.originalAppearance) end)
        if not ok then
            for _, obj in ipairs(char:GetDescendants()) do
                if obj:IsA("Shirt") or obj:IsA("Pants") or obj:IsA("ShirtGraphic") then
                    obj:Destroy()
                end
            end
        end
    end
end

local function updateCardUI()
    if not gameState.cardUILabel then return end
    if gameState.playerCard == "yellow" then
        gameState.cardUILabel.Text = "🟨 YELLOW CARD"
        gameState.cardUILabel.TextColor3 = Color3.fromRGB(255, 220, 0)
        gameState.cardUILabel.Visible = true
        gameState.cardUILabel.TextTransparency = 0
        task.delay(CARD_TEXT_DURATION, function()
            if gameState.cardUILabel then gameState.cardUILabel.Visible = false end
        end)
    elseif gameState.playerCard == "red" then
        gameState.cardUILabel.Text = "🟥 RED CARD — SUSPENDED"
        gameState.cardUILabel.TextColor3 = Color3.fromRGB(255, 50, 50)
        gameState.cardUILabel.Visible = true
        gameState.cardUILabel.TextTransparency = 0
        task.delay(CARD_TEXT_DURATION, function()
            if gameState.cardUILabel then gameState.cardUILabel.Visible = false end
        end)
    else
        gameState.cardUILabel.Visible = false
    end
end

local function showCardAnimation(text, color)
    local lbl = gameState.goalTextLabel
    if not lbl then return end
    local origText = lbl.Text
    local origColor = lbl.TextColor3
    lbl.Text = text
    lbl.TextColor3 = color
    lbl.Visible = true
    lbl.TextTransparency = 0
    lbl.TextStrokeTransparency = 0.3
    task.delay(CARD_TEXT_DURATION, function()
        if lbl then
            lbl.Text = origText
            lbl.TextColor3 = origColor
            lbl.Visible = false
        end
    end)
end

local function suspendPlayer()
    gameState.playerCard = "red"
    gameState.redCardMatchesLeft = 1
    gameState.playerSuspended = true
    gameState.playerDribbling = false
    restorePlayerAppearance()
    local char = gameState.playerChar
    if char and char:FindFirstChild("HumanoidRootPart") then
        char:PivotTo(CFrame.new(STAND_POS))
    end
    for _, btn in pairs(gameState.gameButtons) do
        if btn and btn.Parent then
            btn.Active = false
            btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
            btn.TextColor3 = Color3.fromRGB(100, 100, 100)
        end
    end
    updateCardUI()
end

local function onPlayerViolation()
    if gameState.playerSuspended or gameState.playerCard == "red" then return end
    if gameState.playerCard == "none" then
        gameState.playerCard = "yellow"
        playWhistle()
        showCardAnimation("🟨 THẺ VÀNG — CẢNH CÁO!", Color3.fromRGB(255, 220, 0))
        updateCardUI()
        task.delay(CARD_TEXT_DURATION, function()
            showCardAnimation("LẦN NỮA SẼ BỊ THẺ ĐỎ!", Color3.fromRGB(255, 100, 100))
        end)
    elseif gameState.playerCard == "yellow" then
        playWhistle()
        showCardAnimation("🟥 THẺ ĐỎ!", Color3.fromRGB(255, 50, 50))
        task.wait(0.5)
        suspendPlayer()
    end
end

local function canPlayerTouchBall()
    if gameState.playerSuspended or gameState.playerCard == "red" then return false end
    if gameState.penaltyActive then return false end
    if gameState.gkHolding and gameState.gkHoldingTeam 
       and gameState.gkHoldingTeam ~= gameState.playerTeam then
        if tick() - (gameState.lastViolationTime or 0) > 1.5 then
            gameState.lastViolationTime = tick()
            onPlayerViolation()
        end
        return false
    end
    return true
end

local function handleNewMatchStart()
    if gameState.redCardMatchesLeft > 0 then
        gameState.redCardMatchesLeft = gameState.redCardMatchesLeft - 1
        if gameState.redCardMatchesLeft <= 0 then
            gameState.playerCard = "none"
            gameState.playerSuspended = false
            gameState.lastViolationTime = 0
            for _, btn in pairs(gameState.gameButtons) do
                if btn and btn.Parent then
                    btn.Active = true
                    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
                end
            end
            local char = gameState.playerChar
            if char and char:FindFirstChild("HumanoidRootPart") then
                local zOffset = (gameState.playerTeam == "Red") and -150 or 150
                char:PivotTo(CFrame.new(MAP_POS + Vector3.new(0, 10, zOffset)))
            end
            updatePlayerAppearance()
            updateCardUI()
        end
    end
end

local function updatePlayerAppearance()
    local char=gameState.playerChar
    if not char then return end
    if gameState.playerSuspended then return end
    local newColor=(gameState.playerTeam=="Red") and gameState.teamRedColor or gameState.teamBlueColor
    for _,part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") and (part.Name=="Torso" or part.Name:find("Arm")) then
            part.Color=newColor
        elseif part:IsA("Shirt") or part:IsA("Pants") then
            part:Destroy()
        end
    end
end

local function applyTeamColors()
    for _, bot in ipairs(gameState.redTeam) do
        for _, part in ipairs(bot:GetChildren()) do
            if part:IsA("BasePart") and (part.Name == "Torso" or part.Name == "LeftArm" or part.Name == "RightArm") then
                part.Color = gameState.teamRedColor
            end
        end
    end
    for _, bot in ipairs(gameState.blueTeam) do
        for _, part in ipairs(bot:GetChildren()) do
            if part:IsA("BasePart") and (part.Name == "Torso" or part.Name == "LeftArm" or part.Name == "RightArm") then
                part.Color = gameState.teamBlueColor
            end
        end
    end
    updatePlayerAppearance()
end


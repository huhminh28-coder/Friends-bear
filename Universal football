-- ============================================================
-- GOAL CELEBRATION (players run to scorer, GK jumps)
-- ============================================================
local function startGoalCelebration(scorer, scoringTeam)
    if gameState.goalCelebrationActive then return end
    gameState.goalCelebrationActive = true

    local teamList = (scoringTeam == "Red") and gameState.redTeam or gameState.blueTeam
    local scorerPos
    if scorer == "player" then
        local hrp = gameState.playerChar and gameState.playerChar:FindFirstChild("HumanoidRootPart")
        scorerPos = hrp and hrp.Position or MAP_POS
    elseif scorer and scorer.PrimaryPart then
        scorerPos = scorer.PrimaryPart.Position
    else
        scorerPos = MAP_POS
    end

    -- Collect non-GK players
    local runners = {}
    for _, bot in ipairs(teamList) do
        if bot.Role.Value ~= "Goalkeeper" and bot.PrimaryPart then
            table.insert(runners, bot)
        end
    end

    local startTime = tick()
    local duration = 3.5

    -- Run loop: players move to scorer, GK jumps in place
    local runConn
    runConn = RunService.Heartbeat:Connect(function()
        if tick() - startTime > duration then
            if runConn then runConn:Disconnect() end
            return
        end
        for _, bot in ipairs(runners) do
            if bot.PrimaryPart then
                local cur = bot.PrimaryPart.Position
                local dir = scorerPos - cur
                local horizDir = Vector3.new(dir.X, 0, dir.Z)
                if horizDir.Magnitude > 1.5 then
                    horizDir = horizDir.Unit
                    local newPos = cur + horizDir * 20 * 0.03
                    moveCharacter(bot, Vector3.new(newPos.X, TORSO_Y, newPos.Z), scorerPos)
                else
                    local jump = math.abs(math.sin((tick() - startTime) * 12)) * 2
                    moveCharacter(bot, Vector3.new(cur.X, TORSO_Y + jump, cur.Z), scorerPos)
                end
            end
        end
        -- GK jumping
        for _, bot in ipairs(teamList) do
            if bot.Role.Value == "Goalkeeper" and bot.PrimaryPart then
                local cur = bot.PrimaryPart.Position
                local jump = math.abs(math.sin((tick() - startTime) * 10)) * 3
                moveCharacter(bot, Vector3.new(cur.X, TORSO_Y + jump, cur.Z), Vector3.new(cur.X + 1, TORSO_Y, cur.Z))
            end
        end
    end)

    task.wait(duration)
    if runConn then runConn:Disconnect() end
    gameState.goalCelebrationActive = false
end


    local passBtn = makeBtn("PassBtn", "FAST PASS", Color3.fromRGB(50,200,50), UDim2.new(0.8,-50,0.8,-66))
    local lobBtn = makeBtn("LobBtn", "LOB", Color3.fromRGB(255,215,0), UDim2.new(0.8,-50,0.8,-112))
    local knuckleBtn = makeBtn("KnuckleBtn", "KNUCKLE\n(Hold)", Color3.fromRGB(255,100,0), UDim2.new(0.8,-50,0.8,-158))
    local dribbleBtn = makeBtn("DribbleBtn", "DRIBBLE", Color3.fromRGB(0,150,255), UDim2.new(0.8,-50,0.8,-204))
    local switchTeamBtn = makeBtn("SwitchTeamBtn", "SWITCH", Color3.fromRGB(200,100,200), UDim2.new(0.2,-50,0.8,-20))
    local sprintBtn = makeBtn("SprintBtn", "SPRINT", Color3.fromRGB(60,60,60), UDim2.new(0.2,-50,0.8,-66))

    -- NEW: Physics Shot and Super Skill buttons on RIGHT side (same column as other right-side buttons)
    local physicsBtn = makeBtn("PhysicsBtn", "⚡\nPHYSICS SHOT", Color3.fromRGB(150,30,200), UDim2.new(0.8,-50,0.8,-250), UDim2.new(0, 100, 0, 42))
    physicsBtn.Visible = false
    gameState.physicsShotLabel = physicsBtn

    local superBtn = makeBtn("SuperBtn", "🌀\nSUPER SKILL", Color3.fromRGB(200,100,20), UDim2.new(0.8,-50,0.8,-296), UDim2.new(0, 100, 0, 42))
    superBtn.Visible = false
    gameState.superSkillLabel = superBtn

    local function getNearBall()
        local char = gameState.playerChar
        if not char then return false end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp or not gameState.ball then return false end
        return (hrp.Position-gameState.ball.Position).Magnitude < 20, hrp
    end
    local function stopDribble() gameState.playerDribbling = false end
    local function findNearestTeammate()
        local char = gameState.playerChar
        if not char then return nil end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return nil end
        local teamList = (gameState.playerTeam == "Red") and gameState.redTeam or gameState.blueTeam
        local closest, md = nil, math.huge
        for _, bot in ipairs(teamList) do
            if bot.PrimaryPart and bot.Role.Value ~= "Goalkeeper" then
                local d = (bot.PrimaryPart.Position-hrp.Position).Magnitude
                if d < md then md = d; closest = bot end
            end
        end
        return closest
    end
    shootBtn.MouseButton1Down:Connect(function()
        if not canPlayerTouchBall() or gameState.celebrating or gameState.inPenaltyShootout then return end
        local near = getNearBall()
        if not near then return end
        stopDribble()
        gameState.shootCharging = true; gameState.shootChargePower = 0
        gameState.chargingBall = gameState.ball
        gameState.chargingOriginalPos = gameState.ball.Position
        local conn
        conn = RunService.Heartbeat:Connect(function(dt)
            if not gameState.shootCharging then if conn then conn:Disconnect() end return end
            gameState.shootChargePower = math.min(gameState.shootChargePower + dt*120, 350)
            local p = gameState.shootChargePower/350
            shootBtn.BackgroundColor3 = Color3.fromRGB(255, 50+p*180, 50-p*50)
        end)
    end)
    shootBtn.MouseButton1Up:Connect(function()
        if not gameState.shootCharging then return end
        gameState.shootCharging = false
        shootBtn.BackgroundColor3 = Color3.fromRGB(255,50,50)
        local ball = gameState.chargingBall
        local hrp = gameState.playerChar and gameState.playerChar:FindFirstChild("HumanoidRootPart")
        local canShoot = false
        if ball and ball.Parent and hrp then
            if (hrp.Position-ball.Position).Magnitude < 30 then canShoot = true
            elseif (ball.Position-gameState.chargingOriginalPos).Magnitude < 50 then canShoot = true end
        end
        if canShoot then
            gameState.lastTouchTeam = gameState.playerTeam
            playBallTouchSound()
            local gz = (gameState.playerTeam == "Red") and (MAP_POS.Z+PITCH_LENGTH/2) or (MAP_POS.Z-PITCH_LENGTH/2)
            local d = (Vector3.new(MAP_POS.X, MAP_POS.Y+10, gz)-ball.Position).Unit
            local power = 150 + gameState.shootChargePower
            local spin = (power > 300) and ((power-300)*1.5*(math.random(1,2) == 1 and 1 or -1)) or 0
            applyPowerShot(ball, d, power, spin)
        end
        gameState.shootChargePower = 0
        gameState.chargingBall = nil
    end)
    knuckleBtn.MouseButton1Down:Connect(function()
        if not canPlayerTouchBall() or gameState.celebrating or gameState.inPenaltyShootout then return end
        local near = getNearBall()
        if not near then return end
        stopDribble()
        gameState.knuckleCharging = true; gameState.knuckleChargePower = 0
        gameState.chargingBall = gameState.ball
        gameState.chargingOriginalPos = gameState.ball.Position
        local conn
        conn = RunService.Heartbeat:Connect(function(dt)
            if not gameState.knuckleCharging then if conn then conn:Disconnect() end return end
            gameState.knuckleChargePower = math.min(gameState.knuckleChargePower + dt*150, 450)
            local intensity = math.floor(gameState.knuckleChargePower/5)
            knuckleBtn.BackgroundColor3 = Color3.fromRGB(255, 100+intensity, 0)
        end)
    end)
    knuckleBtn.MouseButton1Up:Connect(function()
        if not gameState.knuckleCharging then return end
        gameState.knuckleCharging = false
        knuckleBtn.BackgroundColor3 = Color3.fromRGB(255,100,0)
        local ball = gameState.chargingBall
        local hrp = gameState.playerChar and gameState.playerChar:FindFirstChild("HumanoidRootPart")
        local canShoot = false
        if ball and ball.Parent and hrp then
            if (hrp.Position-ball.Position).Magnitude < 30 then canShoot = true
            elseif (ball.Position-gameState.chargingOriginalPos).Magnitude < 50 then canShoot = true end
        end
        if canShoot then
            gameState.lastTouchTeam = gameState.playerTeam
            playBallTouchSound()
            local gz = (gameState.playerTeam == "Red") and (MAP_POS.Z+PITCH_LENGTH/2) or (MAP_POS.Z-PITCH_LENGTH/2)
            local gp = Vector3.new(MAP_POS.X+math.random(-20,20), MAP_POS.Y+math.random(10,20), gz)
            applyKnuckleball(ball, (gp-ball.Position).Unit, 400+gameState.knuckleChargePower)
        end
        gameState.knuckleChargePower = 0
        gameState.chargingBall = nil
    end)
    dribbleBtn.MouseButton1Click:Connect(function()
        if tick()-(gameState.lastDribbleTime or 0) < 0.3 then return end
        gameState.lastDribbleTime = tick()
        doDribble()
    end)
    lobBtn.MouseButton1Click:Connect(function()
        if gameState.inPenaltyShootout or gameState.celebrating then return end
        local near = getNearBall()
        if near then
            stopDribble()
            gameState.lastTouchTeam = gameState.playerTeam
            playBallTouchSound()
            local closest = findNearestTeammate()
            if closest and closest.PrimaryPart then applyLobPass(gameState.ball, closest.PrimaryPart.Position, 20)
            else
                local gz = (gameState.playerTeam == "Red") and (MAP_POS.Z+PITCH_LENGTH/2) or (MAP_POS.Z-PITCH_LENGTH/2)
                applyLobPass(gameState.ball, Vector3.new(MAP_POS.X+math.random(-20,20), MAP_POS.Y+10, gz), 0)
            end
        end
    end)
    passBtn.MouseButton1Click:Connect(function()
        if gameState.inPenaltyShootout or gameState.celebrating then return end
        local near = getNearBall()
        if near then
            stopDribble()
            gameState.lastTouchTeam = gameState.playerTeam
            playBallTouchSound()
            local closest = findNearestTeammate()
            if closest and closest.PrimaryPart then
                applyGroundPass(gameState.ball, closest.PrimaryPart.Position, 20)
            end
        end
    end)
    switchTeamBtn.MouseButton1Click:Connect(function()
        if gameState.inPenaltyShootout or gameState.celebrating then return end
        gameState.playerTeam = (gameState.playerTeam == "Red") and "Blue" or "Red"
        gameState.playerDribbling = false
        updatePlayerAppearance()
        local pc = gameState.playerChar
        if pc and pc:FindFirstChild("HumanoidRootPart") then
            local zOffset = (gameState.playerTeam == "Red") and -150 or 150
            pc:PivotTo(CFrame.new(MAP_POS+Vector3.new(0,10,zOffset)))
        end
    end)
    sprintBtn.MouseButton1Click:Connect(function()
        gameState.sprinting = not gameState.sprinting
        local char = gameState.playerChar
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                if gameState.sprinting then
                    hum.WalkSpeed = SPRINT_WALKSPEED
                    sprintBtn.BackgroundColor3 = Color3.fromRGB(0,200,100)
                    sprintBtn.Text = "RUNNING"
                else
                    hum.WalkSpeed = NORMAL_WALKSPEED
                    sprintBtn.BackgroundColor3 = Color3.fromRGB(60,60,60)
                    sprintBtn.Text = "SPRINT"
                end
            end
        end
    end)
    physicsBtn.MouseButton1Click:Connect(function()
        if gameState.physicsShotEnabled then physicsDefyingShot() end
    end)
    superBtn.MouseButton1Click:Connect(function()
        if gameState.superSkillEnabled then activateSuperSkill() end
    end)
end

function canPlayerTouchBall()
    if gameState.gkHolding and gameState.gkHoldingTeam and gameState.gkHoldingTeam ~= gameState.playerTeam then
        return false
    end
    return true
end

local function autoStart()
    local char = player.Character or player.CharacterAdded:Wait()
    gameState.playerChar = char
    task.wait(1)
    updatePlayerAppearance()
    player.CharacterAdded:Connect(function(nc)
        gameState.playerChar = nc
        gameState.sprinting = false
        gameState.playerDribbling = false
        task.wait(0.5)
        updatePlayerAppearance()
    end)
    refreshDiffStats()
    createStadium()
    createBall()
    createAIPlayer("Red", "Goalkeeper", 1)
    for i = 1, 4 do createAIPlayer("Red", "Defender", i) end
    for i = 1, 4 do createAIPlayer("Red", "Midfielder", i) end
    for i = 1, 2 do createAIPlayer("Red", "Striker", i) end
    createAIPlayer("Blue", "Goalkeeper", 1)
    for i = 1, 4 do createAIPlayer("Blue", "Defender", i) end
    for i = 1, 4 do createAIPlayer("Blue", "Midfielder", i) end
    for i = 1, 2 do createAIPlayer("Blue", "Striker", i) end
    resetPositions("Red")
    gameState.gameActive = true
    createGameUI()
    createSettingsUI()
    startTimer()
    updateTournamentDisplay()
    RunService.Heartbeat:Connect(function(dt)
        if (gameState.paused or gameState.restartCountdown > 0) and not gameState.inPenaltyShootout then
            if gameState.ball and not gameState.ball.Anchored then
                gameState.ball.Anchored = true
                gameState.ball.AssemblyLinearVelocity = Vector3.zero
                gameState.ball.AssemblyAngularVelocity = Vector3.zero
            end
        end
        if not gameState.paused and gameState.restartCountdown <= 0
           and not gameState.celebrating and not gameState.inPenaltyShootout
           and not gameState.goalScored and not gameState.restartCooldown then
            if not gameState.gameActive then gameState.gameActive = true end
            if gameState.ball and gameState.ball.Anchored then gameState.ball.Anchored = false end
        end
        updatePlayerDribble(dt)
        updateAILogic(dt)
        checkRules()
        if tick()-gameState.lastInterceptCheck > 0.1 then
            gameState.lastInterceptCheck = tick()
            checkInterception()
        end
    end)
    print("=== World Cup 2026 | Advanced Edition ===")
end

autoStart()

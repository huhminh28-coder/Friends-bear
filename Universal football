                    gameState.ball.AssemblyLinearVelocity=Vector3.zero; gameState.ball.AssemblyAngularVelocity=Vector3.zero
                    gameState.ball.CanCollide=true; gameState.ball.Anchored=false
                end
            end
        else createBall() end
        if (gameState.paused or gameState.restartCountdown>0) and not gameState.inPenaltyShootout then
            if gameState.ball and not gameState.ball.Anchored then
                gameState.ball.Anchored=true; gameState.ball.AssemblyLinearVelocity=Vector3.zero; gameState.ball.AssemblyAngularVelocity=Vector3.zero
            end
        end
        if not gameState.paused and gameState.restartCountdown<=0 and not gameState.celebrating and not gameState.inPenaltyShootout
           and not gameState.goalScored and not gameState.restartCooldown then

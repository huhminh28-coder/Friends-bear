local function getHomePos(bot, useBall)
    local team = bot.Team.Value; local role = bot.Role.Value
    local idx = bot:GetAttribute("FormationIndex") or 1
    local attackDir = (team == "Red") and 1 or -1
    local baseX, baseZ, xW, zW = 0, 0, 0.3, 0.3
    if role == "Goalkeeper" then baseX, baseZ, xW, zW = 0, -0.95, 0.5, 0.05
    elseif role == "Defender" then
        local xs = {-0.35,-0.12,0.12,0.35}; baseX = xs[idx] or 0
        baseZ = (idx==1 or idx==4) and -0.5 or -0.6; xW, zW = 0.35, 0.4
    elseif role == "Midfielder" then
        local xs = {-0.30,-0.10,0.10,0.30}; baseX = xs[idx] or 0
        baseZ = (idx==1 or idx==4) and -0.10 or 0.0; xW, zW = 0.35, 0.5
    elseif role == "Striker" then
        baseX = (idx==1) and -0.15 or 0.15; baseZ = 0.35; xW, zW = 0.3, 0.55
    end
    local bZ, bX = 0, 0
    if useBall and gameState.ball then
        bZ = math.clamp((gameState.ball.Position.Z-MAP_POS.Z)/(PITCH_LENGTH/2), -1, 1)
        bX = math.clamp((gameState.ball.Position.X-MAP_POS.X)/(PITCH_WIDTH/2), -1, 1)
    end
    local tX, tZ
    if role == "Goalkeeper" then
        local gz = (team == "Red") and (MAP_POS.Z-PITCH_LENGTH/2+12) or (MAP_POS.Z+PITCH_LENGTH/2-12)
        tX = MAP_POS.X + math.clamp(bX, -0.5, 0.5) * (GOAL_WIDTH/2); tZ = gz
    else
        tZ = MAP_POS.Z + (baseZ*attackDir+bZ*zW) * (PITCH_LENGTH/2)
        tX = MAP_POS.X + (baseX+bX*xW) * (PITCH_WIDTH/2)
    end
    tX = math.clamp(tX, MAP_POS.X-PITCH_WIDTH/2+10, MAP_POS.X+PITCH_WIDTH/2-10)
    tZ = math.clamp(tZ, MAP_POS.Z-PITCH_LENGTH/2+5, MAP_POS.Z+PITCH_LENGTH/2-5)
    return Vector3.new(tX, TORSO_Y, tZ)
end

local function playBallTouchSound()

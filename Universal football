local function updatePlayerAppearance()
    local char = gameState.playerChar; if not char then return end
    local newColor = (gameState.playerTeam == "Red") and gameState.teamRedColor or gameState.teamBlueColor
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") and (part.Name == "Torso" or part.Name:find("Arm")) then part.Color = newColor
        elseif part:IsA("Shirt") or part:IsA("Pants") then part:Destroy() end
    end
end
local function applyTeamColors()
    for _,bot in ipairs(gameState.redTeam) do for _,part in ipairs(bot:GetChildren()) do
        if part:IsA("BasePart") and (part.Name=="Torso" or part.Name=="LeftArm" or part.Name=="RightArm") then part.Color = gameState.teamRedColor end

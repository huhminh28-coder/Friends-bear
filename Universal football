function findBestPassTarget(bot)
    local ball=gameState.ball; if not ball or not ball.Parent then return nil end
    local team=bot.Team.Value
    local agz=(team=="Red") and (MAP_POS.Z+PITCH_LENGTH/2) or (MAP_POS.Z-PITCH_LENGTH/2)
    local tl=(team=="Red") and gameState.redTeam or gameState.blueTeam
    local ol=(team=="Red") and gameState.blueTeam or gameState.redTeam
    local best,bs,pt=nil,-math.huge,"Short"
    local candidates = {}
    for _,tm in ipairs(tl) do
        if tm~=bot and tm.PrimaryPart and tm.Role.Value~="Goalkeeper" then
            table.insert(candidates, {part=tm.PrimaryPart, bot=tm, isPlayer=false})
        end
    end
    local pc = gameState.playerChar
    if pc and gameState.playerTeam == team and not gameState.isOnBench then
        local phrp = pc:FindFirstChild("HumanoidRootPart")
        if phrp then
            table.insert(candidates, {part=phrp, bot=nil, isPlayer=true})
        end
    end
    
    local isStriker = (bot.Role.Value == "Striker")
    
    for _,c in ipairs(candidates) do
        local tp = c.part.Position
        local dtb = (tp - ball.Position).Magnitude
        if dtb > 15 and dtb < 350 then
            local score = -math.abs(tp.Z - agz) * 0.5
            local no = math.huge
            for _,opp in ipairs(ol) do
                if opp.PrimaryPart then
                    local d = (opp.PrimaryPart.Position - tp).Magnitude
                    if d < no then no = d end
                end
            end
            if no < 25 then score = score - 200
            elseif no > 60 then score = score + 100 end
            
            if isStriker and no < 40 then score = score - 150 end
            
            if c.isPlayer then
                local chance = 50
                if gameState.playerPosition == "Defender" then chance = 30
                elseif gameState.playerPosition == "Midfielder" then chance = 50
                elseif gameState.playerPosition == "Striker" then chance = 80 end
                
                if math.random(1,100) <= chance then
                    score = score + 500
                else
                    score = score - 500
                end
            end

            local bdg = math.abs(ball.Position.Z - agz)
            local it = false
            if math.abs(tp.Z - agz) < bdg - 30 and no > 40 then score = score + 150; it = true end
            if score > bs then
                bs = score
                if c.isPlayer then best = "PLAYER" else best = c.bot end
                if it then pt = "ThroughBall"
                elseif dtb < 80 then pt = "Short"
                elseif dtb < 180 then pt = "Medium"
                else pt = "LobPass" end
            end
        end
    end
    return best, pt
end

local function handleBallTouch(bot)
    if gameState.gkHolding then return end
    if gameState.playerSkillActive and bot.Role.Value~="Goalkeeper" then return end
    local ball=gameState.ball; if not ball or not ball.Parent then return end
    local team=bot.Team.Value; local diff=getDiff(team)
    local agz=(team=="Red") and (MAP_POS.Z+PITCH_LENGTH/2) or (MAP_POS.Z-PITCH_LENGTH/2)
    local bp=bot.PrimaryPart.Position; local dtg=math.abs(bp.Z-agz)
    local bid=bot:GetDebugId(); local csn=tick()>(gameState.passCooldowns[bid] or 0)
    local dtb=(bp-ball.Position).Magnitude
    
    if dtb<15 and dtg>200 and math.random()<0.5 then
        if aiDribble(bot) then gameState.passCooldowns[bid]=tick()+0.8 return end
    end
    
    local isStriker = (bot.Role.Value == "Striker")
    local isMidfielder = (bot.Role.Value == "Midfielder")
    
    local shootThreshold = isStriker and 350 or 200
    if dtg < shootThreshold and csn then
        local t, pt = findBestPassTarget(bot)
        if isMidfielder and t and math.random() < 0.7 then
            local tp
            if t == "PLAYER" then
                local pc = gameState.playerChar
                local phrp = pc and pc:FindFirstChild("HumanoidRootPart")
                if phrp then tp = phrp.Position end
            elseif t.PrimaryPart then
                tp = t.PrimaryPart.Position
            end
            if tp then
                if pt=="ThroughBall" then local td=Vector3.new(0,0,(team=="Red") and 1 or -1); applyGroundPass(ball,tp+td*40,20*diff.passMul)
                elseif pt=="Short" then applyGroundPass(ball,tp,0)
                elseif pt=="Medium" then applyGroundPass(ball,tp,20*diff.passMul)
                else applyLobPass(ball,tp,20*diff.passMul) end
                gameState.passCooldowns[bid]=tick()+1.5
                return
            end
        else
            aiShootBall(bot)
            gameState.passCooldowns[bid]=tick()+1.0
            return
        end
    end
    
    gameState.lastTouchTeam=team; gameState.lastScorer=bot; gameState.lastScorerTeam=team
    playBallTouchSound()
    local t,pt=findBestPassTarget(bot); local pm=diff.passMul
    if t then
        local tp
        if t == "PLAYER" then
            local pc = gameState.playerChar
            local phrp = pc and pc:FindFirstChild("HumanoidRootPart")
            if phrp then tp = phrp.Position end
        elseif t.PrimaryPart then
            tp = t.PrimaryPart.Position
        end
        if tp then
            if pt=="ThroughBall" then local td=Vector3.new(0,0,(team=="Red") and 1 or -1); applyGroundPass(ball,tp+td*40,20*pm)
            elseif pt=="Short" then applyGroundPass(ball,tp,0)
            elseif pt=="Medium" then applyGroundPass(ball,tp,20*pm)
            else applyLobPass(ball,tp,20*pm) end
            gameState.passCooldowns[bid]=tick()+1.5
            return
        end
    end
    local d=(Vector3.new(MAP_POS.X,MAP_POS.Y,agz)-ball.Position).Unit
    ball.AssemblyLinearVelocity=d*100*pm; gameState.passCooldowns[bid]=tick()+0.8
end

local function goalkeeperPassBall(gk,ball,team)
    local cands={}; local tm=(team=="Red") and gameState.redTeam or gameState.blueTeam
    for _,t in ipairs(tm) do if t~=gk and t.PrimaryPart then table.insert(cands,{part=t.PrimaryPart,isPlayer=false}) end end
    local pc=gameState.playerChar
    if pc and gameState.playerTeam==team and not gameState.isOnBench then
        local hrp=pc:FindFirstChild("HumanoidRootPart")
        if hrp then table.insert(cands,{part=hrp,isPlayer=true}) end
    end
    local bt,bs=nil,-math.huge; local bp=ball.Position
    local ogz=(team=="Red") and (MAP_POS.Z-PITCH_LENGTH/2) or (MAP_POS.Z+PITCH_LENGTH/2)
    for _,c in ipairs(cands) do if c.part then
        local d=(c.part.Position-bp).Magnitude
        if d>15 and d<400 then
            local s=-math.abs(c.part.Position.Z-ogz)*0.5;
            if c.isPlayer then 
                local chance = 50
                if gameState.playerPosition == "Defender" then chance = 30
                elseif gameState.playerPosition == "Midfielder" then chance = 50
                elseif gameState.playerPosition == "Striker" then chance = 80 end
                
                if math.random(1,100) <= chance then s=s+50 else s=s-100 end
            end
            if s>bs then bs=s; bt=c end
        end
    end end
    if bt then
        local tp=bt.part.Position
        if (tp-ball.Position).Magnitude>150 then applyLobPass(ball,tp,30) else applyGroundPass(ball,tp,20) end
        gameState.lastTouchTeam=team
    else
        local ad=(team=="Red") and 1 or -1
        ball.AssemblyLinearVelocity=Vector3.new(0,100,ad*150)
    end
end

local function updateGoalkeeperAI(gk,dt)
    local ball=gameState.ball; if not ball or not ball.Parent or not gk.PrimaryPart then return end
    local gkId=gk:GetDebugId(); local team=gk.Team.Value; local diff=getDiff(team)
    local gkSpeed=GK_SPEED*diff.gkSpeedMul
    local glz=(team=="Red") and (MAP_POS.Z-PITCH_LENGTH/2+12) or (MAP_POS.Z+PITCH_LENGTH/2-12)
    local minX=MAP_POS.X-GOAL_WIDTH/2-5; local maxX=MAP_POS.X+GOAL_WIDTH/2+5
    local bmz,bMz
    if team=="Red" then bmz=MAP_POS.Z-PITCH_LENGTH/2-3; bMz=MAP_POS.Z-PITCH_LENGTH/2+PENALTY_BOX_DEPTH
    else bmz=MAP_POS.Z+PITCH_LENGTH/2-PENALTY_BOX_DEPTH; bMz=MAP_POS.Z+PITCH_LENGTH/2+3 end
    local bp=ball.Position; local bv=ball.AssemblyLinearVelocity; local bSpeed=bv.Magnitude
    local cdEnd=gameState.gkHoldCooldowns[gkId] or 0
    if tick()<cdEnd then return end
    local px,py=bp.X,MAP_POS.Y+8; local appr,ttg=false,999
    if (team=="Red" and bv.Z<-5) or (team=="Blue" and bv.Z>5) then
        if math.abs(bv.Z)>5 then
            ttg=(glz-bp.Z)/bv.Z
            if ttg>0 and ttg<5 then
                appr=true; px=bp.X+bv.X*ttg
                py=bp.Y+bv.Y*ttg-0.5*workspace.Gravity*ttg*ttg
            end
        end
    end
    local tX=math.clamp(px,minX,maxX)
    local bib=bp.Z>=bmz and bp.Z<=bMz and bp.X>=minX and bp.X<=maxX
    local tZ=glz
    if bib or appr then
        if team=="Red" then tZ=math.clamp(bp.Z+5,bmz,bMz) else tZ=math.clamp(bp.Z-5,bmz,bMz) end
    end
    local speed=gkSpeed
    if appr then
        if ttg<0.8 then speed=gkSpeed*7 elseif ttg<1.5 then speed=gkSpeed*5 elseif ttg<3 then speed=gkSpeed*2.5 end
    end
    local jh=0
    if appr then local tj=py-MAP_POS.Y-8; if tj>0 then jh=math.clamp(tj,0,22) end; if ttg<0.6 then jh=math.clamp(jh+3,0,24) end end
    local tY=TORSO_Y+jh; local gp=gk.PrimaryPart.Position
    local dir=Vector3.new(tX,tY,tZ)-gp; local dtb=(gp-bp).Magnitude
    if dtb>4 and dir.Magnitude>0.3 then
        local np=gp+dir.Unit*speed*dt
        np=Vector3.new(math.clamp(np.X,minX,maxX),TORSO_Y+jh,math.clamp(np.Z,bmz,bMz))
        pcall(moveCharacter, gk, np, Vector3.new(bp.X,np.Y,bp.Z))
    elseif dtb<=4 then
        local ny=gp.Y+((TORSO_Y+jh)-gp.Y)*0.15
        pcall(moveCharacter, gk, Vector3.new(gp.X,ny,gp.Z), Vector3.new(bp.X,ny,bp.Z))
    end
    local cr=8*diff.gkCatchMul
    if bp.Y>MAP_POS.Y+12 then cr=11*diff.gkCatchMul end
    if bp.Y>MAP_POS.Y+20 then cr=13*diff.gkCatchMul end
    if dtb<cr and tick()>=cdEnd then
        local bHigh=bp.Y>MAP_POS.Y+16
        local bKnuckle=gameState.ballIsCurving and bSpeed>300
        local sP,sC=false,false
        if bKnuckle or bHigh then sP=true else sC=true end
        if diff.gkCatchMul<0.8 and math.random()<0.5 then sC=false; sP=true end
        if sC then
            ball.AssemblyLinearVelocity=Vector3.zero; ball.AssemblyAngularVelocity=Vector3.zero
            gameState.ballIsCurving=false; gameState.lastTouchTeam=team; playBallTouchSound()
            gameState.gkHolding=true; gameState.gkHoldingTeam=team; gameState.gkHoldCooldowns[gkId]=tick()+3.0
            task.spawn(function()
                task.wait(2.0)
                if not ball or not ball.Parent then gameState.gkHolding=false; gameState.gkHoldingTeam=nil; return end
                goalkeeperPassBall(gk,ball,team)
                gameState.gkHolding=false; gameState.gkHoldingTeam=nil
            end)
        elseif sP then
            local pd=Vector3.new(bp.X-gp.X,0,bp.Z-gp.Z)
            if pd.Magnitude<1 then pd=Vector3.new(0,0,1) end; pd=pd.Unit
            local pp=math.clamp(bSpeed*0.6,100,220)
            ball.AssemblyLinearVelocity=pd*pp+Vector3.new(0,120,0)
            ball.AssemblyAngularVelocity=Vector3.new(math.random(-30,30),math.random(-30,30),math.random(-30,30))
            playBallKick(ball.Position,math.random(70,85)/100)
            gameState.ballIsCurving=false; gameState.lastTouchTeam=team
            gameState.gkHoldCooldowns[gkId]=tick()+0.8
        end
    end
end


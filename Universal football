local function runPenaltyShootout()
    gameState.inPenaltyShootout = true
    hideGoalText()
    gameState.playerDribbling = false

    local redScore, blueScore = 0, 0
    local maxRounds = 5

    -- Goal direction: Red attacks +Z goal (Blue's goal), Blue attacks -Z goal (Red's goal)
    local goalZFor = {Red = MAP_POS.Z + PITCH_LENGTH/2, Blue = MAP_POS.Z - PITCH_LENGTH/2}

    -- All non-shooter players stand in the center circle watching
    local function gatherInCircle()
        local positions = {}
        for _, bot in ipairs(gameState.redTeam) do
            if bot.PrimaryPart and bot.Role.Value ~= "Goalkeeper" then
                table.insert(positions, bot)
            end
        end
        for _, bot in ipairs(gameState.blueTeam) do
            if bot.PrimaryPart and bot.Role.Value ~= "Goalkeeper" then
                table.insert(positions, bot)
            end
        end
        for i, bot in ipairs(positions) do
            local angle = (i / #positions) * math.pi * 2
            local r = 25
            local p = MAP_POS + Vector3.new(math.cos(angle)*r, TORSO_Y-MAP_POS.Y, math.sin(angle)*r)
            moveCharacter(bot, p, Vector3.new(MAP_POS.X, p.Y, MAP_POS.Z))
        end
    end

    gatherInCircle()
    if gameState.ball then
        gameState.ball.Anchored = true
        gameState.ball.AssemblyLinearVelocity = Vector3.zero
        gameState.ball.AssemblyAngularVelocity = Vector3.zero
    end

    showBigText("PENALTY SHOOTOUT!", Color3.fromRGB(255,220,100))
    task.wait(2)
    hideBigText()

    local function findGK(team)
        for _, bot in ipairs((team == "Red") and gameState.redTeam or gameState.blueTeam) do
            if bot.Role.Value == "Goalkeeper" then return bot end
        end
    end

    local redUsed, blueUsed = {}, {}
    local function getShooter(team)
        local usedList = (team == "Red") and redUsed or blueUsed
        if team == gameState.playerTeam and not usedList["player"] then
            local pc = gameState.playerChar
            if pc and pc:FindFirstChild("HumanoidRootPart") then return {isPlayer = true, char = pc, key = "player"} end
        end
        for _, bot in ipairs((team == "Red") and gameState.redTeam or gameState.blueTeam) do
            if bot.PrimaryPart and bot.Role.Value ~= "Goalkeeper" and not usedList[bot.Name] then
                return {isPlayer = false, bot = bot, key = bot.Name}
            end
        end
        if team == "Red" then redUsed = {} else blueUsed = {} end
        for _, bot in ipairs((team == "Red") and gameState.redTeam or gameState.blueTeam) do
            if bot.PrimaryPart and bot.Role.Value ~= "Goalkeeper" then
                return {isPlayer = false, bot = bot, key = bot.Name}
            end
        end
    end

    local function takeShot(team, round)
        local shooter = getShooter(team)
        if not shooter then return false end
        local usedList = (team == "Red") and redUsed or blueUsed
        usedList[shooter.key] = true

        local goalZ = goalZFor[team]
        local sign = (goalZ > MAP_POS.Z) and 1 or -1
        local spotZ = goalZ - sign * PENALTY_DIST
        local opponentTeam = (team == "Red") and "Blue" or "Red"

        -- Move GK to goal
        local gk = findGK(opponentTeam)
        if gk and gk.PrimaryPart then
            moveCharacter(gk, Vector3.new(MAP_POS.X, TORSO_Y, goalZ - sign*6), Vector3.new(MAP_POS.X, TORSO_Y, MAP_POS.Z))
        end

        -- Ball at penalty spot
        local ballPos = Vector3.new(MAP_POS.X, MAP_POS.Y+3, spotZ)
        if gameState.ball then
            gameState.ball.Anchored = true
            gameState.ball.CFrame = CFrame.new(ballPos)
            gameState.ball.AssemblyLinearVelocity = Vector3.zero
            gameState.ball.AssemblyAngularVelocity = Vector3.zero
        end

        -- Shooter stands behind ball
        local approachZ = spotZ - sign * 8
        local approachPos = Vector3.new(MAP_POS.X, TORSO_Y, approachZ)
        if shooter.isPlayer then
            local hrp = shooter.char:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.CFrame = CFrame.new(approachPos, Vector3.new(MAP_POS.X, approachPos.Y, goalZ))
                hrp.AssemblyLinearVelocity = Vector3.zero
            end
        elseif shooter.bot.PrimaryPart then
            moveCharacter(shooter.bot, approachPos, Vector3.new(MAP_POS.X, approachPos.Y, goalZ))
        end

        task.wait(0.8)

        local teamName = (team == "Red") and gameState.teamRedName or gameState.teamBlueName

        -- Determine shot direction
        local shotDir
        if shooter.isPlayer then
            showBigText("YOUR TURN!\nCHOOSE A DIRECTION", Color3.fromRGB(255,255,100))
            local dirResult = makeDirectionUI()
            local startWait = tick()
            while not dirResult.value and tick() - startWait < 8 do
                task.wait(0.05)
            end
            shotDir = dirResult.value or "Center"
            clearDirectionUI()
        else
            showBigText(teamName.." - ROUND "..round, Color3.fromRGB(255,220,100))
            task.wait(1)
            local roll = math.random(1, 100)
            if roll <= 25 then shotDir = "Left"
            elseif roll <= 50 then shotDir = "Right"
            elseif roll <= 75 then shotDir = "Center"
            else shotDir = "Over" end
        end

        hideBigText()

        -- GK picks direction (also random)
        local gkDirRoll = math.random(1, 100)
        local gkDir
        if gkDirRoll <= 40 then gkDir = "Left"
        elseif gkDirRoll <= 80 then gkDir = "Right"
        else gkDir = "Center" end

        -- Move GK animation
        if gk and gk.PrimaryPart then
            local gkStart = gk.PrimaryPart.Position
            local targetX = MAP_POS.X
            if gkDir == "Left" then targetX = MAP_POS.X - 18
            elseif gkDir == "Right" then targetX = MAP_POS.X + 18 end
            task.spawn(function()
                local startT = tick()
                while tick() - startT < 0.7 do
                    if gk.PrimaryPart then
                        local cur = gk.PrimaryPart.Position
                        local nx = cur.X + (targetX - cur.X) * 0.15
                        moveCharacter(gk, Vector3.new(nx, TORSO_Y, gkStart.Z), Vector3.new(MAP_POS.X, TORSO_Y, MAP_POS.Z))
                    end
                    task.wait(0.03)
                end
            end)
        end

        task.wait(0.3)

        -- Kick ball toward picked direction
        if gameState.ball then
            gameState.ball.Anchored = false
            local dirX = 0
            if shotDir == "Left" then dirX = -0.35
            elseif shotDir == "Right" then dirX = 0.35 end
            local dirY = (shotDir == "Over") and 0.6 or 0.15
            local power = (shotDir == "Over") and 130 or 200
            local dir = Vector3.new(dirX, dirY, sign).Unit
            applyKnuckleball(gameState.ball, dir, power)
        end

        task.wait(1.4)

        -- Determine result
        local resultText, resultColor
        local scored = false
        if shotDir == "Over" then
            resultText = "MISSED!"
            resultColor = Color3.fromRGB(255, 100, 100)
        elseif shotDir == gkDir then
            resultText = "SAVED!"
            resultColor = Color3.fromRGB(255, 150, 50)
        else
            resultText = "GOAL!"
            resultColor = Color3.fromRGB(100, 255, 100)
            scored = true
        end

        showBigText(resultText, resultColor)
        task.wait(1.5)
        hideBigText()

        -- Reset ball and shooter
        if gameState.ball then
            gameState.ball.Anchored = true
            gameState.ball.CFrame = CFrame.new(ballPos)
            gameState.ball.AssemblyLinearVelocity = Vector3.zero
            gameState.ball.AssemblyAngularVelocity = Vector3.zero
        end

        -- Return shooter to circle
        if shooter.isPlayer then
            local hrp = shooter.char:FindFirstChild("HumanoidRootPart")
            if hrp then hrp.CFrame = CFrame.new(MAP_POS + Vector3.new(0, 5, 0)) end
        elseif shooter.bot.PrimaryPart then
            local angle = math.random() * math.pi * 2
            local p = MAP_POS + Vector3.new(math.cos(angle)*25, TORSO_Y-MAP_POS.Y, math.sin(angle)*25)
            moveCharacter(shooter.bot, p, Vector3.new(MAP_POS.X, p.Y, MAP_POS.Z))
        end

        return scored
    end

    for round = 1, maxRounds do
        if takeShot("Red", round) then redScore = redScore + 1 end
        showBigText(string.format("%s %d - %d %s", gameState.teamRedName, redScore, blueScore, gameState.teamBlueName), Color3.new(1,1,1))
        task.wait(1.3)

        if takeShot("Blue", round) then blueScore = blueScore + 1 end
        showBigText(string.format("%s %d - %d %s", gameState.teamRedName, redScore, blueScore, gameState.teamBlueName), Color3.new(1,1,1))
        task.wait(1.3)

        if redScore > blueScore + (maxRounds - round) then break end
        if blueScore > redScore + (maxRounds - round) then break end
    end

    local sdRound = 0
    while redScore == blueScore do
        sdRound = sdRound + 1
        if takeShot("Red", "SD"..sdRound) then redScore = redScore + 1 end
        if takeShot("Blue", "SD"..sdRound) then blueScore = blueScore + 1 end
        showBigText(string.format("SUDDEN DEATH %d\n%s %d - %d %s", sdRound, gameState.teamRedName, redScore, blueScore, gameState.teamBlueName), Color3.fromRGB(255,200,100))
        task.wait(1.3)
    end

    gameState.inPenaltyShootout = false
    gameState.scoreRed = redScore
    gameState.scoreBlue = blueScore

    local winner = redScore > blueScore and "Red" or "Blue"
    local winnerName = (winner == "Red") and gameState.teamRedName or gameState.teamBlueName

    showBigText(winnerName.." WINS!\n"..redScore.." - "..blueScore, Color3.fromRGB(255,220,100))
    task.wait(2.5)
    hideBigText()

    startCelebration(winner)
    task.wait(12)

    -- Reset for next match
    gameState.paused = true
    gameState.gameActive = false
    gameState.currentHalf = 1
    gameState.timeLeft = HALF_TIME
    gameState.scoreRed = 0
    gameState.scoreBlue = 0
    gameState.isExtraTime = false
    gameState.lastTouchTeam = nil
    gameState.goalScored = false
    gameState.gkHoldCooldowns = {}
    gameState.passCooldowns = {}
    gameState.playerDribbling = false
    gameState.aiDribbleState = {}
    if gameState.ball then gameState.ball.Anchored = false end
    gameState.paused = false
    resetPositions("Red")
    task.delay(0.3, function()
        local pc = gameState.playerChar
        if pc then
            local hrp = pc:FindFirstChild("HumanoidRootPart")
            local hum = pc:FindFirstChildOfClass("Humanoid")
            if hrp then
                local zOffset = (gameState.playerTeam == "Red") and -150 or 150
                hrp.CFrame = CFrame.new(MAP_POS+Vector3.new(0,15,zOffset))
                hrp.AssemblyLinearVelocity = Vector3.zero
            end
            if workspace.CurrentCamera and hum then
                workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
                workspace.CurrentCamera.CameraSubject = hum
            end
        end
    end)
    gameState.gameActive = true
end

-- ═══════════════════════════════════════════════════════════════
-- MATCH FLOW
-- ═══════════════════════════════════════════════════════════════
local function endMatch(winnerText)
    gameState.paused = true
    gameState.gameActive = false
    if gameState.ball then gameState.ball.Anchored = true end
    playFinalWhistle()
    local winner = nil
    if gameState.scoreRed > gameState.scoreBlue then winner = "Red"
    elseif gameState.scoreBlue > gameState.scoreRed then winner = "Blue" end
    if winner then
        showBigText(winnerText, Color3.fromRGB(255,100,100))
        task.wait(3)
        hideBigText()
        if gameState.ball then gameState.ball.Anchored = false end
        startCelebration(winner)
        task.wait(12)
    end
    gameState.restartCountdown = FULL_BREAK
    while gameState.restartCountdown > 0 do
        task.wait(1)
        gameState.restartCountdown = gameState.restartCountdown - 1
    end
    gameState.currentHalf = 1
    gameState.timeLeft = HALF_TIME
    gameState.scoreRed = 0
    gameState.scoreBlue = 0
    gameState.isExtraTime = false
    gameState.lastTouchTeam = nil
    gameState.goalScored = false
    gameState.gkHoldCooldowns = {}
    gameState.passCooldowns = {}
    gameState.playerDribbling = false
    gameState.aiDribbleState = {}
    gameState.paused = false
    if gameState.ball then gameState.ball.Anchored = false end
    resetPositions("Red")
    task.delay(0.3, function()
        local pc = gameState.playerChar
        if pc then
            local hrp = pc:FindFirstChild("HumanoidRootPart")
            local hum = pc:FindFirstChildOfClass("Humanoid")
            if hrp then
                local zOffset = (gameState.playerTeam == "Red") and -150 or 150
                hrp.CFrame = CFrame.new(MAP_POS+Vector3.new(0,15,zOffset))
                hrp.AssemblyLinearVelocity = Vector3.zero
            end
            if workspace.CurrentCamera and hum then
                workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
                workspace.CurrentCamera.CameraSubject = hum
            end
        end
    end)
    gameState.gameActive = true
end

local function onGoalScored(scoringTeam)
    if gameState.goalScored or gameState.inPenaltyShootout or gameState.celebrating then return end
    gameState.goalScored = true
    if scoringTeam == "Red" then gameState.scoreRed = gameState.scoreRed + 1
    else gameState.scoreBlue = gameState.scoreBlue + 1 end
    showGoalText()
    local goalZ = (scoringTeam == "Red") and (MAP_POS.Z+PITCH_LENGTH/2) or (MAP_POS.Z-PITCH_LENGTH/2)
    createFireworks(Vector3.new(MAP_POS.X, MAP_POS.Y+30, goalZ))
    task.wait(3)
    hideGoalText()
    resetPositions((scoringTeam == "Red") and "Blue" or "Red")
    gameState.lastTouchTeam = nil
    gameState.goalScored = false
end

local function restart(type, sideX)
    if gameState.restartCooldown then return end
    gameState.restartCooldown = true
    local ball = gameState.ball
    if not ball then gameState.restartCooldown = false return end
    if type == "ThrowIn" then ball.CFrame = CFrame.new(Vector3.new(sideX, MAP_POS.Y, ball.Position.Z)+Vector3.new(0,5,0))
    elseif type == "Corner" then
        local sideZ = (ball.Position.Z > MAP_POS.Z) and (PITCH_LENGTH/2) or (-PITCH_LENGTH/2)
        local sideX2 = (ball.Position.X > MAP_POS.X) and (PITCH_WIDTH/2) or (-PITCH_WIDTH/2)
        ball.CFrame = CFrame.new(MAP_POS+Vector3.new(sideX2, 5, sideZ))
    elseif type == "GoalKick" then
        local sideZ = (ball.Position.Z > MAP_POS.Z) and (PITCH_LENGTH/2-30) or (-PITCH_LENGTH/2+30)
        ball.CFrame = CFrame.new(MAP_POS+Vector3.new(0,5,sideZ))
    end
    ball.AssemblyLinearVelocity = Vector3.zero
    ball.AssemblyAngularVelocity = Vector3.zero
    task.wait(1)
    gameState.restartCooldown = false
end

local function checkRules()
    local ball = gameState.ball
    if not ball or not ball.Parent or gameState.restartCooldown or not gameState.gameActive or gameState.goalScored then return end
    if gameState.inPenaltyShootout or gameState.celebrating or gameState.paused or gameState.restartCountdown > 0 then return end
    local bp = ball.Position
    if math.abs(bp.X-MAP_POS.X) > PITCH_WIDTH/2+5 then
        restart("ThrowIn", bp.X > MAP_POS.X and (PITCH_WIDTH/2-3) or (-PITCH_WIDTH/2+3))
        return
    end
    if math.abs(bp.Z-MAP_POS.Z) > PITCH_LENGTH/2+5 then
        local withinW = math.abs(bp.X-MAP_POS.X) < GOAL_WIDTH/2
        local underBar = (bp.Y-MAP_POS.Y) < (GOAL_HEIGHT+2) and (bp.Y-MAP_POS.Y) > -5
        local isFront = bp.Z < MAP_POS.Z-PITCH_LENGTH/2
        local isBack = bp.Z > MAP_POS.Z+PITCH_LENGTH/2
        if withinW and underBar and (isFront or isBack) then
            if isBack then task.spawn(onGoalScored, "Red")
            else task.spawn(onGoalScored, "Blue") end
        else
            if gameState.lastTouchTeam == "Red" then restart("GoalKick")
            else restart("Corner") end
        end
    end
end

local function startTimer()
    task.spawn(function()
        while true do
            task.wait(1)
            if gameState.gameActive and not gameState.paused and not gameState.gkHolding
               and not gameState.goalScored and not gameState.inPenaltyShootout and not gameState.celebrating then
                gameState.timeLeft = gameState.timeLeft - 1
                if gameState.timeLeft <= 0 then
                    if gameState.isExtraTime then
                        playFinalWhistle()
                        if gameState.scoreRed == gameState.scoreBlue then
                            showBigText("EXTRA TIME ENDED\nPENALTY SHOOTOUT!", Color3.fromRGB(255,200,100))
                            task.wait(3)
                            hideBigText()
                            task.spawn(runPenaltyShootout)
                        else
                            local w = gameState.teamRedName.." WINS!"
                            if gameState.scoreBlue > gameState.scoreRed then w = gameState.teamBlueName.." WINS!" end
                            task.spawn(function() endMatch("FULL TIME\n"..w) end)
                        end
                    elseif gameState.currentHalf < gameState.maxHalves then
                        gameState.paused = true
                        gameState.gameActive = false
                        playWhistle()
                        showBigText("HALF TIME", Color3.fromRGB(255,255,100))
                        task.wait(3)
                        hideBigText()
                        gameState.restartCountdown = HALF_BREAK
                        while gameState.restartCountdown > 0 do task.wait(1) gameState.restartCountdown = gameState.restartCountdown-1 end
                        gameState.currentHalf = gameState.currentHalf + 1
                        gameState.timeLeft = HALF_TIME
                        gameState.playerDribbling = false
                        resetPositions("Red")
                        gameState.paused = false
                        gameState.gameActive = true
                    else
                        gameState.paused = true
                        gameState.gameActive = false
                        if gameState.scoreRed == gameState.scoreBlue then
                            playWhistle()
                            showBigText("FULL TIME\nDRAW!\nEXTRA TIME", Color3.fromRGB(255,255,100))
                            task.wait(3)
                            hideBigText()
                            gameState.restartCountdown = HALF_BREAK
                            while gameState.restartCountdown > 0 do task.wait(1) gameState.restartCountdown = gameState.restartCountdown-1 end
                            gameState.isExtraTime = true
                            gameState.timeLeft = EXTRA_TIME
                            gameState.playerDribbling = false
                            resetPositions("Red")
                            gameState.paused = false
                            gameState.gameActive = true
                        else
                            local w = gameState.teamRedName.." WINS!"
                            if gameState.scoreBlue > gameState.scoreRed then w = gameState.teamBlueName.." WINS!" end
                            task.spawn(function() endMatch("FULL TIME\n"..w) end)
                        end
                    end
                end
            end
        end
    end)
end


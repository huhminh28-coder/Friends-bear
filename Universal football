function canPlayerTouchBall()
    if gameState.gkHolding and gameState.gkHoldingTeam and gameState.gkHoldingTeam~=gameState.playerTeam then return false end
    return true
end

local function autoStart()
    local char=player.Character or player.CharacterAdded:Wait()
    gameState.playerChar=char; task.wait(1); updatePlayerAppearance()
    player.CharacterAdded:Connect(function(nc)
        gameState.playerChar=nc; gameState.sprinting=false; gameState.playerDribbling=false
        task.wait(0.5); updatePlayerAppearance()
        if gameState.hasTrophy then
            task.wait(1)
            createTrophyTool()
        end
    end)
    refreshDiffStats()
    createStadium(); createBall()
    createAIPlayer("Red","Goalkeeper",1)
    for i=1,4 do createAIPlayer("Red","Defender",i) end
    for i=1,4 do createAIPlayer("Red","Midfielder",i) end
    for i=1,2 do createAIPlayer("Red","Striker",i) end
    createAIPlayer("Blue","Goalkeeper",1)
    for i=1,4 do createAIPlayer("Blue","Defender",i) end
    for i=1,4 do createAIPlayer("Blue","Midfielder",i) end
    for i=1,2 do createAIPlayer("Blue","Striker",i) end
    resetPositions("Red"); gameState.gameActive=true
    createGameUI(); createSettingsUI(); startTimer(); updateTournamentDisplay()
    RunService.Heartbeat:Connect(function(dt)
        if gameState.ball then
            if not gameState.ball.Parent then createBall()
            else
                local bp=gameState.ball.Position
                local oob=(bp.Y<MAP_POS.Y-30) or (math.abs(bp.X-MAP_POS.X)>PITCH_WIDTH/2+30) or (math.abs(bp.Z-MAP_POS.Z)>PITCH_LENGTH/2+30)
                if oob then
                    gameState.ball.CFrame=CFrame.new(MAP_POS+Vector3.new(0,5,0))
                    gameState.ball.AssemblyLinearVelocity=Vector3.zero; gameState.ball.AssemblyAngularVelocity=Vector3.zero
                    gameState.ball.CanCollide=true; gameState.ball.Anchored=false
                end
            end
        else createBall() end
        if (gameState.paused or gameState.restartCountdown>0) and not gameState.inPenaltyShootout then
            if gameState.ball and not gameState.ball.Anchored then
                gameState.ball.Anchored=true; gameState.ball.AssemblyLinearVelocity=Vector3.zero; gameState.ball.AssemblyAngularVelocity=Vector3.zero
            end
        end
        if not gameState.paused and gameState.restartCountdown<=0 and not gameState.celebrating and not gameState.inPenaltyShootout
           and not gameState.goalScored and not gameState.restartCooldown then
            if not gameState.gameActive then gameState.gameActive=true end
            if gameState.ball and gameState.ball.Anchored then gameState.ball.Anchored=false end
        end
        updatePlayerDribble(dt); updateAILogic(dt); checkRules()
        if tick()-gameState.lastInterceptCheck>0.1 then gameState.lastInterceptCheck=tick(); checkInterception() end
    end)
end

autoStart()

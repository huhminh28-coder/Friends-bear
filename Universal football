    cp("Pitch", Vector3.new(PITCH_WIDTH, 5, PITCH_LENGTH), MAP_POS, Color3.fromRGB(0,180,0), Enum.Material.Grass)
    cp("LineCenter", Vector3.new(5, 5.1, PITCH_LENGTH), MAP_POS, Color3.new(1,1,1), Enum.Material.SmoothPlastic)
    cp("LineFront", Vector3.new(PITCH_WIDTH, 5.1, 5), MAP_POS+Vector3.new(0,0,-PITCH_LENGTH/2), Color3.new(1,1,1), Enum.Material.SmoothPlastic)
    cp("LineBack", Vector3.new(PITCH_WIDTH, 5.1, 5), MAP_POS+Vector3.new(0,0,PITCH_LENGTH/2), Color3.new(1,1,1), Enum.Material.SmoothPlastic)
    local cc = cp("CenterCircle", Vector3.new(100, 5.2, 100), MAP_POS, Color3.new(1,1,1), Enum.Material.SmoothPlastic)
    cc.Shape = Enum.PartType.Cylinder
    cc.CFrame = CFrame.new(MAP_POS+Vector3.new(0,2.6,0)) * CFrame.Angles(0,0,math.rad(90))
    local function drawBox(goalZ, dir)

    cp("TrackN", Vector3.new(PITCH_WIDTH+100, 3, 20), MAP_POS+Vector3.new(0,-1, -PITCH_LENGTH/2-30), trackColor, Enum.Material.Slate)
    cp("TrackS", Vector3.new(PITCH_WIDTH+100, 3, 20), MAP_POS+Vector3.new(0,-1, PITCH_LENGTH/2+30), trackColor, Enum.Material.Slate)
    cp("TrackW", Vector3.new(20, 3, PITCH_LENGTH+100), MAP_POS+Vector3.new(-PITCH_WIDTH/2-30, -1, 0), trackColor, Enum.Material.Slate)
    cp("TrackE", Vector3.new(20, 3, PITCH_LENGTH+100), MAP_POS+Vector3.new(PITCH_WIDTH/2+30, -1, 0), trackColor, Enum.Material.Slate)
    local seatColors = {Color3.fromRGB(255,80,80),Color3.fromRGB(80,80,255),Color3.fromRGB(255,255,255),Color3.fromRGB(80,200,80)}
    local function buildStand(side, length)
        local tiers = 8
        for tier = 1, tiers do
            local stepHeight = 8; local stepDepth = 12
            local y = tier * stepHeight; local zOffset = tier * stepDepth
            local rowPos, rowSize
            if side == "N" then rowPos = MAP_POS + Vector3.new(0, y, -PITCH_LENGTH/2 - 40 - zOffset); rowSize = Vector3.new(length, stepHeight, stepDepth)
            elseif side == "S" then rowPos = MAP_POS + Vector3.new(0, y, PITCH_LENGTH/2 + 40 + zOffset); rowSize = Vector3.new(length, stepHeight, stepDepth)
            elseif side == "W" then rowPos = MAP_POS + Vector3.new(-PITCH_WIDTH/2 - 40 - zOffset, y, 0); rowSize = Vector3.new(stepDepth, stepHeight, length)
            else rowPos = MAP_POS + Vector3.new(PITCH_WIDTH/2 + 40 + zOffset, y, 0); rowSize = Vector3.new(stepDepth, stepHeight, length) end
            cp("StandRow_"..side.."_"..tier, rowSize, rowPos, Color3.fromRGB(120,120,130), Enum.Material.Concrete)
            local seatsPerRow = math.floor(length / 10)
            for s = 1, seatsPerRow do
                local seatPos
                if side == "N" then seatPos = rowPos + Vector3.new(-length/2 + s*10 - 5, stepHeight/2 + 2, stepDepth/2 - 2)
                elseif side == "S" then seatPos = rowPos + Vector3.new(-length/2 + s*10 - 5, stepHeight/2 + 2, -stepDepth/2 + 2)
                elseif side == "W" then seatPos = rowPos + Vector3.new(stepDepth/2 - 2, stepHeight/2 + 2, -length/2 + s*10 - 5)
                else seatPos = rowPos + Vector3.new(-stepDepth/2 + 2, stepHeight/2 + 2, -length/2 + s*10 - 5) end
                local sc = seatColors[math.random(1, #seatColors)]
                cp("Seat_"..side.."_"..tier.."_"..s, Vector3.new(6, 3, 6), seatPos, sc, Enum.Material.SmoothPlastic, nil, false)
            end
        end
        local roofY = tiers * 8 + 20
        local roofPos, roofSize
        if side == "N" then roofPos = MAP_POS + Vector3.new(0, roofY, -PITCH_LENGTH/2 - 40 - (tiers * 12 / 2)); roofSize = Vector3.new(length + 20, 3, tiers * 12 + 10)
        elseif side == "S" then roofPos = MAP_POS + Vector3.new(0, roofY, PITCH_LENGTH/2 + 40 + (tiers * 12 / 2)); roofSize = Vector3.new(length + 20, 3, tiers * 12 + 10)
        elseif side == "W" then roofPos = MAP_POS + Vector3.new(-PITCH_WIDTH/2 - 40 - (tiers * 12 / 2), roofY, 0); roofSize = Vector3.new(tiers * 12 + 10, 3, length + 20)
        else roofPos = MAP_POS + Vector3.new(PITCH_WIDTH/2 + 40 + (tiers * 12 / 2), roofY, 0); roofSize = Vector3.new(tiers * 12 + 10, 3, length + 20) end
        cp("Roof_"..side, roofSize, roofPos, Color3.fromRGB(60,60,70), Enum.Material.Metal)
    end
    buildStand("N", PITCH_WIDTH + 80); buildStand("S", PITCH_WIDTH + 80)
    buildStand("W", PITCH_LENGTH + 80); buildStand("E", PITCH_LENGTH + 80)
    for _, corner in ipairs({MAP_POS + Vector3.new(-260, 0, -340),MAP_POS + Vector3.new(260, 0, -340),MAP_POS + Vector3.new(-260, 0, 340),MAP_POS + Vector3.new(260, 0, 340)}) do
        cp("Pole", Vector3.new(10, 200, 10), corner + Vector3.new(0, 100, 0), Color3.fromRGB(80,80,80), Enum.Material.Metal)
        local head = cp("LightHead", Vector3.new(80, 25, 25), corner + Vector3.new(0, 210, 0), Color3.new(1,1,1), Enum.Material.Neon)
        local pl = Instance.new("PointLight", head); pl.Brightness = 6; pl.Range = 700; pl.Color = Color3.fromRGB(255,250,220)
    end

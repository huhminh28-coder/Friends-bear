local function setPenaltyBall(team, index, scored)
    local list = (team == "Red") and gameState.penaltyBallsRed or gameState.penaltyBallsBlue
    local ball = list[index]
    if not ball or not ball.Parent then return end
    local color, strokeColor
    if scored then
        color = Color3.fromRGB(60,220,80); strokeColor = Color3.fromRGB(120,255,150)
    else
        color = Color3.fromRGB(220,50,50); strokeColor = Color3.fromRGB(255,120,120)
    end
    local tween = TweenService
    tween:Create(ball, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        BackgroundColor3 = color
    }):Play()
    local stroke = ball:FindFirstChildOfClass("UIStroke")
    if stroke then
        tween:Create(stroke, TweenInfo.new(0.35), {Color = strokeColor, Thickness = 3}):Play()
    end
    local origSize = ball.Size
    tween:Create(ball, TweenInfo.new(0.15), {Size = UDim2.new(0, 34, 0, 34)}):Play()
    task.delay(0.15, function()
        if ball and ball.Parent then
            tween:Create(ball, TweenInfo.new(0.2), {Size = origSize}):Play()
        end
    end)
end


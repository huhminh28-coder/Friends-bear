            end
        end
    end)
    
    local function handleRGBInput(box, channel)
        local n = tonumber(box.Text)
        if n then
            n = math.clamp(n, 0, 255)
            local r = math.floor(currentColor.R*255)
            local g = math.floor(currentColor.G*255)
            local b = math.floor(currentColor.B*255)
            if channel == "R" then r = n
            elseif channel == "G" then g = n
            else b = n end
            currentColor = Color3.fromRGB(r, g, b)
            local h, s, v = Color3.toHSV(currentColor)
            hue, sat, val = h, s, v
            spectrumFrame.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
            updateCursorFromHSV()
            updateColorFromHSV()
        end
    end
    
    rBox.FocusLost:Connect(function() handleRGBInput(rBox, "R") end)
    gBox.FocusLost:Connect(function() handleRGBInput(gBox, "G") end)
    bBox.FocusLost:Connect(function() handleRGBInput(bBox, "B") end)
    
    -- Recent color swatches
    for i, swatch in ipairs(recentRow:GetChildren()) do
        if swatch:IsA("Frame") then
            local idx = i
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, 0, 1, 0)
            btn.BackgroundTransparency = 1
            btn.Text = ""
            btn.ZIndex = 103
            btn.Parent = swatch
            btn.MouseButton1Click:Connect(function()
                if recentColors[idx] then
                    currentColor = recentColors[idx]
                    local h, s, v = Color3.toHSV(currentColor)
                    hue, sat, val = h, s, v
                    spectrumFrame.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
                    updateCursorFromHSV()
                    updateColorFromHSV()
                end
            end)
        end
    end
    
    -- Tab switching (visual only - both tabs same thing here, but styled)
    paletteTab.MouseButton1Click:Connect(function()
        paletteTab.BackgroundColor3 = Color3.fromRGB(50, 50, 58)
        spectrumTab.BackgroundColor3 = Color3.fromRGB(80, 80, 90)
    end)
    spectrumTab.MouseButton1Click:Connect(function()
        paletteTab.BackgroundColor3 = Color3.fromRGB(80, 80, 90)
        spectrumTab.BackgroundColor3 = Color3.fromRGB(50, 50, 58)
    end)
    
    -- Buttons
    cancelBtn.MouseButton1Click:Connect(function()
        picker:Destroy()
    end)
    
    saveBtn.MouseButton1Click:Connect(function()
        -- Add to recent
        table.insert(recentColors, 1, currentColor)
        while #recentColors > 8 do table.remove(recentColors) end
        if onSave then onSave(currentColor) end
        picker:Destroy()
    end)
    
    -- Initial cursor
    updateCursorFromHSV()
    updateColorFromHSV()
    brightKnob.Position = UDim2.new(val, -12, 0.5, -12)
    percentLabel.Text = math.floor(val * 100) .. "%"
    
    return picker
end

